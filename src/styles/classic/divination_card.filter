Show #.name t1
	SetTextColor COLOR_CORRUPTED OPACITY_HIGH
	SetBackgroundColor COLOR_DIV_CARD OPACITY_HIGH
    SetBorderColor COLOR_CORRUPTED OPACITY_HIGH
	MinimapIcon ICON_SIZE_LARGE EFFECT_DIV_CARD ICON_DIV_CARD
	PlayEffect EFFECT_DIV_CARD
	PlayAlertSoundPositional SOUND_SHORT_T2 VOLUME_LOUD

Show #.name t2
	SetTextColor COLOR_BLACK OPACITY_HIGH
	SetBackgroundColor COLOR_DIV_CARD OPACITY_HIGH
    SetBorderColor COLOR_BLACK OPACITY_HIGH
	MinimapIcon ICON_SIZE_MEDIUM EFFECT_DIV_CARD ICON_DIV_CARD
	PlayEffect EFFECT_DIV_CARD
	PlayAlertSoundPositional SOUND_SHORT_T3 VOLUME_MID

Show #.name t3
    SetTextColor COLOR_DIV_CARD OPACITY_HIGH
	SetBackgroundColor COLOR_BLACK OPACITY_HIGH
    SetBorderColor COLOR_DIV_CARD OPACITY_HIGH
	MinimapIcon ICON_SIZE_SMALL EFFECT_DIV_CARD ICON_DIV_CARD
	PlayEffect EFFECT_DIV_CARD Temp
	PlayAlertSoundPositional SOUND_SHORT_T4 VOLUME_LOW

Show #.name t4
	SetTextColor COLOR_DIV_CARD OPACITY_HIGH
	SetBackgroundColor COLOR_BLACK OPACITY_HIGH
    SetBorderColor COLOR_DIV_CARD OPACITY_LOW
	MinimapIcon ICON_SIZE_SMALL EFFECT_DIV_CARD ICON_DIV_CARD

Show #.name t5
	SetTextColor COLOR_DIV_CARD OPACITY_HIGH
	SetBackgroundColor COLOR_BLACK OPACITY_LOW
    SetBorderColor COLOR_BLACK OPACITY_NONE

Show #.name catchall
	#.import template > miscellaneous -> catchall { ICON_TEMPLATE = ICON_DIV_CARD