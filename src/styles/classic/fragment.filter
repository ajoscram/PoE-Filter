Show #.name t1
	SetTextColor COLOR_CORRUPTED OPACITY_HIGH
	SetBackgroundColor COLOR_TORMENT OPACITY_HIGH
    SetBorderColor COLOR_CORRUPTED OPACITY_HIGH
	MinimapIcon ICON_SIZE_LARGE EFFECT_FRAGMENT ICON_MAP
	PlayEffect EFFECT_FRAGMENT
	PlayAlertSoundPositional SOUND_SHORT_T2 VOLUME_LOUD

Show #.name t2
	SetTextColor COLOR_BLACK OPACITY_HIGH
	SetBackgroundColor COLOR_TORMENT OPACITY_HIGH
    SetBorderColor COLOR_BLACK OPACITY_HIGH
	MinimapIcon ICON_SIZE_MEDIUM EFFECT_FRAGMENT ICON_MAP
	PlayEffect EFFECT_FRAGMENT
	PlayAlertSoundPositional SOUND_SHORT_T3 VOLUME_MID

Show #.name t3
    SetTextColor COLOR_TORMENT OPACITY_HIGH
	SetBackgroundColor COLOR_BLACK OPACITY_HIGH
    SetBorderColor COLOR_TORMENT OPACITY_HIGH
	MinimapIcon ICON_SIZE_SMALL EFFECT_FRAGMENT ICON_MAP
	PlayEffect EFFECT_FRAGMENT Temp
	PlayAlertSoundPositional SOUND_SHORT_T4 VOLUME_LOW

Show #.name t4
	SetTextColor COLOR_TORMENT OPACITY_HIGH
	SetBackgroundColor COLOR_BLACK OPACITY_HIGH
    SetBorderColor COLOR_TORMENT OPACITY_LOW
	MinimapIcon ICON_SIZE_SMALL EFFECT_FRAGMENT ICON_MAP

Show #.name t5
	SetTextColor COLOR_TORMENT OPACITY_HIGH
	SetBackgroundColor COLOR_BLACK OPACITY_LOW
    SetBorderColor COLOR_BLACK OPACITY_NONE

Show #.name catchall
	#.import template > miscellaneous -> catchall { ICON_TEMPLATE = ICON_MAP