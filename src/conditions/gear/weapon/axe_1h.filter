#.subsection One-hand Axe

#.alias BASES_ONE_HAND_AXE_EXCEPTIONAL    = "Psychotic Axe"
#.alias BASES_ONE_HAND_AXE_BEST           = "Runic Hatchet" "Royal Axe" "Siege Axe"

#.alias MODS_ONE_HAND_AXE_EXCEPTIONAL     = "Topotante's" "Tacati's" "of Tacati"
#.alias MODS_ONE_HAND_AXE_GRAND           = "of the Gods" "of the Wind" "of Celebration" "of the Ranger"
#.alias MODS_ONE_HAND_AXE_GREATER         = "Paragon's" "Weaponmaster's" "of the Titan" "of the Phantom" "of Infamy" "of the Marksman"
#.alias MODS_ONE_HAND_AXE_LESSER          = "Combatant's" "of the Leviathan" "of the Jaguar" "of Fame" "of the Sniper" "of the Vampire"

# Unique

Show #.econ uni 100
    BaseType == "Siege Axe" "Spectral Axe"
    Class == "One Hand Axes" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t1

Show #.econ uni 10 100
    BaseType == "Butcher Axe"
    Class == "One Hand Axes" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t2

Show #.econ uni 1 10 .strict STRICTNESS_STRICT .if Show
    BaseType == "Vaal Hatchet" "Tomahawk" "Royal Axe" "Jade Hatchet"
    Class == "One Hand Axes" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t3

# Exceptional Mods

Show
    BaseType == BASES_ONE_HAND_AXE_BEST
    HasExplicitMod == MODS_WEAPON_EXCEPTIONAL MODS_ONE_HAND_AXE_EXCEPTIONAL
    #.import _util -> multi_t1_rare
    #.import _util -> multi_t1_magic

Show
    Class == "One Hand Axes"
    HasExplicitMod == MODS_WEAPON_EXCEPTIONAL MODS_ONE_HAND_AXE_EXCEPTIONAL
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

# Rare

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t1
    #.multi
        Class == "One Hand Axes"
        HasExplicitMod ==6 MODS_WEAPON_GRAND MODS_ONE_HAND_AXE_GRAND
    #.multi
        BaseType == BASES_ONE_HAND_AXE_BEST
        HasExplicitMod >=5 MODS_WEAPON_GRAND MODS_ONE_HAND_AXE_GRAND

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == "One Hand Axes"
        HasExplicitMod >=5 MODS_WEAPON_GRAND MODS_ONE_HAND_AXE_GRAND
    #.multi
        BaseType == BASES_ONE_HAND_AXE_BEST
        HasExplicitMod >=4 MODS_WEAPON_GRAND MODS_ONE_HAND_AXE_GRAND

Show #.strict STRICTNESS_STRICT
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == "One Hand Axes"
        HasExplicitMod >=3 MODS_WEAPON_GRAND MODS_ONE_HAND_AXE_GRAND
    #.multi
        BaseType == BASES_ONE_HAND_AXE_BEST
        HasExplicitMod >=2 MODS_WEAPON_GRAND MODS_ONE_HAND_AXE_GRAND

Show #.strict STRICTNESS_LENIENT
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == "One Hand Axes"
        HasExplicitMod >=3 MODS_WEAPON_GREATER MODS_ONE_HAND_AXE_GREATER MODS_WEAPON_GRAND MODS_ONE_HAND_AXE_GRAND
    #.multi
        BaseType == BASES_ONE_HAND_AXE_BEST
        HasExplicitMod >=2 MODS_WEAPON_GREATER MODS_ONE_HAND_AXE_GREATER MODS_WEAPON_GRAND MODS_ONE_HAND_AXE_GRAND

Show #.strict STRICTNESS_BASE
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == "One Hand Axes"
        HasExplicitMod >=3 MODS_WEAPON_LESSER MODS_ONE_HAND_AXE_LESSER MODS_WEAPON_GREATER MODS_ONE_HAND_AXE_GREATER MODS_WEAPON_GRAND MODS_ONE_HAND_AXE_GRAND
    #.multi
        BaseType == BASES_ONE_HAND_AXE_BEST
        HasExplicitMod >=2 MODS_WEAPON_LESSER MODS_ONE_HAND_AXE_LESSER MODS_WEAPON_GREATER MODS_ONE_HAND_AXE_GREATER MODS_WEAPON_GRAND MODS_ONE_HAND_AXE_GRAND

# Magic

Show
    BaseType == BASES_ONE_HAND_AXE_BEST
    Rarity == Magic
    HasExplicitMod ==2 MODS_WEAPON_GRAND MODS_ONE_HAND_AXE_GRAND
    #.import STYLE | weapon > magic -> t2

Show #.strict STRICTNESS_STRICT
    Rarity == Magic
    #.import STYLE | weapon > magic -> t2
    #.multi
        Class == "One Hand Axes"
        HasExplicitMod ==2 MODS_WEAPON_GRAND MODS_ONE_HAND_AXE_GRAND
    #.multi
        BaseType == BASES_ONE_HAND_AXE_BEST
        HasExplicitMod == MODS_WEAPON_GRAND MODS_ONE_HAND_AXE_GRAND

Show #.strict STRICTNESS_LENIENT
    Rarity == Magic
    #.import STYLE | weapon > magic -> t3
    #.multi
        Class == "One Hand Axes"
        HasExplicitMod == MODS_WEAPON_GRAND MODS_ONE_HAND_AXE_GRAND
    #.multi
        Class == "One Hand Axes"
        HasExplicitMod ==2 MODS_WEAPON_GREATER MODS_ONE_HAND_AXE_GREATER
    #.multi
        BaseType == BASES_ONE_HAND_AXE_BEST
        HasExplicitMod == MODS_WEAPON_GREATER MODS_ONE_HAND_AXE_GREATER

Show #.strict STRICTNESS_BASE
    Rarity == Magic
    #.import STYLE | weapon > magic -> t3
    #.multi
        Class == "One Hand Axes"
        HasExplicitMod == MODS_WEAPON_GREATER MODS_ONE_HAND_AXE_GREATER
    #.multi
        Class == "One Hand Axes"
        HasExplicitMod ==2 MODS_WEAPON_LESSER MODS_ONE_HAND_AXE_LESSER
    #.multi
        BaseType == BASES_ONE_HAND_AXE_BEST
        HasExplicitMod == MODS_WEAPON_LESSER MODS_ONE_HAND_AXE_LESSER

# Fractured

Show
    BaseType == BASES_ONE_HAND_AXE_BEST
    FracturedItem True
    HasExplicitMod == MODS_WEAPON_GRAND MODS_ONE_HAND_AXE_GRAND
    ItemLevel >= ITEM_LEVEL_WEAPON_BEST
    #.import _util -> multi_t1_rare
    #.import _util -> multi_t1_magic

Show
    BaseType == BASES_ONE_HAND_AXE_BEST
    FracturedItem True
    HasExplicitMod == MODS_WEAPON_GRAND MODS_ONE_HAND_AXE_GRAND
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

Show #.strict STRICTNESS_STRICT .if Show
    BaseType == BASES_ONE_HAND_AXE_BEST
    FracturedItem True
    ItemLevel >= ITEM_LEVEL_WEAPON_BEST
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

Show #.strict STRICTNESS_LENIENT .if Show
