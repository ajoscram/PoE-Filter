#.subsection Two-hand Axe

#.alias BASES_TWO_HAND_AXE_EXCEPTIONAL    = "Apex Cleaver"
#.alias BASES_TWO_HAND_AXE_BEST           = "Karui Chopper" "Despot Axe" "Vaal Axe" "Fleshripper"

#.alias MODS_TWO_HAND_AXE_EXCEPTIONAL     = "Topotante's" "Tacati's" "of Tacati"
#.alias MODS_TWO_HAND_AXE_GRAND           = "of the Gods" "of the Wind" "of Celebration" "of the Ranger"
#.alias MODS_TWO_HAND_AXE_GREATER         = "Paragon's" "Weaponmaster's" "of the Titan" "of the Phantom" "of Infamy" "of the Marksman"
#.alias MODS_TWO_HAND_AXE_LESSER          = "Combatant's" "of the Leviathan" "of the Jaguar" "of Fame" "of the Sniper" "of the Vampire"

# Unique

Show #.econ uni 100
    BaseType == "Vaal Axe" "Despot Axe" "Void Axe"
    Class == "Two Hand Axes" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    LinkedSockets < 5 #.format
    #.import STYLE | weapon > unique -> t1

Show #.econ uni 10 100
    BaseType == "Abyssal Axe"
    Class == "Two Hand Axes" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    LinkedSockets < 5 #.format
    #.import STYLE | weapon > unique -> t2

Show #.econ uni 1 10 .strict STRICTNESS_STRICT .if Show
    BaseType == "Vaal Axe" "Despot Axe" "Shadow Axe" "Abyssal Axe" "Ezomyte Axe" "Karui Chopper" "Woodsplitter" "Headsman Axe"
    Class == "Two Hand Axes" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    LinkedSockets < 5 #.format
    #.import STYLE | weapon > unique -> t3

# Exceptional Mods

Show
    BaseType == BASES_TWO_HAND_AXE_BEST
    HasExplicitMod == MODS_WEAPON_EXCEPTIONAL MODS_TWO_HAND_AXE_EXCEPTIONAL
    #.import _util -> multi_t1_rare
    #.import _util -> multi_t1_magic

Show
    Class == "Two Hand Axes"
    HasExplicitMod == MODS_WEAPON_EXCEPTIONAL MODS_TWO_HAND_AXE_EXCEPTIONAL
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

# Rare

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t1
    #.multi
        Class == "Two Hand Axes"
        HasExplicitMod ==6 MODS_WEAPON_GRAND MODS_TWO_HAND_AXE_GRAND
    #.multi
        BaseType == BASES_TWO_HAND_AXE_BEST
        HasExplicitMod >=5 MODS_WEAPON_GRAND MODS_TWO_HAND_AXE_GRAND

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == "Two Hand Axes"
        HasExplicitMod >=5 MODS_WEAPON_GRAND MODS_TWO_HAND_AXE_GRAND
    #.multi
        BaseType == BASES_TWO_HAND_AXE_BEST
        HasExplicitMod >=4 MODS_WEAPON_GRAND MODS_TWO_HAND_AXE_GRAND

Show #.strict STRICTNESS_STRICT
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == "Two Hand Axes"
        HasExplicitMod >=3 MODS_WEAPON_GRAND MODS_TWO_HAND_AXE_GRAND
    #.multi
        BaseType == BASES_TWO_HAND_AXE_BEST
        HasExplicitMod >=2 MODS_WEAPON_GRAND MODS_TWO_HAND_AXE_GRAND

Show #.strict STRICTNESS_LENIENT
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == "Two Hand Axes"
        HasExplicitMod >=3 MODS_WEAPON_GREATER MODS_TWO_HAND_AXE_GREATER MODS_WEAPON_GRAND MODS_TWO_HAND_AXE_GRAND
    #.multi
        BaseType == BASES_TWO_HAND_AXE_BEST
        HasExplicitMod >=2 MODS_WEAPON_GREATER MODS_TWO_HAND_AXE_GREATER MODS_WEAPON_GRAND MODS_TWO_HAND_AXE_GRAND

Show #.strict STRICTNESS_BASE
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == "Two Hand Axes"
        HasExplicitMod >=3 MODS_WEAPON_LESSER MODS_TWO_HAND_AXE_LESSER MODS_WEAPON_GREATER MODS_TWO_HAND_AXE_GREATER MODS_WEAPON_GRAND MODS_TWO_HAND_AXE_GRAND
    #.multi
        BaseType == BASES_TWO_HAND_AXE_BEST
        HasExplicitMod >=2 MODS_WEAPON_LESSER MODS_TWO_HAND_AXE_LESSER MODS_WEAPON_GREATER MODS_TWO_HAND_AXE_GREATER MODS_WEAPON_GRAND MODS_TWO_HAND_AXE_GRAND

# Magic

Show
    BaseType == BASES_TWO_HAND_AXE_BEST
    Rarity == Magic
    HasExplicitMod ==2 MODS_WEAPON_GRAND MODS_TWO_HAND_AXE_GRAND
    #.import STYLE | weapon > magic -> t2

Show #.strict STRICTNESS_STRICT
    Rarity == Magic
    #.import STYLE | weapon > magic -> t2
    #.multi
        Class == "Two Hand Axes"
        HasExplicitMod ==2 MODS_WEAPON_GRAND MODS_TWO_HAND_AXE_GRAND
    #.multi
        BaseType == BASES_TWO_HAND_AXE_BEST
        HasExplicitMod == MODS_WEAPON_GRAND MODS_TWO_HAND_AXE_GRAND

Show #.strict STRICTNESS_LENIENT
    Rarity == Magic
    #.import STYLE | weapon > magic -> t3
    #.multi
        Class == "Two Hand Axes"
        HasExplicitMod == MODS_WEAPON_GRAND MODS_TWO_HAND_AXE_GRAND
    #.multi
        Class == "Two Hand Axes"
        HasExplicitMod ==2 MODS_WEAPON_GREATER MODS_TWO_HAND_AXE_GREATER
    #.multi
        BaseType == BASES_TWO_HAND_AXE_BEST
        HasExplicitMod == MODS_WEAPON_GREATER MODS_TWO_HAND_AXE_GREATER

Show #.strict STRICTNESS_BASE
    Rarity == Magic
    #.import STYLE | weapon > magic -> t3
    #.multi
        Class == "Two Hand Axes"
        HasExplicitMod == MODS_WEAPON_GREATER MODS_TWO_HAND_AXE_GREATER
    #.multi
        Class == "Two Hand Axes"
        HasExplicitMod ==2 MODS_WEAPON_LESSER MODS_TWO_HAND_AXE_LESSER
    #.multi
        BaseType == BASES_TWO_HAND_AXE_BEST
        HasExplicitMod == MODS_WEAPON_LESSER MODS_TWO_HAND_AXE_LESSER

