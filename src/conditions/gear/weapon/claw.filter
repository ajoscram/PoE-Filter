#.subsection Claw

#.alias BASES_CLAW_EXCEPTIONAL    = "Void Fangs"
#.alias BASES_CLAW_BEST           = "Gemini Claw" "Imperial Claw" "Vaal Claw"

#.alias MODS_CLAW_EXCEPTIONAL     = "Topotante's" "Tacati's" "of Tacati"
#.alias MODS_CLAW_GRAND           = "Zaffre" "of the Wind" "of Celebration" "of the Ranger"
#.alias MODS_CLAW_GREATER         = "Blue" "Paragon's" "Weaponmaster's" "of the Phantom" "of Infamy" "of the Marksman"
#.alias MODS_CLAW_LESSER          = "Mazarine" "Combatant's" "of the Jaguar" "of Fame" "of the Sniper"

# Unique

Show #.econ uni 100
    BaseType == "Vaal Claw" "Hellion's Paw"
    Class == "Claws" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t1

Show #.econ uni 10 100
    BaseType == "Vaal Claw"
    Class == "Claws" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t2

Show #.econ uni 1 10 .strict STRICTNESS_STRICT .if Show
    BaseType == "Fright Claw" "Imperial Claw" "Nailed Fist" "Terror Claw" "Hellion's Paw" "Timeworn Claw" "Throat Stabber"
    Class == "Claws" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t3

# Exceptional Mods

Show
    BaseType == BASES_CLAW_BEST
    HasExplicitMod == MODS_WEAPON_EXCEPTIONAL MODS_CLAW_EXCEPTIONAL
    #.import _util -> multi_t1_rare
    #.import _util -> multi_t1_magic

Show
    Class == "Claws"
    HasExplicitMod == MODS_WEAPON_EXCEPTIONAL MODS_CLAW_EXCEPTIONAL
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

# Rare

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t1
    #.multi
        Class == "Claws"
        HasExplicitMod ==6 MODS_WEAPON_GRAND MODS_CLAW_GRAND
    #.multi
        BaseType == BASES_CLAW_BEST
        HasExplicitMod >=5 MODS_WEAPON_GRAND MODS_CLAW_GRAND

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == "Claws"
        HasExplicitMod >=5 MODS_WEAPON_GRAND MODS_CLAW_GRAND
    #.multi
        BaseType == BASES_CLAW_BEST
        HasExplicitMod >=4 MODS_WEAPON_GRAND MODS_CLAW_GRAND

Show #.strict STRICTNESS_STRICT
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == "Claws"
        HasExplicitMod >=3 MODS_WEAPON_GRAND MODS_CLAW_GRAND
    #.multi
        BaseType == BASES_CLAW_BEST
        HasExplicitMod >=2 MODS_WEAPON_GRAND MODS_CLAW_GRAND

Show #.strict STRICTNESS_LENIENT
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == "Claws"
        HasExplicitMod >=3 MODS_WEAPON_GREATER MODS_CLAW_GREATER MODS_WEAPON_GRAND MODS_CLAW_GRAND
    #.multi
        BaseType == BASES_CLAW_BEST
        HasExplicitMod >=2 MODS_WEAPON_GREATER MODS_CLAW_GREATER MODS_WEAPON_GRAND MODS_CLAW_GRAND

Show #.strict STRICTNESS_BASE
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == "Claws"
        HasExplicitMod >=3 MODS_WEAPON_LESSER MODS_CLAW_LESSER MODS_WEAPON_GREATER MODS_CLAW_GREATER MODS_WEAPON_GRAND MODS_CLAW_GRAND
    #.multi
        BaseType == BASES_CLAW_BEST
        HasExplicitMod >=2 MODS_WEAPON_LESSER MODS_CLAW_LESSER MODS_WEAPON_GREATER MODS_CLAW_GREATER MODS_WEAPON_GRAND MODS_CLAW_GRAND

# Magic

Show
    BaseType == BASES_CLAW_BEST
    Rarity == Magic
    HasExplicitMod ==2 MODS_WEAPON_GRAND MODS_CLAW_GRAND
    #.import STYLE | weapon > magic -> t2

Show #.strict STRICTNESS_STRICT
    Rarity == Magic
    #.import STYLE | weapon > magic -> t2
    #.multi
        Class == "Claws"
        HasExplicitMod ==2 MODS_WEAPON_GRAND MODS_CLAW_GRAND
    #.multi
        BaseType == BASES_CLAW_BEST
        HasExplicitMod == MODS_WEAPON_GRAND MODS_CLAW_GRAND

Show #.strict STRICTNESS_LENIENT
    Rarity == Magic
    #.import STYLE | weapon > magic -> t3
    #.multi
        Class == "Claws"
        HasExplicitMod == MODS_WEAPON_GRAND MODS_CLAW_GRAND
    #.multi
        Class == "Claws"
        HasExplicitMod ==2 MODS_WEAPON_GREATER MODS_CLAW_GREATER
    #.multi
        BaseType == BASES_CLAW_BEST
        HasExplicitMod == MODS_WEAPON_GREATER MODS_CLAW_GREATER

Show #.strict STRICTNESS_BASE
    Rarity == Magic
    #.import STYLE | weapon > magic -> t3
    #.multi
        Class == "Claws"
        HasExplicitMod == MODS_WEAPON_GREATER MODS_CLAW_GREATER
    #.multi
        Class == "Claws"
        HasExplicitMod ==2 MODS_WEAPON_LESSER MODS_CLAW_LESSER
    #.multi
        BaseType == BASES_CLAW_BEST
        HasExplicitMod == MODS_WEAPON_LESSER MODS_CLAW_LESSER

# Fractured

Show
    BaseType == BASES_CLAW_BEST
    FracturedItem True
    HasExplicitMod == MODS_WEAPON_GRAND MODS_CLAW_GRAND
    ItemLevel >= MODS_WEAPON_BEST_ITEM_LEVEL
    #.import _util -> multi_t1_rare
    #.import _util -> multi_t1_magic

Show
    BaseType == BASES_CLAW_BEST
    FracturedItem True
    HasExplicitMod == MODS_WEAPON_GRAND MODS_CLAW_GRAND
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

Show #.strict STRICTNESS_STRICT .if Show
    BaseType == BASES_CLAW_BEST
    FracturedItem True
    ItemLevel >= MODS_WEAPON_BEST_ITEM_LEVEL
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

Show #.strict STRICTNESS_LENIENT .if Show
    BaseType == BASES_CLAW_BEST
    FracturedItem True
    #.import _util -> multi_t3_rare
    #.import _util -> multi_t3_magic

# Synthesized

Show
    BaseType == BASES_CLAW_BEST
    SynthesisedItem True
    ItemLevel >= MODS_WEAPON_BEST_ITEM_LEVEL
    #.import _util -> multi_t1

Show
    BaseType == BASES_CLAW_BEST
    SynthesisedItem True
    #.import _util -> multi_t2

# Influenced

Show #.strict STRICTNESS_STRICT .if Show
