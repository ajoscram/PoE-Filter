#.subsection Claw

#.alias BASES_CLAW_EXCEPTIONAL = "Void Fangs"
#.alias BASES_CLAW_BEST        = "Gemini Claw" "Imperial Claw" "Vaal Claw"

#.alias MODS_CLAW_EXCEPTIONAL = "Topotante's" "Tacati's" "of Tacati"
#.alias MODS_CLAW_GRAND       = "Zaffre" "of the Wind" "of Celebration" "of the Ranger"
#.alias MODS_CLAW_GREATER     = "Blue" "Paragon's" "Weaponmaster's" "of the Phantom" "of Infamy" "of the Marksman"
#.alias MODS_CLAW_LESSER      = "Mazarine" "Combatant's" "of the Jaguar" "of Fame" "of the Sniper"

# Unique

Show #.econ uni 100
    BaseType == "Hellion's Paw" "Vaal Claw"
    Class == "Claws" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t1

Show #.econ uni 10 100
    BaseType == "Vaal Claw"
    Class == "Claws" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t2

Show #.econ uni 1 10 .strict STRICTNESS_STRICT .if Show
    BaseType == "Vaal Claw" "Timeworn Claw" "Nailed Fist" "Throat Stabber" "Terror Claw" "Hellion's Paw" "Awl" "Gut Ripper" "Fright Claw" "Imperial Claw"
    Class == "Claws" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t3

#.import template > _main { CLASS = "Claws", BASES_BEST = BASES_CLAW_BEST, BASES_EXCEPTIONAL = BASES_CLAW_EXCEPTIONAL, MODS_EXCEPTIONAL = MODS_CLAW_EXCEPTIONAL, MODS_GRAND = MODS_CLAW_GRAND, MODS_GREATER = MODS_CLAW_GREATER, MODS_LESSER = MODS_CLAW_LESSER