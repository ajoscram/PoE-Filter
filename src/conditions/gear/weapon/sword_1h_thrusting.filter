#.subsection Thrusting One-hand Sword

#.alias ONE_HAND_SWORD_THRUSTING_BEST_BASES           = "Dragoon Sword" "Jewelled Foil" "Vaal Rapier" "Harpy Rapier"

#.alias ONE_HAND_SWORD_THRUSTING_EXCEPTIONAL_MODS     = "Topotante's" "Tacati's" "of Tacati"
#.alias ONE_HAND_SWORD_THRUSTING_GRAND_MODS           = "of the Gods" "of the Wind" "of Celebration" "of the Ranger"
#.alias ONE_HAND_SWORD_THRUSTING_GREATER_MODS         = "Paragon's" "Weaponmaster's" "of the Titan" "of the Phantom" "of Infamy" "of the Marksman"
#.alias ONE_HAND_SWORD_THRUSTING_LESSER_MODS          = "Combatant's" "of the Leviathan" "of the Jaguar" "of Fame" "of the Sniper"

# Unique

Show #.econ uni 100
    BaseType == "Vaal Rapier"
    Class == "Thrusting One Hand Swords" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t1

Show #.econ uni 10 100
    BaseType == "Jewelled Foil"
    Class == "Thrusting One Hand Swords" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t2

Show #.econ uni 1 10 .strict STRICTNESS_STRICT .if Show
    BaseType == "Basket Rapier"
    Class == "Thrusting One Hand Swords" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t3

# Exceptional Mods

Show
    BaseType == ONE_HAND_SWORD_THRUSTING_BEST_BASES
    HasExplicitMod == MODS_WEAPON_EXCEPTIONAL ONE_HAND_SWORD_THRUSTING_EXCEPTIONAL_MODS
    #.import _util -> multi_t1_rare
    #.import _util -> multi_t1_magic

Show
    Class == "Thrusting One Hand Swords"
    HasExplicitMod == MODS_WEAPON_EXCEPTIONAL ONE_HAND_SWORD_THRUSTING_EXCEPTIONAL_MODS
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

# Rare

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t1
    #.multi
        Class == "Thrusting One Hand Swords"
        HasExplicitMod ==6 MODS_WEAPON_GRAND ONE_HAND_SWORD_THRUSTING_GRAND_MODS
    #.multi
        BaseType == ONE_HAND_SWORD_THRUSTING_BEST_BASES
        HasExplicitMod >=5 MODS_WEAPON_GRAND ONE_HAND_SWORD_THRUSTING_GRAND_MODS

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == "Thrusting One Hand Swords"
        HasExplicitMod >=5 MODS_WEAPON_GRAND ONE_HAND_SWORD_THRUSTING_GRAND_MODS
    #.multi
        BaseType == ONE_HAND_SWORD_THRUSTING_BEST_BASES
        HasExplicitMod >=4 MODS_WEAPON_GRAND ONE_HAND_SWORD_THRUSTING_GRAND_MODS

Show #.strict STRICTNESS_STRICT
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == "Thrusting One Hand Swords"
        HasExplicitMod >=3 MODS_WEAPON_GRAND ONE_HAND_SWORD_THRUSTING_GRAND_MODS
    #.multi
        BaseType == ONE_HAND_SWORD_THRUSTING_BEST_BASES
        HasExplicitMod >=2 MODS_WEAPON_GRAND ONE_HAND_SWORD_THRUSTING_GRAND_MODS

Show #.strict STRICTNESS_LENIENT
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == "Thrusting One Hand Swords"
        HasExplicitMod >=3 MODS_WEAPON_GREATER ONE_HAND_SWORD_THRUSTING_GREATER_MODS MODS_WEAPON_GRAND ONE_HAND_SWORD_THRUSTING_GRAND_MODS
    #.multi
        BaseType == ONE_HAND_SWORD_THRUSTING_BEST_BASES
        HasExplicitMod >=2 MODS_WEAPON_GREATER ONE_HAND_SWORD_THRUSTING_GREATER_MODS MODS_WEAPON_GRAND ONE_HAND_SWORD_THRUSTING_GRAND_MODS

Show #.strict STRICTNESS_BASE
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == "Thrusting One Hand Swords"
        HasExplicitMod >=3 MODS_WEAPON_LESSER ONE_HAND_SWORD_THRUSTING_LESSER_MODS MODS_WEAPON_GREATER ONE_HAND_SWORD_THRUSTING_GREATER_MODS MODS_WEAPON_GRAND ONE_HAND_SWORD_THRUSTING_GRAND_MODS
    #.multi
        BaseType == ONE_HAND_SWORD_THRUSTING_BEST_BASES
        HasExplicitMod >=2 MODS_WEAPON_LESSER ONE_HAND_SWORD_THRUSTING_LESSER_MODS MODS_WEAPON_GREATER ONE_HAND_SWORD_THRUSTING_GREATER_MODS MODS_WEAPON_GRAND ONE_HAND_SWORD_THRUSTING_GRAND_MODS

