#.subsection Thrusting One-hand Sword

#.alias BASES_ONE_HAND_SWORD_THRUSTING_BEST           = "Dragoon Sword" "Jewelled Foil" "Vaal Rapier" "Harpy Rapier"

#.alias MODS_ONE_HAND_SWORD_THRUSTING_EXCEPTIONAL     = "Topotante's" "Tacati's" "of Tacati"
#.alias MODS_ONE_HAND_SWORD_THRUSTING_GRAND           = "of the Gods" "of the Wind" "of Celebration" "of the Ranger"
#.alias MODS_ONE_HAND_SWORD_THRUSTING_GREATER         = "Paragon's" "Weaponmaster's" "of the Titan" "of the Phantom" "of Infamy" "of the Marksman"
#.alias MODS_ONE_HAND_SWORD_THRUSTING_LESSER          = "Combatant's" "of the Leviathan" "of the Jaguar" "of Fame" "of the Sniper"

# Unique

Show #.econ uni 100
    BaseType == "Vaal Rapier"
    Class == "Thrusting One Hand Swords" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t1

Show #.econ uni 10 100
    BaseType == "Jewelled Foil"
    Class == "Thrusting One Hand Swords" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t2

Show #.econ uni 1 10 .strict STRICTNESS_STRICT .if Show
    BaseType == "Basket Rapier"
    Class == "Thrusting One Hand Swords" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t3

# Exceptional Mods

Show
    BaseType == BASES_ONE_HAND_SWORD_THRUSTING_BEST
    HasExplicitMod == MODS_WEAPON_EXCEPTIONAL MODS_ONE_HAND_SWORD_THRUSTING_EXCEPTIONAL
    #.import _util -> multi_t1_rare
    #.import _util -> multi_t1_magic

Show
    Class == "Thrusting One Hand Swords"
    HasExplicitMod == MODS_WEAPON_EXCEPTIONAL MODS_ONE_HAND_SWORD_THRUSTING_EXCEPTIONAL
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

# Rare

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t1
    #.multi
        Class == "Thrusting One Hand Swords"
        HasExplicitMod ==6 MODS_WEAPON_GRAND MODS_ONE_HAND_SWORD_THRUSTING_GRAND
    #.multi
        BaseType == BASES_ONE_HAND_SWORD_THRUSTING_BEST
        HasExplicitMod >=5 MODS_WEAPON_GRAND MODS_ONE_HAND_SWORD_THRUSTING_GRAND

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == "Thrusting One Hand Swords"
        HasExplicitMod >=5 MODS_WEAPON_GRAND MODS_ONE_HAND_SWORD_THRUSTING_GRAND
    #.multi
        BaseType == BASES_ONE_HAND_SWORD_THRUSTING_BEST
        HasExplicitMod >=4 MODS_WEAPON_GRAND MODS_ONE_HAND_SWORD_THRUSTING_GRAND

Show #.strict STRICTNESS_STRICT
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == "Thrusting One Hand Swords"
        HasExplicitMod >=3 MODS_WEAPON_GRAND MODS_ONE_HAND_SWORD_THRUSTING_GRAND
    #.multi
        BaseType == BASES_ONE_HAND_SWORD_THRUSTING_BEST
        HasExplicitMod >=2 MODS_WEAPON_GRAND MODS_ONE_HAND_SWORD_THRUSTING_GRAND

Show #.strict STRICTNESS_LENIENT
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == "Thrusting One Hand Swords"
        HasExplicitMod >=3 MODS_WEAPON_GREATER MODS_ONE_HAND_SWORD_THRUSTING_GREATER MODS_WEAPON_GRAND MODS_ONE_HAND_SWORD_THRUSTING_GRAND
    #.multi
        BaseType == BASES_ONE_HAND_SWORD_THRUSTING_BEST
        HasExplicitMod >=2 MODS_WEAPON_GREATER MODS_ONE_HAND_SWORD_THRUSTING_GREATER MODS_WEAPON_GRAND MODS_ONE_HAND_SWORD_THRUSTING_GRAND

Show #.strict STRICTNESS_BASE
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == "Thrusting One Hand Swords"
        HasExplicitMod >=3 MODS_WEAPON_LESSER MODS_ONE_HAND_SWORD_THRUSTING_LESSER MODS_WEAPON_GREATER MODS_ONE_HAND_SWORD_THRUSTING_GREATER MODS_WEAPON_GRAND MODS_ONE_HAND_SWORD_THRUSTING_GRAND
    #.multi
        BaseType == BASES_ONE_HAND_SWORD_THRUSTING_BEST
        HasExplicitMod >=2 MODS_WEAPON_LESSER MODS_ONE_HAND_SWORD_THRUSTING_LESSER MODS_WEAPON_GREATER MODS_ONE_HAND_SWORD_THRUSTING_GREATER MODS_WEAPON_GRAND MODS_ONE_HAND_SWORD_THRUSTING_GRAND

