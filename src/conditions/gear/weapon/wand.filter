#.subsection Wand

#.alias BASES_WAND_EXCEPTIONAL    = "Accumulator Wand"
#.alias BASES_WAND_BEST           = "Convoking Wand" "Profane Wand" "Prophecy Wand" "Tornado Wand" "Opal Wand" "Kinetic Wand" "Demon's Horn"

#.alias MODS_WAND_EXCEPTIONAL     = "Empress's" "Infamous" "Topotante's" "Matatl's" "Tacati's" "Citaqualotl's" "Esh's" "Ionising" "Tul's" "Cryomancer's" "Xoph's" "Pyroclastic" "Runic" "Glyphic" "Lich's" "Magister's" "of Exsanguinating" "of Hemorrhaging" "of the Fanatical" "of the Zealous" "of Heartstopping" "of the Gelid" "of Disintegrating" "of Tacati" "of Matatl" "of Citaqualotl" "of Infamy"
#.alias MODS_WAND_GRAND           = "Martinet's" "King's" "Queen's" "Zaffre" "Smiting" "Crystalline" "Magmatic" "Incanter's" "Archmage's" "Lithomancer's" "Mad Lord's" "Thunderhand's" "Frost Singer's" "Flame Shaper's" "Electrocuting" "Entombing" "Cremating" "of the Genius" "of Finesse" "of Acclaim" "of Unmaking" "of the Gale" "of Lioneye" "of Atrophying" "of the Boreal" "of the Ardent" "of Phlebotomising" "of Infuriation" "of Destiny" "of the Legion" "of the Convocation"
#.alias MODS_WAND_GREATER         = "Prince's" "Princess's" "Blue" "Striking" "Hailing" "Volcanic" "Occultist's" "Mage's" "Discharging" "Polar" "Blasting" "of the Virtuoso" "of Sortilege" "of Renown" "of Ruin" "of the Zephyr" "of Ashes" "of Glaciation" "of Arcing" "of the Ranger" "of Conflagration" "of Deteriorating" "of the Bleak" "of the Fervid" "of Spilling" "of Provocation" "of Determinism" "of the Invasion"
#.alias MODS_WAND_LESSER          = "Duke's" "Duchess's" "Mazarine" "Coursing" "Snowy" "Cauterising" "Professor's" "Warlock's" "Shocking" "Glaciated" "Incinerating" "of the Savant" "of Prestidigitation" "of Mastery" "of Calamity" "of Propulsion" "of Immolation" "of Floe" "of Discharge" "of the Marksman" "of Combustion" "of Wasting" "of the Inclement" "of the Earnest" "of Seeping" "of Instigation" "of Serendipity" "of the Swarm"

# Unique

Show #.econ uni 100
    BaseType == "Prophecy Wand"
    Class == "Wands" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t1

Show #.econ uni 10 100
    BaseType == "Faun's Horn" "Sage Wand" "Opal Wand" "Prophecy Wand" "Somatic Wand"
    Class == "Wands" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t2

Show #.econ uni 1 10 .strict STRICTNESS_STRICT .if Show
    BaseType == "Tornado Wand" "Sage Wand" "Spiraled Wand" "Kinetic Wand" "Goat's Horn" "Driftwood Wand" "Calling Wand" "Omen Wand" "Pagan Wand"
    Class == "Wands" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t3

# Exceptional Mods

Show
    BaseType == BASES_WAND_BEST
    HasExplicitMod == MODS_WEAPON_EXCEPTIONAL MODS_WAND_EXCEPTIONAL
    #.import _util -> multi_t1_rare
    #.import _util -> multi_t1_magic

Show
    Class == "Wands"
    HasExplicitMod == MODS_WEAPON_EXCEPTIONAL MODS_WAND_EXCEPTIONAL
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

# Rare

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t1
    #.multi
        Class == "Wands"
        HasExplicitMod ==6 MODS_WEAPON_GRAND MODS_WAND_GRAND
    #.multi
        BaseType == BASES_WAND_BEST
        HasExplicitMod >=5 MODS_WEAPON_GRAND MODS_WAND_GRAND

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == "Wands"
        HasExplicitMod >=5 MODS_WEAPON_GRAND MODS_WAND_GRAND
    #.multi
        BaseType == BASES_WAND_BEST
        HasExplicitMod >=4 MODS_WEAPON_GRAND MODS_WAND_GRAND

Show #.strict STRICTNESS_STRICT
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == "Wands"
        HasExplicitMod >=3 MODS_WEAPON_GRAND MODS_WAND_GRAND
    #.multi
        BaseType == BASES_WAND_BEST
        HasExplicitMod >=2 MODS_WEAPON_GRAND MODS_WAND_GRAND

Show #.strict STRICTNESS_LENIENT
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == "Wands"
        HasExplicitMod >=3 MODS_WEAPON_GREATER MODS_WAND_GREATER MODS_WEAPON_GRAND MODS_WAND_GRAND
    #.multi
        BaseType == BASES_WAND_BEST
        HasExplicitMod >=2 MODS_WEAPON_GREATER MODS_WAND_GREATER MODS_WEAPON_GRAND MODS_WAND_GRAND

Show #.strict STRICTNESS_BASE
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == "Wands"
        HasExplicitMod >=3 MODS_WEAPON_LESSER MODS_WAND_LESSER MODS_WEAPON_GREATER MODS_WAND_GREATER MODS_WEAPON_GRAND MODS_WAND_GRAND
    #.multi
        BaseType == BASES_WAND_BEST
        HasExplicitMod >=2 MODS_WEAPON_LESSER MODS_WAND_LESSER MODS_WEAPON_GREATER MODS_WAND_GREATER MODS_WEAPON_GRAND MODS_WAND_GRAND

# Magic

Show
    BaseType == BASES_WAND_BEST
    Rarity == Magic
    HasExplicitMod ==2 MODS_WEAPON_GRAND MODS_WAND_GRAND
    #.import STYLE | weapon > magic -> t2

Show #.strict STRICTNESS_STRICT
    Rarity == Magic
    #.import STYLE | weapon > magic -> t2
    #.multi
        Class == "Wands"
        HasExplicitMod ==2 MODS_WEAPON_GRAND MODS_WAND_GRAND
    #.multi
        BaseType == BASES_WAND_BEST
        HasExplicitMod == MODS_WEAPON_GRAND MODS_WAND_GRAND

Show #.strict STRICTNESS_LENIENT
    Rarity == Magic
    #.import STYLE | weapon > magic -> t3
    #.multi
        Class == "Wands"
        HasExplicitMod == MODS_WEAPON_GRAND MODS_WAND_GRAND
    #.multi
        Class == "Wands"
        HasExplicitMod ==2 MODS_WEAPON_GREATER MODS_WAND_GREATER
    #.multi
        BaseType == BASES_WAND_BEST
        HasExplicitMod == MODS_WEAPON_GREATER MODS_WAND_GREATER

Show #.strict STRICTNESS_BASE
    Rarity == Magic
    #.import STYLE | weapon > magic -> t3
    #.multi
        Class == "Wands"
        HasExplicitMod == MODS_WEAPON_GREATER MODS_WAND_GREATER
    #.multi
        Class == "Wands"
        HasExplicitMod ==2 MODS_WEAPON_LESSER MODS_WAND_LESSER
    #.multi
        BaseType == BASES_WAND_BEST
        HasExplicitMod == MODS_WEAPON_LESSER MODS_WAND_LESSER

# Fractured

Show
    BaseType == BASES_WAND_BEST
    FracturedItem True
    HasExplicitMod == MODS_WEAPON_GRAND MODS_WAND_GRAND
    ItemLevel >= ITEM_LEVEL_WEAPON_BEST
    #.import _util -> multi_t1_rare
    #.import _util -> multi_t1_magic

Show
    BaseType == BASES_WAND_BEST
    FracturedItem True
    HasExplicitMod == MODS_WEAPON_GRAND MODS_WAND_GRAND
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

Show #.strict STRICTNESS_STRICT .if Show
    BaseType == BASES_WAND_BEST
    FracturedItem True
    ItemLevel >= ITEM_LEVEL_WEAPON_BEST
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

Show #.strict STRICTNESS_LENIENT .if Show
    BaseType == BASES_WAND_BEST
    FracturedItem True
    #.import _util -> multi_t3_rare
    #.import _util -> multi_t3_magic

