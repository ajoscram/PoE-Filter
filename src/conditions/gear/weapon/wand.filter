#.subsection Wand

#.alias BASES_WAND_EXCEPTIONAL = "Accumulator Wand"
#.alias BASES_WAND_BEST        = "Convoking Wand" "Profane Wand" "Prophecy Wand" "Tornado Wand" "Kinetic Wand"

#.alias MODS_WAND_EXCEPTIONAL = "Empress's" "Infamous" "Topotante's" "Matatl's" "Tacati's" "Citaqualotl's" "Esh's" "Ionising" "Tul's" "Cryomancer's" "Xoph's" "Pyroclastic" "Runic" "Lich's" "Magister's" "of Exsanguinating" "of Hemorrhaging" "of the Fanatical" "of the Zealous" "of Heartstopping" "of the Gelid" "of Disintegrating" "of Tacati" "of Matatl" "of Citaqualotl" "of Infamy"
#.alias MODS_WAND_GRAND       = "Martinet's" "King's" "Queen's" "Zaffre" "Smiting" "Crystalline" "Magmatic" "Glyphic" "Archmage's" "Lithomancer's" "Mad Lord's" "Thunderhand's" "Frost Singer's" "Flame Shaper's" "Electrocuting" "Entombing" "Cremating" "of the Genius" "of Finesse" "of Acclaim" "of Unmaking" "of the Gale" "of Lioneye" "of Atrophying" "of the Boreal" "of the Ardent" "of Phlebotomising" "of Infuriation" "of Destiny" "of the Legion" "of the Convocation"
#.alias MODS_WAND_GREATER     = "Prince's" "Princess's" "Blue" "Striking" "Hailing" "Volcanic" "Incanter's" "Mage's" "Discharging" "Polar" "Blasting" "of the Virtuoso" "of Sortilege" "of Renown" "of Ruin" "of the Zephyr" "of Ashes" "of Glaciation" "of Arcing" "of the Ranger" "of Conflagration" "of Deteriorating" "of the Bleak" "of the Fervid" "of Spilling" "of Provocation" "of Determinism" "of the Invasion"
#.alias MODS_WAND_LESSER      = "Duke's" "Duchess's" "Mazarine" "Coursing" "Snowy" "Cauterising" "Occultist's" "Warlock's" "Shocking" "Glaciated" "Incinerating" "of the Savant" "of Prestidigitation" "of Mastery" "of Calamity" "of Propulsion" "of Immolation" "of Floe" "of Discharge" "of the Marksman" "of Combustion" "of Wasting" "of the Inclement" "of the Earnest" "of Seeping" "of Instigation" "of Serendipity" "of the Swarm"

# Unique

Show #.econ uni 100
    BaseType == "Prophecy Wand"
    Class == "Wands" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t1

Show #.econ uni 10 100
    BaseType == "Faun's Horn" "Sage Wand" "Opal Wand" "Prophecy Wand" "Somatic Wand"
    Class == "Wands" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t2

Show #.econ uni 1 10 .strict STRICTNESS_STRICT .if Show
    BaseType == "Tornado Wand" "Sage Wand" "Spiraled Wand" "Kinetic Wand" "Goat's Horn" "Driftwood Wand" "Calling Wand" "Omen Wand" "Pagan Wand"
    Class == "Wands" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t3

#.import template > _main { CLASS = "Wands", BASES_BEST = BASES_WAND_BEST, BASES_EXCEPTIONAL = BASES_WAND_EXCEPTIONAL, MODS_EXCEPTIONAL = MODS_WAND_EXCEPTIONAL, MODS_GRAND = MODS_WAND_GRAND, MODS_GREATER = MODS_WAND_GREATER, MODS_LESSER = MODS_WAND_LESSER