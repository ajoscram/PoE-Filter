#.subsection Two-hand Mace

#.alias TWO_HAND_MACE_EXCEPTIONAL_BASES    = "Impact Force Propagator"
#.alias TWO_HAND_MACE_BEST_BASES           = "Coronal Maul" "Imperial Maul" "Meatgrinder" "Terror Maul" "Piledriver"

#.alias TWO_HAND_MACE_EXCEPTIONAL_MODS     = "Topotante's" "Tacati's" "of Tacati"
#.alias TWO_HAND_MACE_GRAND_MODS           = "of the Gods" "of Celebration" "of the Ranger"
#.alias TWO_HAND_MACE_GREATER_MODS         = "Paragon's" "Weaponmaster's" "of the Titan" "of Infamy" "of the Marksman"
#.alias TWO_HAND_MACE_LESSER_MODS          = "Combatant's" "of the Leviathan" "of Fame" "of the Sniper"

# Unique

Show #.econ uni 100
    BaseType == "Karui Maul"
    Class == "Two Hand Maces" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    LinkedSockets < 5 #.format
    #.import STYLE | weapon > unique -> t1

Show #.econ uni 10 100
    BaseType == "Imperial Maul" "Coronal Maul" "Piledriver"
    Class == "Two Hand Maces" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    LinkedSockets < 5 #.format
    #.import STYLE | weapon > unique -> t2

Show #.econ uni 1 10 .strict STRICTNESS_STRICT .if Show
    BaseType == "Meatgrinder" "Great Mallet" "Brass Maul"
    Class == "Two Hand Maces" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    LinkedSockets < 5 #.format
    #.import STYLE | weapon > unique -> t3

# Exceptional Mods

Show
    BaseType == TWO_HAND_MACE_BEST_BASES
    HasExplicitMod == MODS_WEAPON_EXCEPTIONAL TWO_HAND_MACE_EXCEPTIONAL_MODS
    #.import _util -> multi_t1_rare
    #.import _util -> multi_t1_magic

Show
    Class == "Two Hand Maces"
    HasExplicitMod == MODS_WEAPON_EXCEPTIONAL TWO_HAND_MACE_EXCEPTIONAL_MODS
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

# Rare

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t1
    #.multi
        Class == "Two Hand Maces"
        HasExplicitMod ==6 MODS_WEAPON_GRAND TWO_HAND_MACE_GRAND_MODS
    #.multi
        BaseType == TWO_HAND_MACE_BEST_BASES
        HasExplicitMod >=5 MODS_WEAPON_GRAND TWO_HAND_MACE_GRAND_MODS

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == "Two Hand Maces"
        HasExplicitMod >=5 MODS_WEAPON_GRAND TWO_HAND_MACE_GRAND_MODS
    #.multi
        BaseType == TWO_HAND_MACE_BEST_BASES
        HasExplicitMod >=4 MODS_WEAPON_GRAND TWO_HAND_MACE_GRAND_MODS

Show #.strict STRICTNESS_STRICT
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == "Two Hand Maces"
        HasExplicitMod >=3 MODS_WEAPON_GRAND TWO_HAND_MACE_GRAND_MODS
    #.multi
        BaseType == TWO_HAND_MACE_BEST_BASES
        HasExplicitMod >=2 MODS_WEAPON_GRAND TWO_HAND_MACE_GRAND_MODS

Show #.strict STRICTNESS_LENIENT
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == "Two Hand Maces"
        HasExplicitMod >=3 MODS_WEAPON_GREATER TWO_HAND_MACE_GREATER_MODS MODS_WEAPON_GRAND TWO_HAND_MACE_GRAND_MODS
    #.multi
        BaseType == TWO_HAND_MACE_BEST_BASES
        HasExplicitMod >=2 MODS_WEAPON_GREATER TWO_HAND_MACE_GREATER_MODS MODS_WEAPON_GRAND TWO_HAND_MACE_GRAND_MODS

Show #.strict STRICTNESS_BASE
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == "Two Hand Maces"
        HasExplicitMod >=3 MODS_WEAPON_LESSER TWO_HAND_MACE_LESSER_MODS MODS_WEAPON_GREATER TWO_HAND_MACE_GREATER_MODS MODS_WEAPON_GRAND TWO_HAND_MACE_GRAND_MODS
    #.multi
        BaseType == TWO_HAND_MACE_BEST_BASES
        HasExplicitMod >=2 MODS_WEAPON_LESSER TWO_HAND_MACE_LESSER_MODS MODS_WEAPON_GREATER TWO_HAND_MACE_GREATER_MODS MODS_WEAPON_GRAND TWO_HAND_MACE_GRAND_MODS

# Magic

Show
    BaseType == TWO_HAND_MACE_BEST_BASES
    Rarity == Magic
    HasExplicitMod ==2 MODS_WEAPON_GRAND TWO_HAND_MACE_GRAND_MODS
    #.import STYLE | weapon > magic -> t2

Show #.strict STRICTNESS_STRICT
    Rarity == Magic
    #.import STYLE | weapon > magic -> t2
    #.multi
        Class == "Two Hand Maces"
        HasExplicitMod ==2 MODS_WEAPON_GRAND TWO_HAND_MACE_GRAND_MODS
    #.multi
        BaseType == TWO_HAND_MACE_BEST_BASES
        HasExplicitMod == MODS_WEAPON_GRAND TWO_HAND_MACE_GRAND_MODS

Show #.strict STRICTNESS_LENIENT
    Rarity == Magic
    #.import STYLE | weapon > magic -> t3
    #.multi
        Class == "Two Hand Maces"
        HasExplicitMod == MODS_WEAPON_GRAND TWO_HAND_MACE_GRAND_MODS
    #.multi
        Class == "Two Hand Maces"
        HasExplicitMod ==2 MODS_WEAPON_GREATER TWO_HAND_MACE_GREATER_MODS
    #.multi
        BaseType == TWO_HAND_MACE_BEST_BASES
        HasExplicitMod == MODS_WEAPON_GREATER TWO_HAND_MACE_GREATER_MODS

Show #.strict STRICTNESS_BASE
    Rarity == Magic
    #.import STYLE | weapon > magic -> t3
    #.multi
        Class == "Two Hand Maces"
        HasExplicitMod == MODS_WEAPON_GREATER TWO_HAND_MACE_GREATER_MODS
    #.multi
        Class == "Two Hand Maces"
        HasExplicitMod ==2 MODS_WEAPON_LESSER TWO_HAND_MACE_LESSER_MODS
    #.multi
        BaseType == TWO_HAND_MACE_BEST_BASES
        HasExplicitMod == MODS_WEAPON_LESSER TWO_HAND_MACE_LESSER_MODS

# Fractured

Show
    BaseType == TWO_HAND_MACE_BEST_BASES
    FracturedItem True
    HasExplicitMod == MODS_WEAPON_GRAND TWO_HAND_MACE_GRAND_MODS
    ItemLevel >= MODS_WEAPON_BEST_ITEM_LEVEL
    #.import _util -> multi_t1_rare
    #.import _util -> multi_t1_magic

Show
    BaseType == TWO_HAND_MACE_BEST_BASES
    FracturedItem True
    HasExplicitMod == MODS_WEAPON_GRAND TWO_HAND_MACE_GRAND_MODS
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

Show #.strict STRICTNESS_STRICT .if Show
    BaseType == TWO_HAND_MACE_BEST_BASES
    FracturedItem True
    ItemLevel >= MODS_WEAPON_BEST_ITEM_LEVEL
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

Show #.strict STRICTNESS_LENIENT .if Show
    BaseType == TWO_HAND_MACE_BEST_BASES
    FracturedItem True
    #.import _util -> multi_t3_rare
    #.import _util -> multi_t3_magic

