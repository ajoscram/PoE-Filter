#.subsection Two-hand Mace

#.alias BASES_TWO_HAND_MACE_EXCEPTIONAL    = "Impact Force Propagator"
#.alias BASES_TWO_HAND_MACE_BEST           = "Coronal Maul" "Imperial Maul" "Meatgrinder" "Terror Maul" "Piledriver"

#.alias MODS_TWO_HAND_MACE_EXCEPTIONAL     = "Topotante's" "Tacati's" "of Tacati"
#.alias MODS_TWO_HAND_MACE_GRAND           = "of the Gods" "of Celebration" "of the Ranger"
#.alias MODS_TWO_HAND_MACE_GREATER         = "Paragon's" "Weaponmaster's" "of the Titan" "of Infamy" "of the Marksman"
#.alias MODS_TWO_HAND_MACE_LESSER          = "Combatant's" "of the Leviathan" "of Fame" "of the Sniper"

# Unique

Show #.econ uni 100
    BaseType == "Karui Maul"
    Class == "Two Hand Maces" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    LinkedSockets < 5 #.format
    #.import STYLE | weapon > unique -> t1

Show #.econ uni 10 100
    BaseType == "Imperial Maul" "Coronal Maul" "Piledriver"
    Class == "Two Hand Maces" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    LinkedSockets < 5 #.format
    #.import STYLE | weapon > unique -> t2

Show #.econ uni 1 10 .strict STRICTNESS_STRICT .if Show
    BaseType == "Meatgrinder" "Great Mallet" "Brass Maul"
    Class == "Two Hand Maces" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    LinkedSockets < 5 #.format
    #.import STYLE | weapon > unique -> t3

# Exceptional Mods

Show
    BaseType == BASES_TWO_HAND_MACE_BEST
    HasExplicitMod == MODS_WEAPON_EXCEPTIONAL MODS_TWO_HAND_MACE_EXCEPTIONAL
    #.import _util -> multi_t1_rare
    #.import _util -> multi_t1_magic

Show
    Class == "Two Hand Maces"
    HasExplicitMod == MODS_WEAPON_EXCEPTIONAL MODS_TWO_HAND_MACE_EXCEPTIONAL
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

# Rare

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t1
    #.multi
        Class == "Two Hand Maces"
        HasExplicitMod ==6 MODS_WEAPON_GRAND MODS_TWO_HAND_MACE_GRAND
    #.multi
        BaseType == BASES_TWO_HAND_MACE_BEST
        HasExplicitMod >=5 MODS_WEAPON_GRAND MODS_TWO_HAND_MACE_GRAND

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == "Two Hand Maces"
        HasExplicitMod >=5 MODS_WEAPON_GRAND MODS_TWO_HAND_MACE_GRAND
    #.multi
        BaseType == BASES_TWO_HAND_MACE_BEST
        HasExplicitMod >=4 MODS_WEAPON_GRAND MODS_TWO_HAND_MACE_GRAND

Show #.strict STRICTNESS_STRICT
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == "Two Hand Maces"
        HasExplicitMod >=3 MODS_WEAPON_GRAND MODS_TWO_HAND_MACE_GRAND
    #.multi
        BaseType == BASES_TWO_HAND_MACE_BEST
        HasExplicitMod >=2 MODS_WEAPON_GRAND MODS_TWO_HAND_MACE_GRAND

Show #.strict STRICTNESS_LENIENT
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == "Two Hand Maces"
        HasExplicitMod >=3 MODS_WEAPON_GREATER MODS_TWO_HAND_MACE_GREATER MODS_WEAPON_GRAND MODS_TWO_HAND_MACE_GRAND
    #.multi
        BaseType == BASES_TWO_HAND_MACE_BEST
        HasExplicitMod >=2 MODS_WEAPON_GREATER MODS_TWO_HAND_MACE_GREATER MODS_WEAPON_GRAND MODS_TWO_HAND_MACE_GRAND

Show #.strict STRICTNESS_BASE
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == "Two Hand Maces"
        HasExplicitMod >=3 MODS_WEAPON_LESSER MODS_TWO_HAND_MACE_LESSER MODS_WEAPON_GREATER MODS_TWO_HAND_MACE_GREATER MODS_WEAPON_GRAND MODS_TWO_HAND_MACE_GRAND
    #.multi
        BaseType == BASES_TWO_HAND_MACE_BEST
        HasExplicitMod >=2 MODS_WEAPON_LESSER MODS_TWO_HAND_MACE_LESSER MODS_WEAPON_GREATER MODS_TWO_HAND_MACE_GREATER MODS_WEAPON_GRAND MODS_TWO_HAND_MACE_GRAND

# Magic

Show
    BaseType == BASES_TWO_HAND_MACE_BEST
    Rarity == Magic
    HasExplicitMod ==2 MODS_WEAPON_GRAND MODS_TWO_HAND_MACE_GRAND
    #.import STYLE | weapon > magic -> t2

Show #.strict STRICTNESS_STRICT
    Rarity == Magic
    #.import STYLE | weapon > magic -> t2
    #.multi
        Class == "Two Hand Maces"
        HasExplicitMod ==2 MODS_WEAPON_GRAND MODS_TWO_HAND_MACE_GRAND
    #.multi
        BaseType == BASES_TWO_HAND_MACE_BEST
        HasExplicitMod == MODS_WEAPON_GRAND MODS_TWO_HAND_MACE_GRAND

Show #.strict STRICTNESS_LENIENT
    Rarity == Magic
    #.import STYLE | weapon > magic -> t3
    #.multi
        Class == "Two Hand Maces"
        HasExplicitMod == MODS_WEAPON_GRAND MODS_TWO_HAND_MACE_GRAND
    #.multi
        Class == "Two Hand Maces"
        HasExplicitMod ==2 MODS_WEAPON_GREATER MODS_TWO_HAND_MACE_GREATER
    #.multi
        BaseType == BASES_TWO_HAND_MACE_BEST
        HasExplicitMod == MODS_WEAPON_GREATER MODS_TWO_HAND_MACE_GREATER

Show #.strict STRICTNESS_BASE
    Rarity == Magic
    #.import STYLE | weapon > magic -> t3
    #.multi
        Class == "Two Hand Maces"
        HasExplicitMod == MODS_WEAPON_GREATER MODS_TWO_HAND_MACE_GREATER
    #.multi
        Class == "Two Hand Maces"
        HasExplicitMod ==2 MODS_WEAPON_LESSER MODS_TWO_HAND_MACE_LESSER
    #.multi
        BaseType == BASES_TWO_HAND_MACE_BEST
        HasExplicitMod == MODS_WEAPON_LESSER MODS_TWO_HAND_MACE_LESSER

# Fractured

Show
    BaseType == BASES_TWO_HAND_MACE_BEST
    FracturedItem True
    HasExplicitMod == MODS_WEAPON_GRAND MODS_TWO_HAND_MACE_GRAND
    ItemLevel >= ITEM_LEVEL_WEAPON_BEST
    #.import _util -> multi_t1_rare
    #.import _util -> multi_t1_magic

Show
    BaseType == BASES_TWO_HAND_MACE_BEST
    FracturedItem True
    HasExplicitMod == MODS_WEAPON_GRAND MODS_TWO_HAND_MACE_GRAND
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

Show #.strict STRICTNESS_STRICT .if Show
    BaseType == BASES_TWO_HAND_MACE_BEST
    FracturedItem True
    ItemLevel >= ITEM_LEVEL_WEAPON_BEST
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

