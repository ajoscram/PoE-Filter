#.subsection Bow

#.alias BASES_BOW_EXCEPTIONAL    = "Solarine Bow"
#.alias BASES_BOW_BEST           = "Maraketh Bow" "Harbinger Bow" "Imperial Bow" "Spine Bow" "Assassin Bow" "Ranger Bow" "Citadel Bow"

#.alias MODS_BOW_EXCEPTIONAL     = "Topotante's" "Tacati's" "of Many" "of Tacati" "of Infamy"
#.alias MODS_BOW_GRAND           = "Sharpshooter's" "of Acclaim" "of the Gale" "of Splintering" "of Lioneye"
#.alias MODS_BOW_GREATER         = "Paragon's" "Fletcher's" "of Renown" "of the Zephyr" "of the Ranger"
#.alias MODS_BOW_LESSER          = "of Mastery" "of Propulsion" "of the Marksman" "of the Remora"

# Unique

Show #.econ uni 100
    BaseType == "Imperial Bow" "Spine Bow"
    Class == "Bows" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    LinkedSockets < 5 #.format
    #.import STYLE | weapon > unique -> t1

Show #.econ uni 10 100
    BaseType == "Maraketh Bow" "Assassin Bow" "Crude Bow" "Imperial Bow" "Steelwood Bow"
    Class == "Bows" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    LinkedSockets < 5 #.format
    #.import STYLE | weapon > unique -> t2

Show #.econ uni 1 10 .strict STRICTNESS_STRICT .if Show
    BaseType == "Recurve Bow" "Royal Bow" "Citadel Bow" "Short Bow" "Death Bow" "Crude Bow" "Harbinger Bow" "Ranger Bow" "Spine Bow" "Long Bow"
    Class == "Bows" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    LinkedSockets < 5 #.format
    #.import STYLE | weapon > unique -> t3

# Exceptional Mods

Show
    BaseType == BASES_BOW_BEST
    HasExplicitMod == MODS_WEAPON_EXCEPTIONAL MODS_BOW_EXCEPTIONAL
    #.import _util -> multi_t1_rare
    #.import _util -> multi_t1_magic

Show
    Class == "Bows"
    HasExplicitMod == MODS_WEAPON_EXCEPTIONAL MODS_BOW_EXCEPTIONAL
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

# Rare

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t1
    #.multi
        Class == "Bows"
        HasExplicitMod ==6 MODS_WEAPON_GRAND MODS_BOW_GRAND
    #.multi
        BaseType == BASES_BOW_BEST
        HasExplicitMod >=5 MODS_WEAPON_GRAND MODS_BOW_GRAND

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == "Bows"
        HasExplicitMod >=5 MODS_WEAPON_GRAND MODS_BOW_GRAND
    #.multi
        BaseType == BASES_BOW_BEST
        HasExplicitMod >=4 MODS_WEAPON_GRAND MODS_BOW_GRAND

Show #.strict STRICTNESS_STRICT
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == "Bows"
        HasExplicitMod >=3 MODS_WEAPON_GRAND MODS_BOW_GRAND
    #.multi
        BaseType == BASES_BOW_BEST
        HasExplicitMod >=2 MODS_WEAPON_GRAND MODS_BOW_GRAND

Show #.strict STRICTNESS_LENIENT
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == "Bows"
        HasExplicitMod >=3 MODS_WEAPON_GREATER MODS_BOW_GREATER MODS_WEAPON_GRAND MODS_BOW_GRAND
    #.multi
        BaseType == BASES_BOW_BEST
        HasExplicitMod >=2 MODS_WEAPON_GREATER MODS_BOW_GREATER MODS_WEAPON_GRAND MODS_BOW_GRAND

Show #.strict STRICTNESS_BASE
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == "Bows"
        HasExplicitMod >=3 MODS_WEAPON_LESSER MODS_BOW_LESSER MODS_WEAPON_GREATER MODS_BOW_GREATER MODS_WEAPON_GRAND MODS_BOW_GRAND
    #.multi
        BaseType == BASES_BOW_BEST
        HasExplicitMod >=2 MODS_WEAPON_LESSER MODS_BOW_LESSER MODS_WEAPON_GREATER MODS_BOW_GREATER MODS_WEAPON_GRAND MODS_BOW_GRAND

# Magic

Show
    BaseType == BASES_BOW_BEST
    Rarity == Magic
    HasExplicitMod ==2 MODS_WEAPON_GRAND MODS_BOW_GRAND
    #.import STYLE | weapon > magic -> t2

Show #.strict STRICTNESS_STRICT
    Rarity == Magic
    #.import STYLE | weapon > magic -> t2
    #.multi
        Class == "Bows"
        HasExplicitMod ==2 MODS_WEAPON_GRAND MODS_BOW_GRAND
    #.multi
        BaseType == BASES_BOW_BEST
        HasExplicitMod == MODS_WEAPON_GRAND MODS_BOW_GRAND

Show #.strict STRICTNESS_LENIENT
    Rarity == Magic
    #.import STYLE | weapon > magic -> t3
    #.multi
        Class == "Bows"
        HasExplicitMod == MODS_WEAPON_GRAND MODS_BOW_GRAND
    #.multi
        Class == "Bows"
        HasExplicitMod ==2 MODS_WEAPON_GREATER MODS_BOW_GREATER
    #.multi
        BaseType == BASES_BOW_BEST
        HasExplicitMod == MODS_WEAPON_GREATER MODS_BOW_GREATER

Show #.strict STRICTNESS_BASE
    Rarity == Magic
    #.import STYLE | weapon > magic -> t3
    #.multi
        Class == "Bows"
        HasExplicitMod == MODS_WEAPON_GREATER MODS_BOW_GREATER
    #.multi
        Class == "Bows"
        HasExplicitMod ==2 MODS_WEAPON_LESSER MODS_BOW_LESSER
    #.multi
        BaseType == BASES_BOW_BEST
        HasExplicitMod == MODS_WEAPON_LESSER MODS_BOW_LESSER

# Fractured

Show
    BaseType == BASES_BOW_BEST
    FracturedItem True
    HasExplicitMod == MODS_WEAPON_GRAND MODS_BOW_GRAND
    ItemLevel >= ITEM_LEVEL_WEAPON_BEST
    #.import _util -> multi_t1_rare
    #.import _util -> multi_t1_magic

Show
    BaseType == BASES_BOW_BEST
    FracturedItem True
    HasExplicitMod == MODS_WEAPON_GRAND MODS_BOW_GRAND
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

Show #.strict STRICTNESS_STRICT .if Show
    BaseType == BASES_BOW_BEST
    FracturedItem True
    ItemLevel >= ITEM_LEVEL_WEAPON_BEST
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

Show #.strict STRICTNESS_LENIENT .if Show
    BaseType == BASES_BOW_BEST
    FracturedItem True
    #.import _util -> multi_t3_rare
    #.import _util -> multi_t3_magic

# Synthesized

Show
    BaseType == BASES_BOW_BEST
    SynthesisedItem True
    ItemLevel >= ITEM_LEVEL_WEAPON_BEST
    #.import _util -> multi_t1

Show
    BaseType == BASES_BOW_BEST
    SynthesisedItem True
    #.import _util -> multi_t2

# Influenced

Show #.strict STRICTNESS_STRICT .if Show
    BaseType == BASES_BOW_BEST
    HasInfluence Shaper Elder Crusader Hunter Redeemer Warlord
    ItemLevel >= ITEM_LEVEL_WEAPON_BEST
    #.import _util -> multi_t2

Show #.strict STRICTNESS_LENIENT .if Show
    BaseType == BASES_BOW_BEST
    HasInfluence Shaper Elder Crusader Hunter Redeemer Warlord
    #.import _util -> multi_t3

# Memory Strands

Show
    BaseType == BASES_BOW_BEST
    ItemLevel >= ITEM_LEVEL_WEAPON_BEST
    MemoryStrands == 100
    #.import _util -> multi_t1

Show
    BaseType == BASES_BOW_BEST
    ItemLevel >= ITEM_LEVEL_WEAPON_BEST
    MemoryStrands >= 50
    #.import _util -> multi_t2

Show
    BaseType == BASES_BOW_BEST
    MemoryStrands == 100
    #.import _util -> multi_t2

Show #.strict STRICTNESS_STRICT .if Show
    BaseType == BASES_BOW_BEST
    MemoryStrands >= 50
    #.import _util -> multi_t3

# High Quality

Show
    BaseType == BASES_BOW_BEST
    ItemLevel >= ITEM_LEVEL_WEAPON_BEST
    Quality == 30
    #.import _util -> multi_t1

Show
    BaseType == BASES_BOW_BEST
    Quality == 30
    #.import _util -> multi_t2

Show
    BaseType == BASES_BOW_BEST
    ItemLevel >= ITEM_LEVEL_WEAPON_BEST
    Quality > 25
    #.import _util -> multi_t3

Show #.strict STRICTNESS_STRICT .if Show
    BaseType == BASES_BOW_BEST
    Quality > 25
    #.import _util -> multi_t3

# Exceptional Base

Show
    BaseType == BASES_BOW_EXCEPTIONAL
    ItemLevel >= ITEM_LEVEL_WEAPON_BEST
    #.import _util -> multi_t1

Show
    BaseType == BASES_BOW_EXCEPTIONAL
    #.import _util -> multi_t2

# Best Base

Show #.strict STRICTNESS_STRICT .if Show
    BaseType == BASES_BOW_BEST
    ItemLevel >= ITEM_LEVEL_WEAPON_BEST
    #.import < _util -> craftable
    #.import _util -> multi_t3

Show #.strict STRICTNESS_BASE .if Show
    BaseType == BASES_BOW_BEST
    #.import < _util -> craftable