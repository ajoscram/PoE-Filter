#.subsection Two-hand Sword

#.alias BASES_TWO_HAND_SWORD_EXCEPTIONAL = "Banishing Blade"
#.alias BASES_TWO_HAND_SWORD_BEST        = "Exquisite Blade" "Infernal Sword" "Lion Sword" "Vaal Greatsword" "Ezomyte Blade" "Reaver Sword"

#.alias MODS_TWO_HAND_SWORD_EXCEPTIONAL = "Topotante's" "Tacati's" "of Tacati"
#.alias MODS_TWO_HAND_SWORD_GRAND       = "of the Gods" "of the Wind" "of Celebration" "of the Ranger"
#.alias MODS_TWO_HAND_SWORD_GREATER     = "Paragon's" "Weaponmaster's" "of the Titan" "of the Phantom" "of Infamy" "of the Marksman"
#.alias MODS_TWO_HAND_SWORD_LESSER      = "Combatant's" "of the Leviathan" "of the Jaguar" "of Fame" "of the Sniper"

# Unique

Show #.econ uni 100
    BaseType == "Infernal Sword" "Engraved Greatsword" "Lion Sword"
    Class == "Two Hand Swords" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    LinkedSockets < 5 #.format
    #.import STYLE | weapon > unique -> t1

Show #.econ uni 10 100
    BaseType == "Infernal Sword"
    Class == "Two Hand Swords" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    LinkedSockets < 5 #.format
    #.import STYLE | weapon > unique -> t2

Show #.econ uni 1 10 .strict STRICTNESS_STRICT .if Show
    BaseType == "Reaver Sword" "Highland Blade" "Etched Greatsword" "Lion Sword" "Bastard Sword" "Tiger Sword" "Ezomyte Blade" "Ornate Sword" "Infernal Sword"
    Class == "Two Hand Swords" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    LinkedSockets < 5 #.format
    #.import STYLE | weapon > unique -> t3

#.import template > _main { CLASS = "Two Hand Swords", BASES_BEST = BASES_TWO_HAND_SWORD_BEST, BASES_EXCEPTIONAL = BASES_TWO_HAND_SWORD_EXCEPTIONAL, MODS_EXCEPTIONAL = MODS_TWO_HAND_SWORD_EXCEPTIONAL, MODS_GRAND = MODS_TWO_HAND_SWORD_GRAND, MODS_GREATER = MODS_TWO_HAND_SWORD_GREATER, MODS_LESSER = MODS_TWO_HAND_SWORD_LESSER