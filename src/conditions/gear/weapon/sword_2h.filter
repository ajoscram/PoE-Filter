#.subsection Two-hand Sword

#.alias BASES_TWO_HAND_SWORD_EXCEPTIONAL    = "Banishing Blade"
#.alias BASES_TWO_HAND_SWORD_BEST           = "Exquisite Blade" "Infernal Sword" "Lion Sword" "Vaal Greatsword" "Ezomyte Blade" "Reaver Sword"

#.alias MODS_TWO_HAND_SWORD_EXCEPTIONAL     = "Topotante's" "Tacati's" "of Tacati"
#.alias MODS_TWO_HAND_SWORD_GRAND           = "of the Gods" "of the Wind" "of Celebration" "of the Ranger"
#.alias MODS_TWO_HAND_SWORD_GREATER         = "Paragon's" "Weaponmaster's" "of the Titan" "of the Phantom" "of Infamy" "of the Marksman"
#.alias MODS_TWO_HAND_SWORD_LESSER          = "Combatant's" "of the Leviathan" "of the Jaguar" "of Fame" "of the Sniper"

# Unique

Show #.econ uni 100
    BaseType == "Engraved Greatsword" "Lion Sword" "Infernal Sword"
    Class == "Two Hand Swords" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    LinkedSockets < 5 #.format
    #.import STYLE | weapon > unique -> t1

Show #.econ uni 10 100
    BaseType == "Exquisite Blade"
    Class == "Two Hand Swords" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    LinkedSockets < 5 #.format
    #.import STYLE | weapon > unique -> t2

Show #.econ uni 1 10 .strict STRICTNESS_STRICT .if Show
    BaseType == "Ornate Sword" "Lion Sword" "Infernal Sword" "Etched Greatsword" "Reaver Sword" "Ezomyte Blade" "Tiger Sword"
    Class == "Two Hand Swords" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    LinkedSockets < 5 #.format
    #.import STYLE | weapon > unique -> t3

# Exceptional Mods

Show
    BaseType == BASES_TWO_HAND_SWORD_BEST
    HasExplicitMod == MODS_WEAPON_EXCEPTIONAL MODS_TWO_HAND_SWORD_EXCEPTIONAL
    #.import _util -> multi_t1_rare
    #.import _util -> multi_t1_magic

Show
    Class == "Two Hand Swords"
    HasExplicitMod == MODS_WEAPON_EXCEPTIONAL MODS_TWO_HAND_SWORD_EXCEPTIONAL
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

# Rare

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t1
    #.multi
        Class == "Two Hand Swords"
        HasExplicitMod ==6 MODS_WEAPON_GRAND MODS_TWO_HAND_SWORD_GRAND
    #.multi
        BaseType == BASES_TWO_HAND_SWORD_BEST
        HasExplicitMod >=5 MODS_WEAPON_GRAND MODS_TWO_HAND_SWORD_GRAND

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == "Two Hand Swords"
        HasExplicitMod >=5 MODS_WEAPON_GRAND MODS_TWO_HAND_SWORD_GRAND
    #.multi
        BaseType == BASES_TWO_HAND_SWORD_BEST
        HasExplicitMod >=4 MODS_WEAPON_GRAND MODS_TWO_HAND_SWORD_GRAND

Show #.strict STRICTNESS_STRICT
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == "Two Hand Swords"
        HasExplicitMod >=3 MODS_WEAPON_GRAND MODS_TWO_HAND_SWORD_GRAND
    #.multi
        BaseType == BASES_TWO_HAND_SWORD_BEST
        HasExplicitMod >=2 MODS_WEAPON_GRAND MODS_TWO_HAND_SWORD_GRAND

Show #.strict STRICTNESS_LENIENT
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == "Two Hand Swords"
        HasExplicitMod >=3 MODS_WEAPON_GREATER MODS_TWO_HAND_SWORD_GREATER MODS_WEAPON_GRAND MODS_TWO_HAND_SWORD_GRAND
    #.multi
        BaseType == BASES_TWO_HAND_SWORD_BEST
        HasExplicitMod >=2 MODS_WEAPON_GREATER MODS_TWO_HAND_SWORD_GREATER MODS_WEAPON_GRAND MODS_TWO_HAND_SWORD_GRAND

Show #.strict STRICTNESS_BASE
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == "Two Hand Swords"
        HasExplicitMod >=3 MODS_WEAPON_LESSER MODS_TWO_HAND_SWORD_LESSER MODS_WEAPON_GREATER MODS_TWO_HAND_SWORD_GREATER MODS_WEAPON_GRAND MODS_TWO_HAND_SWORD_GRAND
    #.multi
        BaseType == BASES_TWO_HAND_SWORD_BEST
        HasExplicitMod >=2 MODS_WEAPON_LESSER MODS_TWO_HAND_SWORD_LESSER MODS_WEAPON_GREATER MODS_TWO_HAND_SWORD_GREATER MODS_WEAPON_GRAND MODS_TWO_HAND_SWORD_GRAND

# Magic

Show
    BaseType == BASES_TWO_HAND_SWORD_BEST
    Rarity == Magic
    HasExplicitMod ==2 MODS_WEAPON_GRAND MODS_TWO_HAND_SWORD_GRAND
    #.import STYLE | weapon > magic -> t2

Show #.strict STRICTNESS_STRICT
    Rarity == Magic
    #.import STYLE | weapon > magic -> t2
    #.multi
        Class == "Two Hand Swords"
        HasExplicitMod ==2 MODS_WEAPON_GRAND MODS_TWO_HAND_SWORD_GRAND
    #.multi
        BaseType == BASES_TWO_HAND_SWORD_BEST
        HasExplicitMod == MODS_WEAPON_GRAND MODS_TWO_HAND_SWORD_GRAND

Show #.strict STRICTNESS_LENIENT
    Rarity == Magic
    #.import STYLE | weapon > magic -> t3
    #.multi
        Class == "Two Hand Swords"
        HasExplicitMod == MODS_WEAPON_GRAND MODS_TWO_HAND_SWORD_GRAND
    #.multi
        Class == "Two Hand Swords"
        HasExplicitMod ==2 MODS_WEAPON_GREATER MODS_TWO_HAND_SWORD_GREATER
    #.multi
        BaseType == BASES_TWO_HAND_SWORD_BEST
        HasExplicitMod == MODS_WEAPON_GREATER MODS_TWO_HAND_SWORD_GREATER

Show #.strict STRICTNESS_BASE
    Rarity == Magic
    #.import STYLE | weapon > magic -> t3
    #.multi
        Class == "Two Hand Swords"
        HasExplicitMod == MODS_WEAPON_GREATER MODS_TWO_HAND_SWORD_GREATER
    #.multi
        Class == "Two Hand Swords"
        HasExplicitMod ==2 MODS_WEAPON_LESSER MODS_TWO_HAND_SWORD_LESSER
    #.multi
        BaseType == BASES_TWO_HAND_SWORD_BEST
        HasExplicitMod == MODS_WEAPON_LESSER MODS_TWO_HAND_SWORD_LESSER

