# Rare

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t1
    #.multi
        Class == CLASS
        HasExplicitMod ==6 MODS_WEAPON_GRAND MODS_GRAND
    #.multi
        BaseType == BASES_BEST
        HasExplicitMod >=5 MODS_WEAPON_GRAND MODS_GRAND

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == CLASS
        HasExplicitMod >=5 MODS_WEAPON_GRAND MODS_GRAND
    #.multi
        BaseType == BASES_BEST
        HasExplicitMod >=4 MODS_WEAPON_GRAND MODS_GRAND

Show #.strict STRICTNESS_STRICT .if Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == CLASS
        HasExplicitMod >=3 MODS_WEAPON_GRAND MODS_GRAND
    #.multi
        BaseType == BASES_BEST
        HasExplicitMod >=2 MODS_WEAPON_GRAND MODS_GRAND

Show #.strict STRICTNESS_LENIENT .if Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == CLASS
        HasExplicitMod >=3 MODS_WEAPON_GREATER MODS_GREATER MODS_WEAPON_GRAND MODS_GRAND
    #.multi
        BaseType == BASES_BEST
        HasExplicitMod >=2 MODS_WEAPON_GREATER MODS_GREATER MODS_WEAPON_GRAND MODS_GRAND

Show #.strict STRICTNESS_BASE .if Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == CLASS
        HasExplicitMod >=3 MODS_WEAPON_LESSER MODS_LESSER MODS_WEAPON_GREATER MODS_GREATER MODS_WEAPON_GRAND MODS_GRAND
    #.multi
        BaseType == BASES_BEST
        HasExplicitMod >=2 MODS_WEAPON_LESSER MODS_LESSER MODS_WEAPON_GREATER MODS_GREATER MODS_WEAPON_GRAND MODS_GRAND
