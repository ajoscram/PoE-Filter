# Magic

Show
    BaseType == BASES_BEST
    Rarity == Magic
    HasExplicitMod ==2 MODS_WEAPON_GRAND MODS_GRAND
    #.import STYLE | weapon > magic -> t2

Show #.strict STRICTNESS_STRICT
    Rarity == Magic
    #.import STYLE | weapon > magic -> t2
    #.multi
        Class == CLASS
        HasExplicitMod ==2 MODS_WEAPON_GRAND MODS_GRAND
    #.multi
        BaseType == BASES_BEST
        HasExplicitMod == MODS_WEAPON_GRAND MODS_GRAND

Show #.strict STRICTNESS_LENIENT
    Rarity == Magic
    #.import STYLE | weapon > magic -> t3
    #.multi
        Class == CLASS
        HasExplicitMod == MODS_WEAPON_GRAND MODS_GRAND
    #.multi
        Class == CLASS
        HasExplicitMod ==2 MODS_WEAPON_GREATER MODS_GREATER
    #.multi
        BaseType == BASES_BEST
        HasExplicitMod == MODS_WEAPON_GREATER MODS_GREATER

Show #.strict STRICTNESS_BASE
    Rarity == Magic
    #.import STYLE | weapon > magic -> t3
    #.multi
        Class == CLASS
        HasExplicitMod == MODS_WEAPON_GREATER MODS_GREATER
    #.multi
        Class == CLASS
        HasExplicitMod ==2 MODS_WEAPON_LESSER MODS_LESSER
    #.multi
        BaseType == BASES_BEST
        HasExplicitMod == MODS_WEAPON_LESSER MODS_LESSER
