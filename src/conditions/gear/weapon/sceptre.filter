#.subsection Sceptre

#.alias BASES_SCEPTRE_EXCEPTIONAL    = "Alternating Sceptre" "Stabilising Sceptre" "Oscillating Sceptre"
#.alias BASES_SCEPTRE_BEST           = "Opal Sceptre" "Carnal Sceptre" "Sambar Sceptre" "Vaal Sceptre" "Void Sceptre"

#.alias MODS_SCEPTRE_EXCEPTIONAL     = "Topotante's" "Matatl's" "Tacati's" "Citaqualotl's" "Esh's" "Ionising" "Tul's" "Cryomancer's" "Xoph's" "Pyroclastic" "Runic" "Glyphic" "Lich's" "Magister's" "of the Fanatical" "of the Zealous" "of Heartstopping" "of the Gelid" "of Tacati" "of Matatl" "of Citaqualotl"
#.alias MODS_SCEPTRE_GRAND           = "Zaffre" "Smiting" "Crystalline" "Magmatic" "Incanter's" "Archmage's" "Lithomancer's" "Thunderhand's" "Frost Singer's" "Flame Shaper's" "Electrocuting" "Entombing" "Cremating" "of the Gods" "of the Genius" "of Finesse" "of Celebration" "of Unmaking" "of the Ranger" "of the Ardent" "of the Boreal"
#.alias MODS_SCEPTRE_GREATER         = "Blue" "Striking" "Crystalline" "Volcanic" "Occultist's" "Mage's" "Weaponmaster's" "Discharging" "Polar" "Blasting" "of the Titan" "of the Virtuoso" "of Sortilege" "of Infamy" "of Ruin" "of Ashes" "of Glaciation" "of Arcing" "of the Marksman" "of Conflagration" "of the Fervid" "of the Bleak"
#.alias MODS_SCEPTRE_LESSER          = "Mazarine" "Coursing" "Snowy" "Cauterising" "Professor's" "Warlock's" "Combatant's" "Shocking" "Glaciated" "Incinerating" "of the Leviathan" "of the Savant" "of Prestidigitation" "of Fame" "of Calamity" "of Immolation" "of Floe" "of Discharge" "of the Sniper" "of Combustion" "of the Earnest" "of the Inclement"

# Unique

Show #.econ uni 100
    BaseType == "Void Sceptre"
    Class == "Sceptres" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t1

Show #.econ uni 10 100
    BaseType == "Shadow Sceptre" "Karui Sceptre" "Platinum Sceptre" "Vaal Sceptre"
    Class == "Sceptres" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t2

Show #.econ uni 1 10 .strict STRICTNESS_STRICT .if Show
    BaseType == "Shadow Sceptre" "Bronze Sceptre" "Tyrant's Sekhem" "Platinum Sceptre" "Vaal Sceptre" "Royal Sceptre" "Void Sceptre" "Blood Sceptre" "Grinning Fetish" "Ritual Sceptre" "Crystal Sceptre"
    Class == "Sceptres" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t3

# Exceptional Mods

Show
    BaseType == BASES_SCEPTRE_BEST
    HasExplicitMod == MODS_WEAPON_EXCEPTIONAL MODS_SCEPTRE_EXCEPTIONAL
    #.import _util -> multi_t1_rare
    #.import _util -> multi_t1_magic

Show
    Class == "Sceptres"
    HasExplicitMod == MODS_WEAPON_EXCEPTIONAL MODS_SCEPTRE_EXCEPTIONAL
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

# Rare

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t1
    #.multi
        Class == "Sceptres"
        HasExplicitMod ==6 MODS_WEAPON_GRAND MODS_SCEPTRE_GRAND
    #.multi
        BaseType == BASES_SCEPTRE_BEST
        HasExplicitMod >=5 MODS_WEAPON_GRAND MODS_SCEPTRE_GRAND

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == "Sceptres"
        HasExplicitMod >=5 MODS_WEAPON_GRAND MODS_SCEPTRE_GRAND
    #.multi
        BaseType == BASES_SCEPTRE_BEST
        HasExplicitMod >=4 MODS_WEAPON_GRAND MODS_SCEPTRE_GRAND

Show #.strict STRICTNESS_STRICT
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == "Sceptres"
        HasExplicitMod >=3 MODS_WEAPON_GRAND MODS_SCEPTRE_GRAND
    #.multi
        BaseType == BASES_SCEPTRE_BEST
        HasExplicitMod >=2 MODS_WEAPON_GRAND MODS_SCEPTRE_GRAND

Show #.strict STRICTNESS_LENIENT
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == "Sceptres"
        HasExplicitMod >=3 MODS_WEAPON_GREATER MODS_SCEPTRE_GREATER MODS_WEAPON_GRAND MODS_SCEPTRE_GRAND
    #.multi
        BaseType == BASES_SCEPTRE_BEST
        HasExplicitMod >=2 MODS_WEAPON_GREATER MODS_SCEPTRE_GREATER MODS_WEAPON_GRAND MODS_SCEPTRE_GRAND

Show #.strict STRICTNESS_BASE
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == "Sceptres"
        HasExplicitMod >=3 MODS_WEAPON_LESSER MODS_SCEPTRE_LESSER MODS_WEAPON_GREATER MODS_SCEPTRE_GREATER MODS_WEAPON_GRAND MODS_SCEPTRE_GRAND
    #.multi
        BaseType == BASES_SCEPTRE_BEST
        HasExplicitMod >=2 MODS_WEAPON_LESSER MODS_SCEPTRE_LESSER MODS_WEAPON_GREATER MODS_SCEPTRE_GREATER MODS_WEAPON_GRAND MODS_SCEPTRE_GRAND

# Magic

Show
    BaseType == BASES_SCEPTRE_BEST
    Rarity == Magic
    HasExplicitMod ==2 MODS_WEAPON_GRAND MODS_SCEPTRE_GRAND
    #.import STYLE | weapon > magic -> t2

Show #.strict STRICTNESS_STRICT
    Rarity == Magic
    #.import STYLE | weapon > magic -> t2
    #.multi
        Class == "Sceptres"
        HasExplicitMod ==2 MODS_WEAPON_GRAND MODS_SCEPTRE_GRAND
    #.multi
        BaseType == BASES_SCEPTRE_BEST
        HasExplicitMod == MODS_WEAPON_GRAND MODS_SCEPTRE_GRAND

Show #.strict STRICTNESS_LENIENT
    Rarity == Magic
    #.import STYLE | weapon > magic -> t3
    #.multi
        Class == "Sceptres"
        HasExplicitMod == MODS_WEAPON_GRAND MODS_SCEPTRE_GRAND
    #.multi
        Class == "Sceptres"
        HasExplicitMod ==2 MODS_WEAPON_GREATER MODS_SCEPTRE_GREATER
    #.multi
        BaseType == BASES_SCEPTRE_BEST
        HasExplicitMod == MODS_WEAPON_GREATER MODS_SCEPTRE_GREATER

Show #.strict STRICTNESS_BASE
    Rarity == Magic
    #.import STYLE | weapon > magic -> t3
    #.multi
        Class == "Sceptres"
        HasExplicitMod == MODS_WEAPON_GREATER MODS_SCEPTRE_GREATER
    #.multi
        Class == "Sceptres"
        HasExplicitMod ==2 MODS_WEAPON_LESSER MODS_SCEPTRE_LESSER
    #.multi
        BaseType == BASES_SCEPTRE_BEST
        HasExplicitMod == MODS_WEAPON_LESSER MODS_SCEPTRE_LESSER

