#.subsection Dagger

#.alias BASES_DAGGER_EXCEPTIONAL    = "Pneumatic Dagger" "Pressurised Dagger"
#.alias BASES_DAGGER_BEST           = "Gutting Knife" "Ambusher" "Sai"

#.alias MODS_DAGGER_EXCEPTIONAL     = "Topotante's" "Tacati's" "Matatl's" "of Tacati" "of Matatl" "of Disintegrating"
#.alias MODS_DAGGER_GRAND           = "Zaffre" "Anarchist's" "Tempest King's" "Winterbringer's" "Lava Caller's" "of the Wind" "of the Genius" "of Celebration" "of the Ranger" "of Atrophying"
#.alias MODS_DAGGER_GREATER         = "Blue" "Paragon's" "Weaponmaster's" "Nihilist's" "Thunder Lord's" "Frost Weaver's" "Flame Spinner's" "of the Phantom" "of the Virtuoso" "of Infamy" "of the Marksman" "of Deteriorating"
#.alias MODS_DAGGER_LESSER          = "Mazarine" "Combatant's" "of the Jaguar" "of the Savant" "of Fame" "of the Sniper" "of Wasting"

# Unique

Show #.econ uni 100
    BaseType == "Ambusher"
    Class == "Daggers" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t1

Show #.econ uni 10 100
    BaseType == "Ambusher"
    Class == "Daggers" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t2

Show #.econ uni 1 10 .strict STRICTNESS_STRICT .if Show
    BaseType == "Ambusher"
    Class == "Daggers" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t3

# Exceptional Mods

Show
    BaseType == BASES_DAGGER_BEST
    HasExplicitMod == MODS_WEAPON_EXCEPTIONAL MODS_DAGGER_EXCEPTIONAL
    #.import _util -> multi_t1_rare
    #.import _util -> multi_t1_magic

Show
    Class == "Daggers"
    HasExplicitMod == MODS_WEAPON_EXCEPTIONAL MODS_DAGGER_EXCEPTIONAL
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

# Rare

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t1
    #.multi
        Class == "Daggers"
        HasExplicitMod ==6 MODS_WEAPON_GRAND MODS_DAGGER_GRAND
    #.multi
        BaseType == BASES_DAGGER_BEST
        HasExplicitMod >=5 MODS_WEAPON_GRAND MODS_DAGGER_GRAND

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == "Daggers"
        HasExplicitMod >=5 MODS_WEAPON_GRAND MODS_DAGGER_GRAND
    #.multi
        BaseType == BASES_DAGGER_BEST
        HasExplicitMod >=4 MODS_WEAPON_GRAND MODS_DAGGER_GRAND

Show #.strict STRICTNESS_STRICT
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == "Daggers"
        HasExplicitMod >=3 MODS_WEAPON_GRAND MODS_DAGGER_GRAND
    #.multi
        BaseType == BASES_DAGGER_BEST
        HasExplicitMod >=2 MODS_WEAPON_GRAND MODS_DAGGER_GRAND

Show #.strict STRICTNESS_LENIENT
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == "Daggers"
        HasExplicitMod >=3 MODS_WEAPON_GREATER MODS_DAGGER_GREATER MODS_WEAPON_GRAND MODS_DAGGER_GRAND
    #.multi
        BaseType == BASES_DAGGER_BEST
        HasExplicitMod >=2 MODS_WEAPON_GREATER MODS_DAGGER_GREATER MODS_WEAPON_GRAND MODS_DAGGER_GRAND

Show #.strict STRICTNESS_BASE
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == "Daggers"
        HasExplicitMod >=3 MODS_WEAPON_LESSER MODS_DAGGER_LESSER MODS_WEAPON_GREATER MODS_DAGGER_GREATER MODS_WEAPON_GRAND MODS_DAGGER_GRAND
    #.multi
        BaseType == BASES_DAGGER_BEST
        HasExplicitMod >=2 MODS_WEAPON_LESSER MODS_DAGGER_LESSER MODS_WEAPON_GREATER MODS_DAGGER_GREATER MODS_WEAPON_GRAND MODS_DAGGER_GRAND

# Magic

Show
    BaseType == BASES_DAGGER_BEST
    Rarity == Magic
    HasExplicitMod ==2 MODS_WEAPON_GRAND MODS_DAGGER_GRAND
    #.import STYLE | weapon > magic -> t2

Show #.strict STRICTNESS_STRICT
    Rarity == Magic
    #.import STYLE | weapon > magic -> t2
    #.multi
        Class == "Daggers"
        HasExplicitMod ==2 MODS_WEAPON_GRAND MODS_DAGGER_GRAND
    #.multi
        BaseType == BASES_DAGGER_BEST
        HasExplicitMod == MODS_WEAPON_GRAND MODS_DAGGER_GRAND

Show #.strict STRICTNESS_LENIENT
    Rarity == Magic
    #.import STYLE | weapon > magic -> t3
    #.multi
        Class == "Daggers"
        HasExplicitMod == MODS_WEAPON_GRAND MODS_DAGGER_GRAND
    #.multi
        Class == "Daggers"
        HasExplicitMod ==2 MODS_WEAPON_GREATER MODS_DAGGER_GREATER
    #.multi
        BaseType == BASES_DAGGER_BEST
        HasExplicitMod == MODS_WEAPON_GREATER MODS_DAGGER_GREATER

Show #.strict STRICTNESS_BASE
    Rarity == Magic
    #.import STYLE | weapon > magic -> t3
    #.multi
        Class == "Daggers"
        HasExplicitMod == MODS_WEAPON_GREATER MODS_DAGGER_GREATER
    #.multi
        Class == "Daggers"
        HasExplicitMod ==2 MODS_WEAPON_LESSER MODS_DAGGER_LESSER
    #.multi
        BaseType == BASES_DAGGER_BEST
        HasExplicitMod == MODS_WEAPON_LESSER MODS_DAGGER_LESSER

# Fractured

Show
    BaseType == BASES_DAGGER_BEST
    FracturedItem True
    HasExplicitMod == MODS_WEAPON_GRAND MODS_DAGGER_GRAND
    ItemLevel >= ITEM_LEVEL_WEAPON_BEST
    #.import _util -> multi_t1_rare
    #.import _util -> multi_t1_magic

Show
    BaseType == BASES_DAGGER_BEST
    FracturedItem True
    HasExplicitMod == MODS_WEAPON_GRAND MODS_DAGGER_GRAND
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

Show #.strict STRICTNESS_STRICT .if Show
    BaseType == BASES_DAGGER_BEST
    FracturedItem True
    ItemLevel >= ITEM_LEVEL_WEAPON_BEST
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

Show #.strict STRICTNESS_LENIENT .if Show
    BaseType == BASES_DAGGER_BEST
    FracturedItem True
    #.import _util -> multi_t3_rare
    #.import _util -> multi_t3_magic

# Synthesized

Show
    BaseType == BASES_DAGGER_BEST
    SynthesisedItem True
    ItemLevel >= ITEM_LEVEL_WEAPON_BEST
    #.import _util -> multi_t1

Show
    BaseType == BASES_DAGGER_BEST
    SynthesisedItem True
    #.import _util -> multi_t2

# Influenced

Show #.strict STRICTNESS_STRICT .if Show
    BaseType == BASES_DAGGER_BEST
    HasInfluence Shaper Elder Crusader Hunter Redeemer Warlord
    ItemLevel >= ITEM_LEVEL_WEAPON_BEST
    #.import _util -> multi_t2

Show #.strict STRICTNESS_LENIENT .if Show
    BaseType == BASES_DAGGER_BEST
    HasInfluence Shaper Elder Crusader Hunter Redeemer Warlord
    #.import _util -> multi_t3

# Memory Strands

Show
    BaseType == BASES_DAGGER_BEST
    ItemLevel >= ITEM_LEVEL_WEAPON_BEST
    MemoryStrands == 100
    #.import _util -> multi_t1

Show
    BaseType == BASES_DAGGER_BEST
    ItemLevel >= ITEM_LEVEL_WEAPON_BEST
    MemoryStrands >= 50
    #.import _util -> multi_t2

Show
    BaseType == BASES_DAGGER_BEST
    MemoryStrands == 100
    #.import _util -> multi_t2

Show #.strict STRICTNESS_STRICT .if Show
    BaseType == BASES_DAGGER_BEST
    MemoryStrands >= 50
    #.import _util -> multi_t3

# High Quality

Show
    BaseType == BASES_DAGGER_BEST
    ItemLevel >= ITEM_LEVEL_WEAPON_BEST
    Quality == 30
    #.import _util -> multi_t1

Show
    BaseType == BASES_DAGGER_BEST
    Quality == 30
    #.import _util -> multi_t2

Show
    BaseType == BASES_DAGGER_BEST
    ItemLevel >= ITEM_LEVEL_WEAPON_BEST
    Quality > 25
    #.import _util -> multi_t3

Show #.strict STRICTNESS_STRICT .if Show
