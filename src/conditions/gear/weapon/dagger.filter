#.subsection Dagger

#.alias DAGGER_EXCEPTIONAL_BASES    = "Pneumatic Dagger" "Pressurised Dagger"
#.alias DAGGER_BEST_BASES           = "Gutting Knife" "Ambusher" "Sai"

#.alias DAGGER_EXCEPTIONAL_MODS     = "Topotante's" "Tacati's" "Matatl's" "of Tacati" "of Matatl" "of Disintegrating"
#.alias DAGGER_GRAND_MODS           = "Zaffre" "Anarchist's" "Tempest King's" "Winterbringer's" "Lava Caller's" "of the Wind" "of the Genius" "of Celebration" "of the Ranger" "of Atrophying"
#.alias DAGGER_GREATER_MODS         = "Blue" "Paragon's" "Weaponmaster's" "Nihilist's" "Thunder Lord's" "Frost Weaver's" "Flame Spinner's" "of the Phantom" "of the Virtuoso" "of Infamy" "of the Marksman" "of Deteriorating"
#.alias DAGGER_LESSER_MODS          = "Mazarine" "Combatant's" "of the Jaguar" "of the Savant" "of Fame" "of the Sniper" "of Wasting"

# Unique

Show #.econ uni 100
    BaseType == "Ambusher"
    Class == "Daggers" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t1

Show #.econ uni 10 100
    BaseType == "Ambusher"
    Class == "Daggers" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t2

Show #.econ uni 1 10 .strict STRICTNESS_STRICT .if Show
    BaseType == "Ambusher"
    Class == "Daggers" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | weapon > unique -> t3

# Exceptional Mods

Show
    BaseType == DAGGER_BEST_BASES
    HasExplicitMod == MODS_WEAPON_EXCEPTIONAL DAGGER_EXCEPTIONAL_MODS
    #.import _util -> multi_t1_rare
    #.import _util -> multi_t1_magic

Show
    Class == "Daggers"
    HasExplicitMod == MODS_WEAPON_EXCEPTIONAL DAGGER_EXCEPTIONAL_MODS
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

# Rare

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t1
    #.multi
        Class == "Daggers"
        HasExplicitMod ==6 MODS_WEAPON_GRAND DAGGER_GRAND_MODS
    #.multi
        BaseType == DAGGER_BEST_BASES
        HasExplicitMod >=5 MODS_WEAPON_GRAND DAGGER_GRAND_MODS

Show
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == "Daggers"
        HasExplicitMod >=5 MODS_WEAPON_GRAND DAGGER_GRAND_MODS
    #.multi
        BaseType == DAGGER_BEST_BASES
        HasExplicitMod >=4 MODS_WEAPON_GRAND DAGGER_GRAND_MODS

Show #.strict STRICTNESS_STRICT
    Rarity == Rare
    #.import STYLE | weapon > rare -> t2
    #.multi
        Class == "Daggers"
        HasExplicitMod >=3 MODS_WEAPON_GRAND DAGGER_GRAND_MODS
    #.multi
        BaseType == DAGGER_BEST_BASES
        HasExplicitMod >=2 MODS_WEAPON_GRAND DAGGER_GRAND_MODS

Show #.strict STRICTNESS_LENIENT
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == "Daggers"
        HasExplicitMod >=3 MODS_WEAPON_GREATER DAGGER_GREATER_MODS MODS_WEAPON_GRAND DAGGER_GRAND_MODS
    #.multi
        BaseType == DAGGER_BEST_BASES
        HasExplicitMod >=2 MODS_WEAPON_GREATER DAGGER_GREATER_MODS MODS_WEAPON_GRAND DAGGER_GRAND_MODS

Show #.strict STRICTNESS_BASE
    Rarity == Rare
    #.import STYLE | weapon > rare -> t3
    #.multi
        Class == "Daggers"
        HasExplicitMod >=3 MODS_WEAPON_LESSER DAGGER_LESSER_MODS MODS_WEAPON_GREATER DAGGER_GREATER_MODS MODS_WEAPON_GRAND DAGGER_GRAND_MODS
    #.multi
        BaseType == DAGGER_BEST_BASES
        HasExplicitMod >=2 MODS_WEAPON_LESSER DAGGER_LESSER_MODS MODS_WEAPON_GREATER DAGGER_GREATER_MODS MODS_WEAPON_GRAND DAGGER_GRAND_MODS

# Magic

Show
    BaseType == DAGGER_BEST_BASES
    Rarity == Magic
    HasExplicitMod ==2 MODS_WEAPON_GRAND DAGGER_GRAND_MODS
    #.import STYLE | weapon > magic -> t2

Show #.strict STRICTNESS_STRICT
    Rarity == Magic
    #.import STYLE | weapon > magic -> t2
    #.multi
        Class == "Daggers"
        HasExplicitMod ==2 MODS_WEAPON_GRAND DAGGER_GRAND_MODS
    #.multi
        BaseType == DAGGER_BEST_BASES
        HasExplicitMod == MODS_WEAPON_GRAND DAGGER_GRAND_MODS

Show #.strict STRICTNESS_LENIENT
    Rarity == Magic
    #.import STYLE | weapon > magic -> t3
    #.multi
        Class == "Daggers"
        HasExplicitMod == MODS_WEAPON_GRAND DAGGER_GRAND_MODS
    #.multi
        Class == "Daggers"
        HasExplicitMod ==2 MODS_WEAPON_GREATER DAGGER_GREATER_MODS
    #.multi
        BaseType == DAGGER_BEST_BASES
        HasExplicitMod == MODS_WEAPON_GREATER DAGGER_GREATER_MODS

Show #.strict STRICTNESS_BASE
    Rarity == Magic
    #.import STYLE | weapon > magic -> t3
    #.multi
        Class == "Daggers"
        HasExplicitMod == MODS_WEAPON_GREATER DAGGER_GREATER_MODS
    #.multi
        Class == "Daggers"
        HasExplicitMod ==2 MODS_WEAPON_LESSER DAGGER_LESSER_MODS
    #.multi
        BaseType == DAGGER_BEST_BASES
        HasExplicitMod == MODS_WEAPON_LESSER DAGGER_LESSER_MODS

# Fractured

Show
    BaseType == DAGGER_BEST_BASES
    FracturedItem True
    HasExplicitMod == MODS_WEAPON_GRAND DAGGER_GRAND_MODS
    ItemLevel >= MODS_WEAPON_BEST_ITEM_LEVEL
    #.import _util -> multi_t1_rare
    #.import _util -> multi_t1_magic

Show
    BaseType == DAGGER_BEST_BASES
    FracturedItem True
    HasExplicitMod == MODS_WEAPON_GRAND DAGGER_GRAND_MODS
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

Show #.strict STRICTNESS_STRICT .if Show
    BaseType == DAGGER_BEST_BASES
    FracturedItem True
    ItemLevel >= MODS_WEAPON_BEST_ITEM_LEVEL
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

Show #.strict STRICTNESS_LENIENT .if Show
    BaseType == DAGGER_BEST_BASES
    FracturedItem True
    #.import _util -> multi_t3_rare
    #.import _util -> multi_t3_magic

# Synthesized

Show
    BaseType == DAGGER_BEST_BASES
    SynthesisedItem True
    ItemLevel >= MODS_WEAPON_BEST_ITEM_LEVEL
    #.import _util -> multi_t1

Show
    BaseType == DAGGER_BEST_BASES
    SynthesisedItem True
    #.import _util -> multi_t2

# Influenced

Show #.strict STRICTNESS_STRICT .if Show
    BaseType == DAGGER_BEST_BASES
    HasInfluence Shaper Elder Crusader Hunter Redeemer Warlord
    ItemLevel >= MODS_WEAPON_BEST_ITEM_LEVEL
    #.import _util -> multi_t2

Show #.strict STRICTNESS_LENIENT .if Show
    BaseType == DAGGER_BEST_BASES
    HasInfluence Shaper Elder Crusader Hunter Redeemer Warlord
    #.import _util -> multi_t3

# Memory Strands

Show
    BaseType == DAGGER_BEST_BASES
    ItemLevel >= MODS_WEAPON_BEST_ITEM_LEVEL
    MemoryStrands == 100
    #.import _util -> multi_t1

Show
    BaseType == DAGGER_BEST_BASES
    ItemLevel >= MODS_WEAPON_BEST_ITEM_LEVEL
    MemoryStrands >= 50
    #.import _util -> multi_t2

Show
    BaseType == DAGGER_BEST_BASES
    MemoryStrands == 100
    #.import _util -> multi_t2

Show #.strict STRICTNESS_STRICT .if Show
    BaseType == DAGGER_BEST_BASES
    MemoryStrands >= 50
    #.import _util -> multi_t3

# High Quality

Show
    BaseType == DAGGER_BEST_BASES
    ItemLevel >= MODS_WEAPON_BEST_ITEM_LEVEL
    Quality == 30
    #.import _util -> multi_t1

Show
    BaseType == DAGGER_BEST_BASES
    Quality == 30
    #.import _util -> multi_t2

Show
    BaseType == DAGGER_BEST_BASES
    ItemLevel >= MODS_WEAPON_BEST_ITEM_LEVEL
    Quality > 25
    #.import _util -> multi_t3

Show #.strict STRICTNESS_STRICT .if Show
    BaseType == DAGGER_BEST_BASES
    Quality > 25
    #.import _util -> multi_t3

# Exceptional Base

Show
    BaseType == DAGGER_EXCEPTIONAL_BASES
    ItemLevel >= MODS_WEAPON_BEST_ITEM_LEVEL
    #.import _util -> multi_t1

Show
    BaseType == DAGGER_EXCEPTIONAL_BASES
    #.import _util -> multi_t2

# Best Base

Show #.strict STRICTNESS_STRICT .if Show
    BaseType == DAGGER_BEST_BASES
    ItemLevel >= MODS_WEAPON_BEST_ITEM_LEVEL
    #.import < _util -> craftable
    #.import _util -> multi_t3

Show #.strict STRICTNESS_BASE .if Show
    BaseType == DAGGER_BEST_BASES
    #.import < _util -> craftable