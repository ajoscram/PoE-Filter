#.subsection Replica

# Armour and Offhands

Show #.econ uni 100
    BaseType == "Triumphant Lamellar" "Carnal Armour" "Soldier Boots" "Ebony Tower Shield"
    Class == "Body Armours" "Boots" "Gloves" "Helmets" "Shields" "Quivers" #.format
    Rarity == Unique
    LinkedSockets < 5 #.format
    Replica True
    #.import STYLE | armour > unique -> t1

