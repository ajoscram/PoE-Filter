#.subsection Replica

# Armour and Offhands

Show #.econ uni 100
    BaseType == "Ebony Tower Shield" "Assassin's Boots" "Blood Raiment" "Spidersilk Robe" "Triumphant Lamellar" "Soldier Boots" "Carnal Armour" "Zodiac Leather"
    Class == "Body Armours" "Boots" "Gloves" "Helmets" "Shields" "Quivers" #.format
    Rarity == Unique
    LinkedSockets < 5 #.format
    Replica True
    #.import STYLE | armour > unique -> t1

Show #.econ uni 10 100
    BaseType == "Leather Hood" "Elegant Ringmail" "Satin Gloves" "Ezomyte Burgonet" "Ornate Quiver" "Glorious Plate" "Shagreen Boots" "Vaal Gauntlets" "Zodiac Leather"
    Class == "Body Armours" "Boots" "Gloves" "Helmets" "Shields" "Quivers" #.format
    Rarity == Unique
    LinkedSockets < 5 #.format
    Replica True
    #.import STYLE | armour > unique -> t2

Show #.econ uni 1 10 .strict STRICTNESS_STRICT .if Show
    BaseType == "Carnal Armour" "Murder Boots" "Samite Gloves" "Titan Greaves" "Arcanist Slippers" "Great Helmet" "Crusader Chainmail" "Laminated Kite Shield" "Zealot Gloves" "Sinner Tricorne" "Spike-Point Arrow Quiver" "Silk Slippers" "Festival Mask" "Lacquered Buckler"
    Class == "Body Armours" "Boots" "Gloves" "Helmets" "Shields" "Quivers" #.format
    Rarity == Unique
    LinkedSockets < 5 #.format
    Replica True
    #.import STYLE | armour > unique -> t3

