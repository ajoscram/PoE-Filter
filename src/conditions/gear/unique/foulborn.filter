#.subsection Foulborn

# Armour and Offhands

Show #.econ uni 100
    BaseType == "Wyrmscale Doublet" "Rawhide Boots" "Crusader Plate" "Lacquered Garb" "Titanium Spirit Shield" "Gilded Sallet" "Golden Mask" "Spidersilk Robe" "Astral Plate" "Steel Kite Shield" "Sage's Robe" "Gladiator Plate" "Exquisite Leather" "Elegant Round Shield" "Champion Kite Shield"
    Class == "Body Armours" "Boots" "Gloves" "Helmets" "Shields" "Quivers" #.format
    Rarity == Unique
    LinkedSockets < 5 #.format
    Foulborn True
    #.import STYLE | armour > unique -> t1

