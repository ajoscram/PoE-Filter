# Rare

Show
    Rarity == Rare
    #.import STYLE | armour > rare -> t1
    #.multi
        Class == CLASS
        HasExplicitMod ==6 MODS_GRAND
    #.multi
        BaseType == BASES_BEST
        HasExplicitMod >=5 MODS_GRAND

Show
    Rarity == Rare
    #.import STYLE | armour > rare -> t2
    #.multi
        Class == CLASS
        HasExplicitMod >=5 MODS_GRAND
    #.multi
        BaseType == BASES_BEST
        HasExplicitMod >=4 MODS_GRAND

Show #.strict STRICTNESS_STRICT
    Rarity == Rare
    #.import STYLE | armour > rare -> t2
    #.multi
        Class == CLASS
        HasExplicitMod >=3 MODS_GRAND
    #.multi
        BaseType == BASES_BEST
        HasExplicitMod >=2 MODS_GRAND

Show #.strict STRICTNESS_LENIENT
    Rarity == Rare
    #.import STYLE | armour > rare -> t3
    #.multi
        Class == CLASS
        HasExplicitMod >=3 MODS_GREATER MODS_GRAND
    #.multi
        BaseType == BASES_BEST
        HasExplicitMod >=2 MODS_GREATER MODS_GRAND

Show #.strict STRICTNESS_BASE
    Rarity == Rare
    #.import STYLE | armour > rare -> t3
    #.multi
        Class == CLASS
        HasExplicitMod >=3 MODS_LESSER MODS_GREATER MODS_GRAND
    #.multi
        BaseType == BASES_BEST
        HasExplicitMod >=2 MODS_LESSER MODS_GREATER MODS_GRAND
