# Magic

Show
    BaseType == BASES_BEST
    Rarity == Magic
    HasExplicitMod ==2 MODS_GRAND
    #.import STYLE | armour > magic -> t2

Show #.strict STRICTNESS_STRICT .if Show
    Rarity == Magic
    #.import STYLE | armour > magic -> t2
    #.multi
        Class == CLASS
        HasExplicitMod ==2 MODS_GRAND
    #.multi
        BaseType == BASES_BEST
        HasExplicitMod == MODS_GRAND

Show #.strict STRICTNESS_LENIENT .if Show
    Rarity == Magic
    #.import STYLE | armour > magic -> t3
    #.multi
        Class == CLASS
        HasExplicitMod == MODS_GRAND
    #.multi
        Class == CLASS
        HasExplicitMod ==2 MODS_GREATER
    #.multi
        BaseType == BASES_BEST
        HasExplicitMod == MODS_GREATER

Show #.strict STRICTNESS_BASE .if Show
    Rarity == Magic
    #.import STYLE | armour > magic -> t3
    #.multi
        Class == CLASS
        HasExplicitMod == MODS_GREATER
    #.multi
        Class == CLASS
        HasExplicitMod ==2 MODS_LESSER
    #.multi
        BaseType == BASES_BEST
        HasExplicitMod == MODS_LESSER
