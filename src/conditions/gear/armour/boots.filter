#.subsection Boots

#.alias BOOTS_BEST_BASE_DROP_LEVEL = 84
#.alias BOOTS_BEST_MOD_ITEM_LEVEL  = 86
#.alias BOOTS_EXCEPTIONAL_BASES    = "Brimstone Treads" "Stormrider Boots" "Dreamquest Slippers" "Runic Sabatons" "Fugitive Boots"

#.alias BOOTS_EXCEPTIONAL_MODS     = "Subterranean" "of the Underground" "Xopec's" "Matatl's" "Mutewind" "Sentinel's" "Infamous" "Haunted" "of Haunting"
#.alias BOOTS_GRAND_MODS           = "Athlete's" "Runed" "Whitesmith's" "Cherub's" "Illusory" "Hallowed" "Inspired" "Durable" "Legend's" "Unassailable" "Seething" "Zaffre" "Vaporous" "Mirage's" "Impregnable" "Encased" "Hellion's" "Pirate's" "of the Gods" "of Raiding" "of the Phoenix" "of Tzteosh" "of Haast" "of Ephij" "of Bameth" "of Everlasting" "of the Wind" "of Nullification" "of the Genius" "of Ardour"
#.alias BOOTS_GREATER_MODS         = "Virile" "Owen's" "Masterwork" "Lettered" "Goldsmith's" "Sylph's" "Unreal" "Sanctified" "Interpolated" "Flexible" "Mammoth's" "Hero's" "Deacon's" "Prior's" "Seraphim's" "Indomitable" "Pulsing" "Blue" "Fawn's" "Phased" "Hummingbird's" "Nightmare's" "Girded" "Carapaced" "Urchin's" "Cheetah's" "Gazelle's" "Magpie's" "of the Titan" "of Plunder" "of Ryslatha" "of the Magma" "of the Ice" "of the Lightning" "of Exile" "of Expulsion" "of Youth" "of the Phantom" "of Abjuration" "of the Virtuoso" "of Buffering" "of Runes" "of Inscription"
#.alias BOOTS_LESSER_MODS          = "Rotund" "Annest's" "Exquisite" "Inscribed" "Silversmith's" "Nymph's" "Evanescent" "Anointed" "Inculcated" "Pliant" "Elephant's" "Duelist's" "Acolyte's" "Monk's" "Djinn's" "Dauntless" "Radiating" "Mazarine" "Flea's" "Blurred" "Dragonfly's" "Phantasm's" "Thickened" "Plated" "Oyster's" "Stallion's" "of the Leviathan" "of the Troll" "of the Volcano" "of the Furnace" "of the Polar Bear" "of the Walrus" "of the Maelstrom" "of the Tempest" "of Eviction" "of Vivification" "of Perpetuity" "of the Jaguar" "of Revoking" "of the Savant" "of Dispersal" "of Engraving"

# Unique

Show #.econ uni 100
    BaseType == "Rawhide Boots" "Assassin's Boots" "Crusader Boots" "Murder Boots" "Runic Sollerets" "Dragonscale Boots" "Sorcerer Boots"
    Class == "Boots" #.format
    Rarity == Unique
    Replica False
    #.import STYLE | armour > unique -> t1

Show #.econ uni 100
    BaseType == "Assassin's Boots" "Soldier Boots"
    Class == "Boots" #.format
    Rarity == Unique
    Replica True
    #.import STYLE | armour > unique -> t1

Show #.econ uni 10 100
    BaseType == "Carnal Boots" "Rawhide Boots" "Slink Boots" "Riveted Boots" "Reinforced Greaves" "Goathide Boots" "Titan Greaves" "Runic Sabatons" "Sorcerer Boots" "Stealth Boots"
    Class == "Boots" #.format
    Rarity == Unique
    Replica False
    #.import STYLE | armour > unique -> t2

Show #.econ uni 10 100
    BaseType == "Titan Greaves"
    Class == "Boots" #.format
    Rarity == Unique
    Replica True
    #.import STYLE | armour > unique -> t2

Show #.econ uni 1 10 .strict STRICTNESS_STRICT .if Show
    BaseType == "Conjurer Boots" "Arcanist Slippers" "Trapper Boots" "Sharkskin Boots" "Shagreen Boots" "Stealth Boots" "Velvet Slippers" "Nubuck Boots" "Carnal Boots" "Wyrmscale Boots" "Ancient Greaves" "Mesh Boots" "Hydrascale Boots" "Wool Shoes" "Dragonscale Boots" "Legion Boots" "Titan Greaves" "Bronzescale Boots" "Ironscale Boots" "Slink Boots" "Silk Slippers" "Fugitive Boots" "Murder Boots" "Satin Slippers" "Soldier Boots" "Two-Toned Boots" "Vaal Greaves" "Assassin's Boots" "Serpentscale Boots" "Goathide Boots" "Goliath Greaves"
    Class == "Boots" #.format
    Rarity == Unique
    Replica False
    #.import STYLE | armour > unique -> t3

Show #.econ uni 1 10 .strict STRICTNESS_STRICT .if Show
    BaseType == "Arcanist Slippers" "Silk Slippers" "Murder Boots" "Shagreen Boots" "Bronzescale Boots"
    Class == "Boots" #.format
    Rarity == Unique
    Replica True
    #.import STYLE | armour > unique -> t3

# Exceptional Mods

Show
    Class == "Boots"
    HasExplicitMod == BOOTS_EXCEPTIONAL_MODS
    DropLevel >= BOOTS_BEST_BASE_DROP_LEVEL
    #.import _util -> multi_t1_rare
    #.import _util -> multi_t1_magic

Show
    Class == "Boots"
    HasExplicitMod == BOOTS_EXCEPTIONAL_MODS
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

# Rare

Show
    Class == "Boots"
    Rarity == Rare
    #.import STYLE | armour > rare -> t1
    #.multi
        HasExplicitMod ==6 BOOTS_GRAND_MODS
    #.multi
        HasExplicitMod >=5 BOOTS_GRAND_MODS
        DropLevel >= BOOTS_BEST_BASE_DROP_LEVEL

Show
    Class == "Boots"
    Rarity == Rare
    #.import STYLE | armour > rare -> t2
    #.multi
        HasExplicitMod >=5 BOOTS_GRAND_MODS
    #.multi
        HasExplicitMod >=4 BOOTS_GRAND_MODS
        DropLevel >= BOOTS_BEST_BASE_DROP_LEVEL

Show #.strict STRICTNESS_STRICT
    Class == "Boots"
    Rarity == Rare
    #.import STYLE | armour > rare -> t2
    #.multi
        HasExplicitMod >=3 BOOTS_GRAND_MODS
    #.multi
        HasExplicitMod >=2 BOOTS_GRAND_MODS
        DropLevel >= BOOTS_BEST_BASE_DROP_LEVEL

Show #.strict STRICTNESS_LENIENT
    Class == "Boots"
    Rarity == Rare
    #.import STYLE | armour > rare -> t3
    #.multi
        HasExplicitMod >=3 BOOTS_GREATER_MODS BOOTS_GRAND_MODS
    #.multi
        HasExplicitMod >=2 BOOTS_GREATER_MODS BOOTS_GRAND_MODS
        DropLevel >= BOOTS_BEST_BASE_DROP_LEVEL

Show #.strict STRICTNESS_BASE
    Class == "Boots"
    Rarity == Rare
    #.import STYLE | armour > rare -> t3
    #.multi
        HasExplicitMod >=3 BOOTS_LESSER_MODS BOOTS_GREATER_MODS BOOTS_GRAND_MODS
    #.multi
        HasExplicitMod >=2 BOOTS_LESSER_MODS BOOTS_GREATER_MODS BOOTS_GRAND_MODS
        DropLevel >= BOOTS_BEST_BASE_DROP_LEVEL

# Magic

Show
    Class == "Boots"
    Rarity == Magic
    HasExplicitMod ==2 BOOTS_GRAND_MODS
    DropLevel >= BOOTS_BEST_BASE_DROP_LEVEL
    #.import STYLE | armour > magic -> t2

Show #.strict STRICTNESS_STRICT
    Class == "Boots"
    Rarity == Magic
    #.import STYLE | armour > magic -> t2
    #.multi
        HasExplicitMod ==2 BOOTS_GRAND_MODS
    #.multi
        HasExplicitMod == BOOTS_GRAND_MODS
        DropLevel >= BOOTS_BEST_BASE_DROP_LEVEL

Show #.strict STRICTNESS_LENIENT
    Class == "Boots"
    Rarity == Magic
    #.import STYLE | armour > magic -> t3
    #.multi
        HasExplicitMod == BOOTS_GRAND_MODS
    #.multi
        HasExplicitMod ==2 BOOTS_GREATER_MODS
    #.multi
        HasExplicitMod == BOOTS_GREATER_MODS
        DropLevel >= BOOTS_BEST_BASE_DROP_LEVEL

Show #.strict STRICTNESS_BASE
    Class == "Boots"
    Rarity == Magic
    #.import STYLE | armour > magic -> t3
    #.multi
        HasExplicitMod == BOOTS_GREATER_MODS
    #.multi
        HasExplicitMod ==2 BOOTS_LESSER_MODS
    #.multi
        HasExplicitMod == BOOTS_LESSER_MODS
        DropLevel >= BOOTS_BEST_BASE_DROP_LEVEL

# Fractured

Show
    Class == "Boots"
    FracturedItem True
    HasExplicitMod == BOOTS_GRAND_MODS
    ItemLevel >= BOOTS_BEST_MOD_ITEM_LEVEL
    DropLevel >= BOOTS_BEST_BASE_DROP_LEVEL
    #.import _util -> multi_t1_rare
    #.import _util -> multi_t1_magic

Show
    Class == "Boots"
    FracturedItem True
    HasExplicitMod == BOOTS_GRAND_MODS
    DropLevel >= BOOTS_BEST_BASE_DROP_LEVEL
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

Show #.strict STRICTNESS_STRICT .if Show
    Class == "Boots"
    FracturedItem True
    ItemLevel >= BOOTS_BEST_MOD_ITEM_LEVEL
    DropLevel >= BOOTS_BEST_BASE_DROP_LEVEL
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

Show #.strict STRICTNESS_LENIENT .if Show
    Class == "Boots"
    FracturedItem True
    DropLevel >= BOOTS_BEST_BASE_DROP_LEVEL
    #.import _util -> multi_t3_rare
    #.import _util -> multi_t3_magic

