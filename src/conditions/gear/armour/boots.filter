# Unique

Show #.econ uni 100
    BaseType == "Rawhide Boots" "Assassin's Boots" "Crusader Boots" "Murder Boots" "Runic Sollerets" "Dragonscale Boots" "Sorcerer Boots"
    Class == "Boots" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | armour > unique -> t1

Show #.econ uni 10 100
    BaseType == "Carnal Boots" "Rawhide Boots" "Slink Boots" "Riveted Boots" "Reinforced Greaves" "Goathide Boots" "Titan Greaves" "Runic Sabatons" "Sorcerer Boots" "Stealth Boots"
    Class == "Boots" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | armour > unique -> t2

Show #.econ uni 1 10 .strict STRICTNESS_STRICT .if Show
    BaseType == "Conjurer Boots" "Arcanist Slippers" "Trapper Boots" "Sharkskin Boots" "Shagreen Boots" "Stealth Boots" "Velvet Slippers" "Nubuck Boots" "Carnal Boots" "Wyrmscale Boots" "Ancient Greaves" "Mesh Boots" "Hydrascale Boots" "Wool Shoes" "Dragonscale Boots" "Legion Boots" "Titan Greaves" "Bronzescale Boots" "Ironscale Boots" "Slink Boots" "Silk Slippers" "Fugitive Boots" "Murder Boots" "Satin Slippers" "Soldier Boots" "Two-Toned Boots" "Vaal Greaves" "Assassin's Boots" "Serpentscale Boots" "Goathide Boots" "Goliath Greaves"
    Class == "Boots" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | armour > unique -> t3

#.import template > _main { CLASS = "Boots", BASES_BEST = BASES_BOOTS_BEST, ITEM_LEVEL_BEST = ITEM_LEVEL_BOOTS_BEST, BASES_EXCEPTIONAL = BASES_BOOTS_EXCEPTIONAL, MODS_EXCEPTIONAL = MODS_BOOTS_EXCEPTIONAL, MODS_GRAND = MODS_BOOTS_GRAND, MODS_GREATER = MODS_BOOTS_GREATER, MODS_LESSER = MODS_BOOTS_LESSER