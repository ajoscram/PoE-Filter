# Unique

Show #.econ uni 100
    BaseType == "Harlequin Mask" "Fluted Bascinet" "Silken Hood" "Magistrate Crown" "Necromancer Circlet" "Solaris Circlet" "Ezomyte Burgonet" "Faithful Helmet"
    Class == "Helmets" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    Vestigial False
    #.import STYLE | armour > unique -> t1

Show #.econ uni 10 100
    BaseType == "Siege Helmet" "Runic Helm" "Bone Circlet" "Prophet Crown" "Golden Mask" "Runic Crown" "Bone Helmet" "Hubris Circlet" "Silken Hood" "Lacquered Helmet" "Royal Burgonet" "Magistrate Crown" "Raven Mask" "Callous Mask" "Great Crown" "Faithful Helmet"
    Class == "Helmets" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    Vestigial False
    #.import STYLE | armour > unique -> t2

Show #.econ uni 1 10 .strict STRICTNESS_STRICT .if Show
    BaseType == "Iron Mask" "Nightmare Bascinet" "Festival Mask" "Lunaris Circlet" "Gilded Sallet" "Bone Helmet" "Silken Hood" "Lacquered Helmet" "Aventail Helmet" "Leather Cap" "Mind Cage" "Solaris Circlet" "Praetor Crown" "Iron Hat" "Harlequin Mask" "Tricorne" "Secutor Helm" "Golden Mask" "Zealot Helmet" "Pig-Faced Bascinet" "Paladin Crown" "Reaver Helmet" "Sinner Tricorne" "Magistrate Crown" "Wolf Pelt" "Vine Circlet" "Steel Circlet" "Visored Sallet" "Prophet Crown" "Iron Circlet" "Barbute Helmet" "Hubris Circlet" "Necromancer Circlet" "Soldier Helmet" "Ursine Pelt" "Ezomyte Burgonet" "Vaal Mask" "Close Helmet" "Leather Hood" "Bone Circlet" "Lich's Circlet" "Tribal Circlet" "Samnite Helmet" "Royal Burgonet" "Eternal Burgonet" "Deicide Mask" "Regicide Mask" "Callous Mask" "Great Crown" "Lion Pelt"
    Class == "Helmets" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    Vestigial False
    #.import STYLE | armour > unique -> t3

#.import template > _main { CLASS = "Helmets", BASES_BEST = BASES_HELMET_BEST, ITEM_LEVEL_BEST = ITEM_LEVEL_HELMET_BEST, AREA_LEVEL_BEST_DROP_START = LEVEL_MAPS_T16, BASES_EXCEPTIONAL = BASES_HELMET_EXCEPTIONAL, MODS_EXCEPTIONAL = MODS_HELMET_EXCEPTIONAL, MODS_GRAND = MODS_HELMET_GRAND, MODS_GREATER = MODS_HELMET_GREATER, MODS_LESSER = MODS_HELMET_LESSER