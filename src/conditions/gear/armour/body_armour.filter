#.subsection Body Armour

#.alias BODY_ARMOUR_BEST_BASE_DROP_LEVEL = 84
#.alias BODY_ARMOUR_BEST_MOD_ITEM_LEVEL  = 86
#.alias BODY_ARMOUR_EXCEPTIONAL_BASES    = "Grasping Mail" "Sacrificial Garb"

#.alias BODY_ARMOUR_EXCEPTIONAL_MODS     = "Guatelitzi's" "of Tacati" "Subterranean" "of the Underground" "of Infamy" "of Haunting" "of the Sentinel"
#.alias BODY_ARMOUR_GRAND_MODS           = "Prime" "Phantasm's" "Incorporeal" "Godly" "Interpermeated" "Versatile" "Victor's" "Unfaltering" "Resplendent" "Zaffre" "Fugitive" "Illusion's" "Impenetrable" "Impervious" "of the Wind" "of the Gods" "of Convalescence" "of Tzteosh" "of Haast" "of Ephij" "of Bameth" "of the Conservator" "of Nullification" "of the Genius"
#.alias BODY_ARMOUR_GREATER_MODS         = "Rapturous" "Apparition's" "Illusory" "Saintly" "Seraphim's" "Inspired" "Adaptable" "Legend's" "Bishop's" "Exarch's" "Unassailable" "Incandescent" "Blue" "Ibex's" "Lissome" "Hummingbird's" "Mirage's" "Impregnable" "Mammoth's" "Unmoving" "Crocodile's" "of the Phantom" "of the Titan" "of Life-giving" "of the Magma" "of the Ice" "of the Lightning" "of Exile" "of Expulsion" "of the Protector" "of Abjuration" "of the Virtuoso" "of Second Wind"
#.alias BODY_ARMOUR_LESSER_MODS          = "Vigorous" "Fecund" "Athlete's" "Virile" "Eidolon's" "Unreal" "Consecrated" "Djinn's" "Interpolated" "Resilient" "Hero's" "Priest's" "Abbot's" "Indomitable" "Scintillating" "Mazarine" "Ram's" "Adroit" "Dragonfly's" "Nightmare's" "Girded" "Elephant's" "Abating" "Nautilus's" "of the Jaguar" "of the Leviathan" "of Recuperation" "of the Volcano" "of the Furnace" "of the Polar Bear" "of the Walrus" "of the Maelstrom" "of the Tempest" "of Eviction" "of the Keeper" "of the Sentry" "of the Watchman" "of Revoking" "of Snuffing" "of the Savant" "of Vigour"

# Unique

Show #.econ uni 100
    BaseType == "Crusader Plate" "Carnal Armour" "Wyrmscale Doublet" "Spidersilk Robe" "Desert Brigandine" "Sage's Robe" "Lacquered Garb"
    Class == "Body Armours" #.format
    Rarity == Unique
    LinkedSockets < 5 #.format
    Replica False
    #.import STYLE | armour > unique -> t1

Show #.econ uni 100
    BaseType == "Triumphant Lamellar"
    Class == "Body Armours" #.format
    Rarity == Unique
    LinkedSockets < 5 #.format
    Replica True
    #.import STYLE | armour > unique -> t1

Show #.econ uni 10 100
    BaseType == "Sentinel Jacket" "Cabalist Regalia" "Carnal Armour" "Saint's Hauberk" "Silken Vest" "Sadist Garb" "Gladiator Plate" "Lacquered Garb" "Savant's Robe" "Sage's Robe"
    Class == "Body Armours" #.format
    Rarity == Unique
    LinkedSockets < 5 #.format
    Replica False
    #.import STYLE | armour > unique -> t2

Show #.econ uni 10 100
    BaseType == "Carnal Armour" "Triumphant Lamellar"
    Class == "Body Armours" #.format
    Rarity == Unique
    LinkedSockets < 5 #.format
    Replica True
    #.import STYLE | armour > unique -> t2

Show #.econ uni 1 10 .strict STRICTNESS_STRICT .if Show
    BaseType == "Crusader Plate" "Blood Raiment" "Scholar's Robe" "Sadist Garb" "Lacquered Garb" "Vaal Regalia" "Glorious Plate" "Spidersilk Robe" "Zodiac Leather" "Torturer Garb" "Destiny Leather" "Majestic Plate" "Wyrmscale Doublet" "Saint's Hauberk" "Elegant Ringmail" "Necromancer Silks" "Varnished Coat" "Gladiator Plate" "Sage's Robe" "Destroyer Regalia" "Exquisite Leather" "Silken Vest" "Astral Plate"
    Class == "Body Armours" #.format
    Rarity == Unique
    LinkedSockets < 5 #.format
    Replica False
    #.import STYLE | armour > unique -> t3

Show #.econ uni 1 10 .strict STRICTNESS_STRICT .if Show
    BaseType == "Glorious Plate" "Carnal Armour" "Blood Raiment" "Elegant Ringmail" "Spidersilk Robe" "Zodiac Leather"
    Class == "Body Armours" #.format
    Rarity == Unique
    LinkedSockets < 5 #.format
    Replica True
    #.import STYLE | armour > unique -> t3

# Exceptional Mods

Show
    Class == "Body Armours"
    HasExplicitMod == BODY_ARMOUR_EXCEPTIONAL_MODS
    DropLevel >= BODY_ARMOUR_BEST_BASE_DROP_LEVEL
    #.import _util -> multi_t1_rare
    #.import _util -> multi_t1_magic

Show
    Class == "Body Armours"
    HasExplicitMod == BODY_ARMOUR_EXCEPTIONAL_MODS
    #.import _util -> multi_t2_rare
    #.import _util -> multi_t2_magic

# Rare

Show
    Class == "Body Armours"
    Rarity == Rare
    #.import STYLE | armour > rare -> t1
    #.multi
        HasExplicitMod ==6 BODY_ARMOUR_GRAND_MODS
    #.multi
        HasExplicitMod >=5 BODY_ARMOUR_GRAND_MODS
        DropLevel >= BODY_ARMOUR_BEST_BASE_DROP_LEVEL

Show
    Class == "Body Armours"
    Rarity == Rare
    #.import STYLE | armour > rare -> t2
    #.multi
        HasExplicitMod >=5 BODY_ARMOUR_GRAND_MODS
    #.multi
        HasExplicitMod >=4 BODY_ARMOUR_GRAND_MODS
        DropLevel >= BODY_ARMOUR_BEST_BASE_DROP_LEVEL

Show #.strict STRICTNESS_STRICT
    Class == "Body Armours"
    Rarity == Rare
    #.import STYLE | armour > rare -> t2
    #.multi
        HasExplicitMod >=3 BODY_ARMOUR_GRAND_MODS
    #.multi
        HasExplicitMod >=2 BODY_ARMOUR_GRAND_MODS
        DropLevel >= BODY_ARMOUR_BEST_BASE_DROP_LEVEL

Show #.strict STRICTNESS_LENIENT
    Class == "Body Armours"
    Rarity == Rare
    #.import STYLE | armour > rare -> t3
    #.multi
        HasExplicitMod >=3 BODY_ARMOUR_GREATER_MODS BODY_ARMOUR_GRAND_MODS
    #.multi
        HasExplicitMod >=2 BODY_ARMOUR_GREATER_MODS BODY_ARMOUR_GRAND_MODS
        DropLevel >= BODY_ARMOUR_BEST_BASE_DROP_LEVEL

Show #.strict STRICTNESS_BASE
    Class == "Body Armours"
    Rarity == Rare
    #.import STYLE | armour > rare -> t3
    #.multi
        HasExplicitMod >=3 BODY_ARMOUR_LESSER_MODS BODY_ARMOUR_GREATER_MODS BODY_ARMOUR_GRAND_MODS
    #.multi
        HasExplicitMod >=2 BODY_ARMOUR_LESSER_MODS BODY_ARMOUR_GREATER_MODS BODY_ARMOUR_GRAND_MODS
        DropLevel >= BODY_ARMOUR_BEST_BASE_DROP_LEVEL

# Magic

Show
    Class == "Body Armours"
    Rarity == Magic
    HasExplicitMod ==2 BODY_ARMOUR_GRAND_MODS
    DropLevel >= BODY_ARMOUR_BEST_BASE_DROP_LEVEL
    #.import STYLE | armour > magic -> t2

Show #.strict STRICTNESS_STRICT
    Class == "Body Armours"
    Rarity == Magic
    #.import STYLE | armour > magic -> t2
    #.multi
        HasExplicitMod ==2 BODY_ARMOUR_GRAND_MODS
    #.multi
        HasExplicitMod == BODY_ARMOUR_GRAND_MODS
        DropLevel >= BODY_ARMOUR_BEST_BASE_DROP_LEVEL

Show #.strict STRICTNESS_LENIENT
    Class == "Body Armours"
    Rarity == Magic
    #.import STYLE | armour > magic -> t3
    #.multi
        HasExplicitMod == BODY_ARMOUR_GRAND_MODS
    #.multi
        HasExplicitMod ==2 BODY_ARMOUR_GREATER_MODS
    #.multi
        HasExplicitMod == BODY_ARMOUR_GREATER_MODS
        DropLevel >= BODY_ARMOUR_BEST_BASE_DROP_LEVEL

Show #.strict STRICTNESS_BASE
    Class == "Body Armours"
    Rarity == Magic
    #.import STYLE | armour > magic -> t3
    #.multi
        HasExplicitMod == BODY_ARMOUR_GREATER_MODS
    #.multi
        HasExplicitMod ==2 BODY_ARMOUR_LESSER_MODS
    #.multi
        HasExplicitMod == BODY_ARMOUR_LESSER_MODS
        DropLevel >= BODY_ARMOUR_BEST_BASE_DROP_LEVEL

