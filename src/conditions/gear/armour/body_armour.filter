# Unique

Show #.econ uni 100
    BaseType == "Zodiac Leather" "Carnal Armour" "Savant's Robe" "Sadist Garb"
    Class == "Body Armours" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    Vestigial False
    LinkedSockets < 5 #.format
    #.import STYLE | armour > unique -> t1

Show #.econ uni 10 100
    BaseType == "Vaal Regalia" "Golden Plate" "Glorious Plate" "Crusader Plate" "Saint's Hauberk" "Lacquered Garb" "Sage's Robe" "Wyrmscale Doublet" "Elegant Ringmail" "Triumphant Lamellar" "Sentinel Jacket" "Sadist Garb" "Cabalist Regalia" "Gladiator Plate" "Blood Raiment" "Spidersilk Robe"
    Class == "Body Armours" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    Vestigial False
    LinkedSockets < 5 #.format
    #.import STYLE | armour > unique -> t2

Show #.econ uni 1 10 .strict STRICTNESS_STRICT .if Show
    BaseType == "Ornate Ringmail" "Golden Plate" "Simple Robe" "Exquisite Leather" "Varnished Coat" "Silken Vest" "Sentinel Jacket" "Sharkskin Tunic" "Scholar's Robe" "Plate Vest" "Destiny Leather" "Desert Brigandine" "Widowsilk Robe" "Lacquered Garb" "Full Wyrmscale" "Carnal Armour" "Occultist's Vestment" "Sadist Garb" "Destroyer Regalia" "Waxed Garb" "Sun Leather" "Saintly Chainmail" "Astral Plate" "Bone Armour" "Devout Chainmail" "General's Brigandine" "Zodiac Leather" "Crusader Chainmail" "Elegant Ringmail" "Conquest Chainmail" "Holy Chainmail" "Assassin's Garb" "Triumphant Lamellar" "Torturer Garb" "Wild Leather" "Full Dragonscale" "Copper Plate" "Vaal Regalia" "Latticed Ringmail" "Glorious Plate" "Necromancer Silks" "Crusader Plate" "Saint's Hauberk" "Sacrificial Garb" "Buckskin Tunic" "Sage's Robe" "Majestic Plate" "Colosseum Plate" "Cutthroat's Garb" "Spidersilk Robe"
    Class == "Body Armours" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    Vestigial False
    LinkedSockets < 5 #.format
    #.import STYLE | armour > unique -> t3

#.import template > _main { CLASS = "Body Armours", BASES_BEST = BASES_BODY_ARMOUR_BEST, ITEM_LEVEL_BEST = ITEM_LEVEL_BODY_ARMOUR_BEST, AREA_LEVEL_BEST_DROP_START = LEVEL_MAPS_T17, BASES_EXCEPTIONAL = BASES_BODY_ARMOUR_EXCEPTIONAL, MODS_EXCEPTIONAL = MODS_BODY_ARMOUR_EXCEPTIONAL, MODS_GRAND = MODS_BODY_ARMOUR_GRAND, MODS_GREATER = MODS_BODY_ARMOUR_GREATER, MODS_LESSER = MODS_BODY_ARMOUR_LESSER