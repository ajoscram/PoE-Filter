# Unique

Show #.econ uni 100
    BaseType == "Runic Gages" "Goliath Gauntlets" "Carnal Mitts" "Ancient Gauntlets" "Ambush Mitts" "Assassin's Mitts" "Antique Gauntlets"
    Class == "Gloves" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | armour > unique -> t1

Show #.econ uni 10 100
    BaseType == "Samite Gloves" "Fingerless Silk Gloves" "Steelscale Gauntlets" "Titan Gauntlets" "Legion Gloves" "Zealot Gloves" "Martyr Gloves" "Runic Gauntlets" "Hydrascale Gauntlets" "Crusader Gloves" "Vaal Gauntlets" "Silk Gloves" "Riveted Gloves" "Murder Mitts" "Embroidered Gloves" "Deerskin Gloves"
    Class == "Gloves" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | armour > unique -> t2

