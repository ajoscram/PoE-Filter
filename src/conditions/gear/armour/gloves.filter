    BaseType == "Ambush Mitts" "Riveted Gloves" "Murder Mitts" "Vaal Gauntlets" "Hydrascale Gauntlets" "Runic Gages" "Martyr Gloves" "Carnal Mitts" "Assassin's Mitts"
