# Unique

Show #.econ uni 100
    BaseType == "Ancient Gauntlets" "Goliath Gauntlets" "Antique Gauntlets"
    Class == "Gloves" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    Vestigial False
    #.import STYLE | armour > unique -> t1

