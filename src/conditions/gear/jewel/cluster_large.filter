# Unique

Show
    BaseType == "Large Cluster Jewel"
    Rarity == Unique
    #.import STYLE | jewellery > unique -> t1

# Notable Mods

Show
    BaseType == "Large Cluster Jewel"
    EnchantmentPassiveNum == 8
    HasExplicitMod ==3 MODS_LARGE_CLUSTER_NOTABLE
    #.import STYLE | jewellery > rare -> t1

Show
    BaseType == "Large Cluster Jewel"
    HasExplicitMod >=2 MODS_LARGE_CLUSTER_NOTABLE
    #.import < jewellery > _util -> multi_t2_rare
    #.import < jewellery > _util -> multi_t2_magic

Show #.strict STRICTNESS_LENIENT .if Show
    BaseType == "Large Cluster Jewel"
    HasExplicitMod == MODS_LARGE_CLUSTER_NOTABLE
    HasExplicitMod <=2 MODS_LARGE_CLUSTER_GRAND MODS_LARGE_CLUSTER_GREATER MODS_LARGE_CLUSTER_LESSER
