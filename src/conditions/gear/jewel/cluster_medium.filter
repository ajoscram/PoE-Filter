#.subsection Medium Cluster

#.alias MODS_MEDIUM_CLUSTER_GRAND   = "Sanguine" "Azure" "Glowing" "Ribbed" "Acrobat's" "Dangerous" "of the Bear" "of the Fox" "of the Prodigy" "of the Meteor" "of the Drake" "of the Penguin" "of the Storm" "of the Kaleidoscope" "of Eviction" "of Disintegration" "of Guidance" "of Suppression" "of the Herald" "of the Canon" "of Bellowing" "of Rage" "of Motherhood" "of Horizons" "of Propulsion" "of Deployment" "of Forethought" "of Overflowing"
#.alias MODS_MEDIUM_CLUSTER_GREATER = "Healthy" "Cobalt" "Glimmering" "Studded" "Dancer's" "Hazardous" "of the Wrestler" "of the Lynx" "of the Student" "of the Sky" "of the Salamander" "of the Seal" "of the Squall" "of the Prism" "of the Crystal" "of Banishment" "of the Lost" "of Degeneration" "of Influence" "of Dominance" "of the Messenger" "of the Teachings" "of Shouting" "of Anger" "of Nurturing" "of Range" "of Flight" "of Assembly" "of Latching" "of Concentration" "of Brimming" 
#.alias MODS_MEDIUM_CLUSTER_LESSER  = "Hale" "Beryl" "Shining" "Lacquered" "Agile" "Harmful" "of the Brute" "of the Mongoose" "of the Pupil" "of the Cloud" "of the Flatworm" "of the Whelpling" "of the Inuit" "of the Cloud" "of Decline" "of Outreach" "of Clout" "of the Courier" "of the Message" "of Yelling" "of Ire" "of Fostering" "of Reach" "of Darting" "of Tinkering" "of The Way" "of Grasping" "of Attention" "of Refilling"

# Unique

Show
    BaseType == "Medium Cluster Jewel"
    Rarity == Unique
    #.import STYLE | jewellery > unique -> t2

# Legacy enchantments

Show
    EnchantmentPassiveNode == "Aura effect" "Curse effect"
    BaseType == "Medium Cluster Jewel"
    #.import < jewellery > _util -> multi_t1

# Notable Mods

Show
    BaseType == "Medium Cluster Jewel"
    EnchantmentPassiveNum <= 5
    HasExplicitMod ==2 "Notable"
    HasExplicitMod ==2 MODS_MEDIUM_CLUSTER_GRAND
    #.import STYLE | jewellery > rare -> t1

Show
    BaseType == "Medium Cluster Jewel"
    HasExplicitMod ==2 "Notable"
    #.import STYLE | jewellery > rare -> t2

Show #.strict STRICTNESS_LENIENT .if Show
    BaseType == "Medium Cluster Jewel"
    HasExplicitMod == "Notable"
    HasExplicitMod <=2 MODS_MEDIUM_CLUSTER_GRAND MODS_MEDIUM_CLUSTER_GREATER MODS_MEDIUM_CLUSTER_LESSER
    #.import < jewellery > _util -> multi_t3_rare
    #.import < jewellery > _util -> multi_t3_magic

