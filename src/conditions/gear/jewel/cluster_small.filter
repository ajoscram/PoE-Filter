#.subsection Small Cluster

#.alias MODS_SMALL_CLUSTER_GRAND   = "Stout" "Cerulean" "Pulsing" "Plated" "Blurred" "Deadly" "Powerful" "of the Gorilla" "of the Panther" "of the Philosopher" "of the Heavens" "of the Hydra" "of the Furnace" "of the Walrus" "of the Tempest" "of the Storm" "of Exile"
#.alias MODS_SMALL_CLUSTER_GREATER = "Stalwart" "Sapphire" "Radiating" "Fortified" "Fleet" "Destructive" "Potent" "of the Lion" "of the Falcon" "of the Augur" "of the Comet" "of the Starfish" "of the Kiln" "of the Yeti" "of the Thunderhead" "of Variegation" "of Expulsion" "of Eviction"
#.alias MODS_SMALL_CLUSTER_LESSER  = "Sanguine" "Azure" "Glowing" "Ribbed" "Acrobat's" "Dangerous" "of the Bear" "of the Fox" "of the Prodigy" "of the Meteor" "of the Flatworm" "of the Drake" "of the Penguin" "of the Storm" "of the Kaleidoscope" "of the Prism" "of Banishment" "of the Lost"

# Unique

Show #.strict STRICTNESS_STRICT .if Show
    BaseType == "Small Cluster Jewel"
    Rarity == Unique
    #.import STYLE | jewellery > unique -> t3

# Notable Mods

Show #.strict STRICTNESS_LENIENT .if Show
    BaseType == "Small Cluster Jewel"
    HasExplicitMod == "Notable"
    HasExplicitMod <=2 MODS_SMALL_CLUSTER_GRAND MODS_SMALL_CLUSTER_GREATER MODS_SMALL_CLUSTER_LESSER
    #.import < jewellery > _util -> multi_t3_rare
    #.import < jewellery > _util -> multi_t3_magic

#.import template > rare_cluster { BASE_JEWEL = "Small Cluster Jewel", MODS_GRAND = MODS_SMALL_CLUSTER_GRAND, MODS_GREATER = MODS_SMALL_CLUSTER_GREATER, MODS_LESSER = MODS_SMALL_CLUSTER_LESSER
#.import template > magic_cluster { BASE_JEWEL = "Small Cluster Jewel", MODS_GRAND = MODS_SMALL_CLUSTER_GRAND, MODS_GREATER = MODS_SMALL_CLUSTER_GREATER, MODS_LESSER = MODS_SMALL_CLUSTER_LESSER
#.import template > fractured_cluster { BASE_JEWEL = "Small Cluster Jewel", MODS_IMPORTANT = "Notable" MODS_SMALL_CLUSTER_GRAND

# 3 Passives - iLvl 84+

Show #.econ clj 100
    EnchantmentPassiveNode == "Reservation Efficiency"
    BaseType == "Small Cluster Jewel"
    EnchantmentPassiveNum == 3
    ItemLevel >= 84
    #.import < jewellery > _util -> multi_t1

Show #.econ clj 10 100
    EnchantmentPassiveNode == "Mana"
    BaseType == "Small Cluster Jewel"
    EnchantmentPassiveNum == 3
    ItemLevel >= 84
    #.import < jewellery > _util -> multi_t2

Show #.econ clj 0 10 .strict STRICTNESS_STRICT .if Show
    EnchantmentPassiveNode == "Chance to Suppress Spell Damage" "Chaos Resistance" "Curse Effect" "Chance to Block Attack Damage" "Cold Resistance" "Energy Shield" "Evasion" "Lightning Resistance" "Fire Resistance" "Armour" "Chance to Block Spell Damage" "Life"
    BaseType == "Small Cluster Jewel"
    EnchantmentPassiveNum == 3
    ItemLevel >= 84
    #.import < jewellery > _util -> multi_t3

