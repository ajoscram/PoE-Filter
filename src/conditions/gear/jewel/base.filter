#.subsection Base

#.alias BASE_TYPES_BASE_JEWEL       = "Crimson Jewel" "Cobalt Jewel" "Viridian Jewel" "Prismatic Jewel"

#.alias MODS_BASE_JEWEL_GRAND       = "Shimmering" "Electromantic" "Cryomantic" "Pyromantic" "Resonant" "Warding" "Wright's" "Jinxing" "Arming" "Honed" "Slicing" "Ripping" "Volleying" "Blunt" "Fencing" "Cleaving" "Beating" "Charging" "Harmonic" "Warrior's" "Bandit's" "Vivid" "Puncturing" "Rupturing" "Piercing" "Infernal" "Arctic" "Surging" "Decrepifying" "Cerebral" "of Wounding" "of Berserking" "of Zeal" "of Potency" "of Demolishing" "of the Elements" "of Order" "of the Phoenix" "of the Kraken" "of the Leviathan" "of Poisoning" "of Exsanguinating" "of Atrophy" "of Gelidity" "of Zealousness" "of Acrimony" "of Absorption" "of Enchanting" "of Unmaking"
#.alias MODS_BASE_JEWEL_GREATER     = "Master's" "Leadership" "Battlemage's" "Sorcerer's" "Wizard's" "Cruel" "Evasive" "Trapping" "Sabotage" "Fierce" "Savage" "Lethal" "Judging" "Vicious" "Sinister" "Brutal" "Flanking" "Gladiator's" "Champion's" "Soldier's" "Flaming" "Chilling" "Humming" "Sharpened" "Chaotic" "Enlightened" "Armoured" "Deflecting" "Shielding" "Parrying" "Halting" "Thwarting" "Dissipating" "of Archery" "of Combat" "of Entropy" "of Blasting" "of Strength" "of Dexterity" "of Intelligence" "of Athletics" "of Spirit" "of Cunning" "of Adaption" "of Rejuvenation" "of the Dragon" "of the Beast" "of Grounding" "of the Hearth" "of Insulation" "of Shelter" "of Impaling" "of Venom" "of Haemophilia" "of Combusting" "of Mysticism" "of Soaring" "of Focus"
#.alias MODS_BASE_JEWEL_LESSER      = "Serene" "Technical" "Sundering" "Harming" "Incinerating" "Avalanching" "Thundering" "Shaman's" "Prolonging" "Carved" "of Hungering" "of Infusion" "of Menace" "of Weight" "of the Apocalypse" "of Stunning" "of Hexwarding" "of Precision" "of Deadliness" "of Annihilation"

# Unique

Show
    Rarity == Unique
    #.import STYLE | jewellery > unique -> t1
    #.multi
        BaseType == "Prismatic Jewel"
    #.multi
        BaseType == "Crimson Jewel" "Cobalt Jewel" "Viridian Jewel"
        Corrupted False

Show
    BaseType == "Crimson Jewel" "Cobalt Jewel" "Viridian Jewel"
    Rarity == Unique
    #.import STYLE | jewellery > unique -> t2

# Fractured

Show
    BaseType == BASE_TYPES_BASE_JEWEL
    FracturedItem True
    HasExplicitMod == MODS_BASE_JEWEL_GRAND
    #.import < jewellery > _util -> multi_t2_rare
    #.import < jewellery > _util -> multi_t2_magic

Show #.strict STRICTNESS_LENIENT .if Show
    BaseType == BASE_TYPES_BASE_JEWEL
    FracturedItem True
    #.import < jewellery > _util -> multi_t3_rare
    #.import < jewellery > _util -> multi_t3_magic

# Rare

Show
    BaseType == BASE_TYPES_BASE_JEWEL
    Rarity == Rare
    HasExplicitMod >=3 MODS_BASE_JEWEL_GRAND
    #.import STYLE | jewellery > rare -> t2

Show #.strict STRICTNESS_STRICT .if Show
    BaseType == BASE_TYPES_BASE_JEWEL
    Rarity == Rare
    #.import STYLE | jewellery > rare -> t3
    #.multi
        HasExplicitMod >=2 MODS_BASE_JEWEL_GRAND
    #.multi
        HasExplicitMod >=3 MODS_BASE_JEWEL_GRAND MODS_BASE_JEWEL_GREATER

Show #.strict STRICTNESS_LENIENT .if Show
    BaseType == BASE_TYPES_BASE_JEWEL
    Rarity == Rare
    #.import STYLE | jewellery > rare -> t3
    #.multi
        HasExplicitMod >=2 MODS_BASE_JEWEL_GRAND MODS_BASE_JEWEL_GREATER
    #.multi
        HasExplicitMod >=3 MODS_BASE_JEWEL_GRAND MODS_BASE_JEWEL_GREATER MODS_BASE_JEWEL_LESSER

# Magic

Show
    BaseType == BASE_TYPES_BASE_JEWEL
    Rarity == Magic
    HasExplicitMod ==2 MODS_BASE_JEWEL_GRAND
    #.import STYLE | jewellery > magic -> t2

Show #.strict STRICTNESS_LENIENT .if Show
    BaseType == BASE_TYPES_BASE_JEWEL
    Rarity == Magic
    #.import STYLE | jewellery > magic -> t3
    #.multi
        HasExplicitMod == MODS_BASE_JEWEL_GRAND
    #.multi
        HasExplicitMod ==2 MODS_BASE_JEWEL_GREATER

Show #.strict STRICTNESS_BASE .if Show
    BaseType == BASE_TYPES_BASE_JEWEL
    Rarity == Magic
    #.import STYLE | jewellery > magic -> t3
    #.multi
        HasExplicitMod == MODS_BASE_JEWEL_GREATER
    #.multi
        HasExplicitMod ==2 MODS_BASE_JEWEL_LESSER

# Progression

Show #.if Show
    BaseType == BASE_TYPES_BASE_JEWEL
    AreaLevel >= LEVEL_WHITE_MAPS_START
    #.multi .strict STRICTNESS_LENIENT
        Rarity == Rare
        #.import STYLE | jewellery > rare -> t3
    #.multi .strict STRICTNESS_BASE
        Rarity == Magic
        #.import STYLE | jewellery > magic -> t3

Show
    BaseType == BASE_TYPES_BASE_JEWEL
    AreaLevel < LEVEL_WHITE_MAPS_START
    #.import < jewellery > _util -> multi_t3