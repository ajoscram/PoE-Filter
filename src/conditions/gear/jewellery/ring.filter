# Unique

Show #.econ uni 100
    BaseType == "Ring" "Amethyst Ring" "Formless Ring" "Ruby Ring" "Topaz Ring" "Sapphire Ring" "Steel Ring" "Vermillion Ring" "Opal Ring" "Prismatic Ring" "Fugitive Ring" "Two-Stone Ring" "Paua Ring"
    Class == "Rings" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | jewellery > unique -> t1

Show #.econ uni 10 100
    BaseType == "Amethyst Ring" "Ruby Ring" "Nameless Ring" "Topaz Ring" "Sapphire Ring" "Steel Ring" "Cryonic Ring" "Opal Ring" "Synaptic Ring" "Prismatic Ring" "Coral Ring" "Moonstone Ring" "Gold Ring" "Two-Stone Ring" "Unset Ring" "Paua Ring"
    Class == "Rings" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | jewellery > unique -> t2

