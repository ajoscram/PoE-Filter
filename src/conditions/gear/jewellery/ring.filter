    BaseType == "Amethyst Ring" "Ruby Ring" "Nameless Ring" "Steel Ring" "Sapphire Ring" "Organic Ring" "Iron Ring" "Opal Ring" "Topaz Ring" "Diamond Ring" "Prismatic Ring" "Coral Ring" "Moonstone Ring" "Gold Ring" "Two-Stone Ring" "Unset Ring" "Paua Ring" "Enthalpic Ring"
    Class == "Rings" #.format
