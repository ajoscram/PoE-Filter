# Unique

Show #.econ uni 100
    BaseType == "Greatwolf Talisman" "Rhex Talisman" "Jade Amulet" "Paua Amulet" "Onyx Amulet" "Unset Amulet"
    Class == "Amulets" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | jewellery > unique -> t1

Show #.econ uni 10 100
    BaseType == "Jade Amulet" "Seaglass Amulet" "Agate Amulet" "Amber Amulet" "Onyx Amulet" "Pearlescent Amulet" "Lapis Amulet" "Turquoise Amulet" "Shield Crab Talisman" "Astrolabe Amulet"
    Class == "Amulets" #.format
    Rarity == Unique
