# Progression - Rare

#.# Exceptional

Show #.if Show
    BaseType == BASES_EXCEPTIONAL
    Rarity == Rare
    #.import < < _util -> craftable
    #.multi
        ItemLevel >= ITEM_LEVEL_BEST
        #.import < < _util -> craftable
        #.import STYLE | jewellery > rare -> t2
    #.multi .strict STRICTNESS_STRICT
        #.import STYLE | jewellery > rare -> t3

#.# Grand

Show #.if Show
    BaseType == BASES_GRAND
    Rarity == Rare
    #.import < < _util -> craftable
    #.multi .strict STRICTNESS_STRICT
        ItemLevel >= ITEM_LEVEL_BEST
        #.import < < _util -> craftable
        #.import STYLE | jewellery > rare -> t2
    #.multi .strict STRICTNESS_LENIENT
        #.import STYLE | jewellery > rare -> t3

#.# Great

Show #.if Show
    BaseType == BASES_GREAT
    Rarity == Rare
    #.multi .strict STRICTNESS_LENIENT
        ItemLevel >= ITEM_LEVEL_BEST
        #.import < < _util -> craftable
        #.import STYLE | jewellery > rare -> t3
    #.multi .strict STRICTNESS_BASE
        #.import STYLE | jewellery > rare -> t3
    #.multi .strict STRICTNESS_LENIENT

#.# Lesser

Show #.if Show
    BaseType == BASES_LESSER
    Rarity == Rare
    #.multi .strict STRICTNESS_BASE
        AreaLevel < LEVEL_WHITE_MAPS_START
        #.import STYLE | jewellery > rare -> t3
    #.multi .strict STRICTNESS_BASE

# Progression - Magic

#.# Exceptional

Show #.if Show
    BaseType == BASES_EXCEPTIONAL
    Rarity == Magic
    #.import < < _util -> craftable
    #.multi
        ItemLevel >= ITEM_LEVEL_BEST
        #.import STYLE | jewellery > magic -> t2
    #.multi .strict STRICTNESS_STRICT
        #.import STYLE | jewellery > magic -> t3

#.# Grand

Show #.if Show
    BaseType == BASES_GRAND
    Rarity == Magic
    #.import < < _util -> craftable
    #.multi .strict STRICTNESS_STRICT
        ItemLevel >= ITEM_LEVEL_BEST
        #.import STYLE | jewellery > magic -> t2
    #.multi .strict STRICTNESS_BASE
        #.import STYLE | jewellery > magic -> t3
    #.multi .strict STRICTNESS_LENIENT

#.# Great

Show #.if Show
    BaseType == BASES_GREAT
    Rarity == Magic
    #.import < < _util -> craftable
    #.multi .strict STRICTNESS_LENIENT
        ItemLevel >= ITEM_LEVEL_BEST
        #.import STYLE | jewellery > magic -> t3
    #.multi .strict STRICTNESS_BASE
        AreaLevel < LEVEL_ACT_9_START
        AreaLevel >= LEVEL_ACT_6_START
    #.multi .strict STRICTNESS_BASE
        AreaLevel < LEVEL_ACT_6_START
        #.import STYLE | jewellery > magic -> t3

#.# Lesser

Show #.if Show
    BaseType == BASES_LESSER
    Rarity == Magic
    #.import < < _util -> craftable
    #.multi .strict STRICTNESS_BASE
        AreaLevel < LEVEL_ACT_6_START
        AreaLevel >= LEVEL_ACT_3_START
    #.multi .strict STRICTNESS_BASE
        AreaLevel < LEVEL_ACT_3_START
        #.import STYLE | jewellery > magic -> t3

