# Mods - Magic

Show
    BaseType == BASES_BEST
    Rarity == Magic
    HasExplicitMod ==2 MODS_GRAND
    #.import STYLE | jewellery > magic -> t2

Show #.strict STRICTNESS_STRICT
    Rarity == Magic
    #.import STYLE | jewellery > magic -> t2
    #.multi .strict STRICTNESS_STRICT
        Class == CLASS
        HasExplicitMod ==2 MODS_GRAND
    #.multi .strict STRICTNESS_STRICT
        BaseType == BASES_BEST
        HasExplicitMod == MODS_GRAND
    #.multi .strict STRICTNESS_LENIENT
        Class == CLASS
        HasExplicitMod == MODS_GRAND
    #.multi .strict STRICTNESS_LENIENT
        Class == CLASS
        HasExplicitMod ==2 MODS_GREATER
    #.multi .strict STRICTNESS_LENIENT
        BaseType == BASES_BEST
        HasExplicitMod == MODS_GREATER
    #.multi .strict STRICTNESS_BASE
        Class == CLASS
        HasExplicitMod == MODS_GREATER
    #.multi .strict STRICTNESS_BASE
        Class == CLASS
        HasExplicitMod ==2 MODS_LESSER
    #.multi .strict STRICTNESS_BASE
        BaseType == BASES_BEST
        HasExplicitMod == MODS_LESSER
