#.subsection Mana

#.alias ITEM_LEVEL_MANA_FLASK_BEST = 82
#.alias BASE_MANA_FLASK_BEST       = "Eternal Mana Flask"

#.alias MODS_MANA_FLASK_GRAND          = "Seething" "Enduring" "of Warding" "of Assuaging" "of the Dielectric" "of Quenching" "of Thawing" "of the Antidote"
#.alias MODS_MANA_FLASK_GREATER        = "of Restraint" "of Allaying" "of Liberation" "of Insulation" "of Quelling" "of Entropy" "of the Cure"
#.alias MODS_MANA_FLASK_LESSER         = "of Occlusion" "of Alleviation" "of Freedom" "of Grounding" "of Quashing" "of Thermodynamics" "of the Remedy"

# Unique

Show #.strict STRICTNESS_STRICT .if Show
    Class == "Mana Flasks"
    Rarity == Unique
    Replica False
    #.import STYLE | flask > unique -> t3

# Magic

Show
    BaseType == BASE_MANA_FLASK_BEST
    HasExplicitMod ==2 MODS_MANA_FLASK_GRAND
    #.import STYLE | flask > magic -> t2

Show #.strict STRICTNESS_LENIENT .if Show
    BaseType == BASE_MANA_FLASK_BEST
    HasExplicitMod ==2 MODS_MANA_FLASK_GRAND MODS_MANA_FLASK_GREATER
    #.import STYLE | flask > magic -> t3

Show #.strict STRICTNESS_BASE .if Show
    BaseType == BASE_MANA_FLASK_BEST
    HasExplicitMod ==2 MODS_MANA_FLASK_GRAND MODS_MANA_FLASK_GREATER MODS_MANA_FLASK_LESSER
    #.import STYLE | flask > magic -> t3

# Fractured

Show
    BaseType == BASE_MANA_FLASK_BEST
    HasExplicitMod == MODS_MANA_FLASK_GRAND
    FracturedItem True
    #.import STYLE | flask > magic -> t2

Show #.strict STRICTNESS_STRICT .if Show
    BaseType == BASE_MANA_FLASK_BEST
    HasExplicitMod == MODS_MANA_FLASK_GREATER
    FracturedItem True
    #.import STYLE | flask > magic -> t3

Show #.strict STRICTNESS_LENIENT .if Show
    BaseType == BASE_MANA_FLASK_BEST
    FracturedItem True
    #.import STYLE | flask > magic -> t3

# High Quality

Show
    BaseType == BASE_MANA_FLASK_BEST
    Quality >= 30
    #.import _util -> multi_t1

Show
    BaseType == BASE_MANA_FLASK_BEST
    Quality >= 26
    #.import _util -> multi_t2

Show #.strict STRICTNESS_STRICT .if Show
    BaseType == BASE_MANA_FLASK_BEST
    Quality >= 23
    #.import _util -> multi_t3

Show #.strict STRICTNESS_LENIENT .if Show
    BaseType == BASE_MANA_FLASK_BEST
    Quality >= 20
    #.import _util -> multi_t3

# Best Base

Show #.strict STRICTNESS_LENIENT .if Show
    BaseType == BASE_MANA_FLASK_BEST
    ItemLevel >= ITEM_LEVEL_MANA_FLASK_BEST
    #.import < _util -> craftable
    #.import _util -> multi_t3

Show #.strict STRICTNESS_BASE .if Show
    BaseType == BASE_MANA_FLASK_BEST
    AreaLevel < LEVEL_YELLOW_MAPS_START
    #.import < _util -> craftable

Show
    BaseType == BASE_MANA_FLASK_BEST
    AreaLevel < LEVEL_WHITE_MAPS_START
    #.import < _util -> craftable