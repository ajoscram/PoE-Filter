# Progression

Show #.strict STRICTNESS_STRICT .if Show
    Class == CLASS
    ItemLevel >= ITEM_LEVEL_BEST
    #.import < _util -> multi_t3

Show #.strict STRICTNESS_LENIENT .if Show
    Class == CLASS
    AreaLevel < LEVEL_WHITE_MAPS_START
    #.import < < _util -> craftable

Show #.strict STRICTNESS_BASE .if Show
    Class == CLASS
    AreaLevel < LEVEL_YELLOW_MAPS_START
    #.import < < _util -> craftable