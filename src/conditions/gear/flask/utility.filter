#.subsection Utility

#.alias ITEM_LEVEL_UTILITY_FLASK_BEST = 85

#.alias MODS_UTILITY_FLASK_GRAND          = "Perpetual" "Surgeon's" "Flagellant's" "Experimenter's" "Alchemist's" "of the Armadillo" "of the Impala" "of the Cheetah" "of Incision" "of Tenaciousness" "of the Owl" "of Bog Moss" "of Craft" "of the Opossum" "of the Eel" "of the Penguin" "of the Iguana"
#.alias MODS_UTILITY_FLASK_GREATER        = "Ample" "Bottomless" "Specialist's" "Masochist's" "Clinician's" "Dabbler's" "Chemist's" "of the Pangolin" "of the Ibex" "of the Lynx" "of the Rainbow" "of Bloodletting" "of Draining" "of Penetrating" "of Relentlessness" "of the Kakapo" "of Plume Moss" "of the Opossum" "of the Moray" "of the Walrus" "of the Starfish" "of the Skink"
#.alias MODS_UTILITY_FLASK_LESSER         = "Abundant" "Endless" "Doctor's" "Transgressor's" "Examiner's" "Abecedarian's" "Brewer's" "of the Tortoise" "of the Antelope" "of the Hare" "of the Kaleidoscope" "of Butchery" "of Siphoning" "of Rupturing" "of Persistence" "of the Curlew" "of Tooth Moss" "of the Skunk" "of the Conger" "of the Deer" "of the Mussel" "of the Lizard"

# Unique

Show #.econ uni 100
    BaseType == "Iron Flask" "Gold Flask" "Quartz Flask" "Bismuth Flask" "Amethyst Flask" "Silver Flask" "Sulphur Flask" "Ruby Flask"
    Class == "Utility Flasks" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | flask > unique -> t1

Show #.econ uni 10 100
    BaseType == "Sapphire Flask" "Granite Flask" "Stibnite Flask"
    Class == "Utility Flasks" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | flask > unique -> t2

Show #.econ uni 1 10 .strict STRICTNESS_STRICT .if Show
    BaseType == "Granite Flask" "Topaz Flask" "Bismuth Flask" "Quartz Flask" "Quicksilver Flask" "Amethyst Flask" "Sulphur Flask" "Ruby Flask" "Stibnite Flask"
    Class == "Utility Flasks" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | flask > unique -> t3

#.import template > magic_utility { CLASS = "Utility Flasks", MODS_GRAND = MODS_UTILITY_FLASK_GRAND, MODS_GREATER = MODS_UTILITY_FLASK_GREATER, MODS_LESSER = MODS_UTILITY_FLASK_LESSER

# Fractured

Show
    Class == "Utility Flasks"
    HasExplicitMod == MODS_UTILITY_FLASK_GRAND
    FracturedItem True
    #.import STYLE | flask > magic -> t2

Show #.strict STRICTNESS_STRICT .if Show
    Class == "Utility Flasks"
    HasExplicitMod == MODS_UTILITY_FLASK_GREATER
    FracturedItem True
    #.import STYLE | flask > magic -> t3

Show #.strict STRICTNESS_LENIENT .if Show
    Class == "Utility Flasks"
    FracturedItem True
    #.import STYLE | flask > magic -> t3

#.import template > quality_utility { CLASS = "Utility Flasks", ITEM_LEVEL_BEST = ITEM_LEVEL_UTILITY_FLASK_BEST
#.import template > progression_utility { CLASS = "Utility Flasks", ITEM_LEVEL_BEST = ITEM_LEVEL_UTILITY_FLASK_BEST