#.subsection Tincture

#.alias ITEM_LEVEL_TINCTURE_BEST  = 85

#.alias MODS_TINCTURE_GRAND           = "Horticultural" "Enriched" "of Dissolution" "of Overpowering" "of Ferocity" "of Mastery" "of Regrowth" "of Devouring"
#.alias MODS_TINCTURE_GREATER         = "Medicinal" "Concentrated" "Persevering" "of the Beast" "of Melting" "of the Unleashed" "of Fury" "of Ease" "of Restoration" "of Siphoning" "of Overwhelming"
#.alias MODS_TINCTURE_LESSER          = "Natural" "Potent" "Persistent" "of the Savage" "of Liquefaction" "of Empowering" "of Rage" "of Skill" "of Assassination" "of Rejuvenation" "of Enveloping" "of Crushing"

# Unique

Show #.strict STRICTNESS_STRICT .if Show
    Class == "Tinctures"
    Rarity == Unique
    #.import STYLE | flask > unique -> t3

# Magic

Show
    Class == "Tinctures"
    HasExplicitMod ==2 MODS_TINCTURE_GRAND
    #.import STYLE | flask > magic -> t2

Show #.strict STRICTNESS_LENIENT .if Show
    Class == "Tinctures"
    HasExplicitMod ==2 MODS_TINCTURE_GRAND MODS_TINCTURE_GREATER
    #.import STYLE | flask > magic -> t3

Show #.strict STRICTNESS_BASE .if Show
    Class == "Tinctures"
    HasExplicitMod ==2 MODS_TINCTURE_GRAND MODS_TINCTURE_GREATER MODS_TINCTURE_LESSER
    #.import STYLE | flask > magic -> t3

# High Quality

Show
    Class == "Tinctures"
    Quality >= 25
    ItemLevel >= ITEM_LEVEL_TINCTURE_BEST
    #.import _util -> multi_t1

Show
    Class == "Tinctures"
    Quality >= 25
    #.import _util -> multi_t2

Show
    Class == "Tinctures"
    Quality >= 20
    ItemLevel >= ITEM_LEVEL_TINCTURE_BEST
    #.import _util -> multi_t3

Show #.strict STRICTNESS_LENIENT .if Show
    Class == "Tinctures"
    Quality >= 20
    #.import _util -> multi_t3

# Best Base

Show #.strict STRICTNESS_LENIENT .if Show
    Class == "Tinctures"
    ItemLevel >= ITEM_LEVEL_TINCTURE_BEST
    #.import _util -> multi_t3

# Progression

Show #.strict STRICTNESS_LENIENT .if Show
    Class == "Tinctures"
    AreaLevel < LEVEL_WHITE_MAPS_START
    #.import < _util -> craftable

Show #.strict STRICTNESS_BASE .if Show
    Class == "Tinctures"
    AreaLevel < LEVEL_YELLOW_MAPS_START
    #.import < _util -> craftable