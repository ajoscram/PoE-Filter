#.subsection Tincture

#.alias ITEM_LEVEL_TINCTURE_BEST  = 85

#.alias MODS_TINCTURE_GRAND           = "Horticultural" "Enriched" "of Dissolution" "of Overpowering" "of Ferocity" "of Mastery" "of Regrowth" "of Devouring"
#.alias MODS_TINCTURE_GREATER         = "Medicinal" "Concentrated" "Persevering" "of the Beast" "of Melting" "of the Unleashed" "of Fury" "of Ease" "of Restoration" "of Siphoning" "of Overwhelming"
#.alias MODS_TINCTURE_LESSER          = "Natural" "Potent" "Persistent" "of the Savage" "of Liquefaction" "of Empowering" "of Rage" "of Skill" "of Assassination" "of Rejuvenation" "of Enveloping" "of Crushing"

#.import template > unique { CLASS = "Tinctures"
#.import template > magic_utility { CLASS = "Tinctures", MODS_GRAND = MODS_TINCTURE_GRAND, MODS_GREATER = MODS_TINCTURE_GREATER, MODS_LESSER = MODS_TINCTURE_LESSER
#.import template > quality_utility { CLASS = "Tinctures", ITEM_LEVEL_BEST = ITEM_LEVEL_TINCTURE_BEST
#.import template > progression { CLASS = "Tinctures", ITEM_LEVEL_BEST = ITEM_LEVEL_TINCTURE_BEST