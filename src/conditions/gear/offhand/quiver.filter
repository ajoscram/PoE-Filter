#.subsection Quiver

#.alias ITEM_LEVEL_QUIVER_BEST            = 86
#.alias AREA_LEVEL_QUIVER_BEST_DROP_START = 84

#.alias BASES_QUIVER_EXCEPTIONAL = "Ornate Quiver"
#.alias BASES_QUIVER_BEST        = "Feathered Arrow Quiver" "Penetrating Arrow Quiver" "Two-Point Arrow Quiver" "Blazing Arrow Quiver" "Broadhead Arrow Quiver" "Vile Arrow Quiver" "Heavy Arrow Quiver" "Primal Arrow Quiver" "Artillery Quiver"

#.alias MODS_QUIVER_EXCEPTIONAL = "Subterranean" "of the Underground" "of the Sentinel" "Infamous"
#.alias MODS_QUIVER_GRAND       = "Fecund" "Flaring" "Cremating" "Entombing" "Electrocuting" "Malicious" "Impaling" "of the Blur" "of Grandmastery" "of Lioneye" "of Rending" "of Tzteosh" "of Haast" "of Ephij" "of Bameth" "of Destruction" "of the Gale" "of Splintering" "of Dissolution"
#.alias MODS_QUIVER_GREATER     = "Athlete's" "Tempered" "Blasting" "Polar" "Discharging" "Lacerating" "of the Wind" "of Mastery" "of the Ranger" "of Incision" "of the Magma" "of the Ice" "of the Lightning" "of Exile" "of Ferocity" "of the Zephyr" "of Melting"
#.alias MODS_QUIVER_LESSER      = "Virile" "Razor-sharp" "Incinerating" "Glaciated" "Shocking" "Incisive" "of the Phantom" "of the Remora" "of Thirst" "of Ease" "of the Marksman" "of Penetrating" "of the Volcano" "of the Polar Bear" "of the Maelstrom" "of Expulsion" "of Eviction" "of Fury" "of Rage" "of Propulsion" "of Retention" "of Liquefaction"

# Unique

Show #.econ uni 100
    BaseType == "Ornate Quiver"
    Class == "Quivers" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | armour > unique -> t1

Show #.econ uni 10 100
    BaseType == "Blunt Arrow Quiver" "Ornate Quiver" "Vile Arrow Quiver"
    Class == "Quivers" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | armour > unique -> t2

Show #.econ uni 1 10 .strict STRICTNESS_STRICT .if Show
    BaseType == "Feathered Arrow Quiver" "Broadhead Arrow Quiver" "Primal Arrow Quiver" "Heavy Arrow Quiver" "Blazing Arrow Quiver" "Two-Point Arrow Quiver" "Blunt Arrow Quiver" "Spike-Point Arrow Quiver" "Sharktooth Arrow Quiver" "Serrated Arrow Quiver" "Penetrating Arrow Quiver" "Vile Arrow Quiver"
    Class == "Quivers" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    #.import STYLE | armour > unique -> t3

#.import < armour > template > exceptional_mods { CLASS = "Quivers", BASES_BEST = BASES_QUIVER_BEST, MODS_EXCEPTIONAL = MODS_QUIVER_EXCEPTIONAL
#.import < armour > template > rare { CLASS = "Quivers", BASES_BEST = BASES_QUIVER_BEST, MODS_GRAND = MODS_QUIVER_GRAND, MODS_GREATER = MODS_QUIVER_GREATER, MODS_LESSER = MODS_QUIVER_LESSER
#.import < armour > template > magic { CLASS = "Quivers", BASES_BEST = BASES_QUIVER_BEST, MODS_GRAND = MODS_QUIVER_GRAND, MODS_GREATER = MODS_QUIVER_GREATER, MODS_LESSER = MODS_QUIVER_LESSER
#.import < armour > template > fractured { CLASS = "Quivers", BASES_BEST = BASES_QUIVER_BEST, ITEM_LEVEL_BEST = ITEM_LEVEL_QUIVER_BEST, MODS_GRAND = MODS_QUIVER_GRAND
#.import template > influenced { BASES_BEST = BASES_QUIVER_BEST, ITEM_LEVEL_BEST = ITEM_LEVEL_QUIVER_BEST
#.import < armour > template > memory_strands { BASES_BEST = BASES_QUIVER_BEST, ITEM_LEVEL_BEST = ITEM_LEVEL_QUIVER_BEST
#.import < armour > template > exceptional_base { BASES_EXCEPTIONAL = BASES_QUIVER_EXCEPTIONAL, ITEM_LEVEL_BEST = ITEM_LEVEL_QUIVER_BEST

# Progression

Show #.if Show
    BaseType == BASES_QUIVER_BEST
    Rarity == Rare
    #.multi .strict STRICTNESS_BASE
        ItemLevel >= ITEM_LEVEL_QUIVER_BEST
        #.import < _util -> craftable
        #.import STYLE | armour > rare -> t3
    #.multi .strict STRICTNESS_LENIENT
        ItemLevel >= ITEM_LEVEL_QUIVER_BEST
        #.import < _util -> craftable
    #.multi .strict STRICTNESS_LENIENT
        AreaLevel < AREA_LEVEL_QUIVER_BEST_DROP_START
    #.multi .strict STRICTNESS_BASE

Show
    Class == "Quivers"
    #.multi
        Rarity == Rare
        AreaLevel < LEVEL_WHITE_MAPS_START
    #.multi
        Rarity == Magic
        AreaLevel < LEVEL_ACT_6_START
    #.multi
        Rarity == Normal
        AreaLevel < LEVEL_ACT_3_START