# Unique

Show #.econ uni 100
    BaseType == "Chiming Spirit Shield" "Girded Tower Shield" "Lacewood Spirit Shield" "Elegant Round Shield" "Ezomyte Tower Shield" "Vaal Spirit Shield" "Titanium Spirit Shield" "Mirrored Spiked Shield"
    Class == "Shields" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    Vestigial False
    #.import STYLE | armour > unique -> t1

Show #.econ uni 10 100
    BaseType == "Pinnacle Tower Shield" "Spiny Round Shield" "Vaal Spirit Shield" "Champion Kite Shield" "Titanium Spirit Shield" "Crimson Round Shield" "Jingling Spirit Shield" "Ebony Tower Shield" "Archon Kite Shield" "Golden Buckler" "Maple Round Shield" "Steel Kite Shield" "Sovereign Spiked Shield"
    Class == "Shields" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    Vestigial False
    #.import STYLE | armour > unique -> t2

Show #.econ uni 1 10 .strict STRICTNESS_STRICT .if Show
    BaseType == "Chiming Spirit Shield" "Vaal Spirit Shield" "Laminated Kite Shield" "Plank Kite Shield" "Branded Kite Shield" "Painted Buckler" "War Buckler" "Tarnished Spirit Shield" "Cardinal Round Shield" "Teak Round Shield" "Pine Buckler" "Harmonic Spirit Shield" "Ancient Spirit Shield" "Mosaic Kite Shield" "Compound Spiked Shield" "Rawhide Tower Shield" "Polished Spiked Shield" "Ironwood Buckler" "Corrugated Buckler" "Enameled Buckler" "Archon Kite Shield" "Painted Tower Shield" "Baroque Round Shield" "Ezomyte Spiked Shield" "Mirrored Spiked Shield" "Pinnacle Tower Shield" "Cedar Tower Shield" "Brass Spirit Shield" "Rotted Round Shield" "Ezomyte Tower Shield" "Lacquered Buckler" "Colossal Tower Shield"
    Class == "Shields" #.format
    Rarity == Unique
    Replica False
    Foulborn False
    Vestigial False
    #.import STYLE | armour > unique -> t3

#.import < armour > template > exceptional_mods { CLASS = "Shields", BASES_BEST = BASES_SHIELD_BEST, MODS_EXCEPTIONAL = MODS_SHIELD_EXCEPTIONAL
#.import < armour > template > rare { CLASS = "Shields", BASES_BEST = BASES_SHIELD_BEST, MODS_GRAND = MODS_SHIELD_GRAND, MODS_GREATER = MODS_SHIELD_GREATER, MODS_LESSER = MODS_SHIELD_LESSER
#.import < armour > template > magic { CLASS = "Shields", BASES_BEST = BASES_SHIELD_BEST, MODS_GRAND = MODS_SHIELD_GRAND, MODS_GREATER = MODS_SHIELD_GREATER, MODS_LESSER = MODS_SHIELD_LESSER
