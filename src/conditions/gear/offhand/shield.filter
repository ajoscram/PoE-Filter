# Progression

Show
    BaseType == BASES_SHIELD_BEST
    ItemLevel >= ITEM_LEVEL_SHIELD_BEST
    BaseDefencePercentile == 100
    #.import < _util -> craftable
    #.import < armour > _util -> multi_t2

Show #.strict STRICTNESS_STRICT .if Show
    BaseType == BASES_SHIELD_BEST
    ItemLevel >= ITEM_LEVEL_SHIELD_BEST
    #.import < _util -> craftable
    #.import < armour > _util -> multi_t3

Show #.strict STRICTNESS_BASE .if Show
    BaseType == BASES_SHIELD_BEST
    Rarity == Rare
    
Show
    Class == "Shields"
