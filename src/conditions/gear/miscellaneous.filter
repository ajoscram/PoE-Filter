#.section Miscellaneous Gear

# Uniques

Show
    Rarity == Unique
    Class == CLASSES_6_SOCKET_ARMOUR CLASSES_6_SOCKET_WEAPON
    LinkedSockets == 6

Show #.strict STRICTNESS_STRICT .if Show
    Rarity == Unique
    #.multi
        Class == CLASSES_6_SOCKET_ARMOUR CLASSES_6_SOCKET_WEAPON
        LinkedSockets == 5
    #.multi
        Class == CLASSES_ARMOUR CLASSES_OFFHANDS CLASSES_WEAPONS CLASSES_JEWELLERY CLASSES_JEWELS CLASSES_JEWELS
        CorruptedMods == 2

Show #.strict STRICTNESS_LENIENT .if Show
    Rarity == Unique
    Class == CLASSES_ARMOUR CLASSES_OFFHANDS CLASSES_WEAPONS CLASSES_JEWELLERY CLASSES_JEWELS
    CorruptedMods == 1

Show #.strict STRICTNESS_BASE .if Show
    Rarity == Unique
    Class == CLASSES_ARMOUR CLASSES_OFFHANDS CLASSES_WEAPONS CLASSES_JEWELLERY CLASSES_JEWELS CLASSES_FLASKS

# Fractured

Show #.strict STRICTNESS_LENIENT .if Show
    Class == CLASSES_JEWELLERY CLASSES_JEWELS CLASSES_FLASKS
    FracturedItem True

Show #.strict STRICTNESS_BASE .if Show
    Class == CLASSES_ARMOUR CLASSES_OFFHANDS CLASSES_WEAPONS
    FracturedItem True

# Synthesized

Show
    Class == CLASSES_ARMOUR CLASSES_OFFHANDS CLASSES_WEAPONS CLASSES_JEWELLERY CLASSES_JEWELS
    SynthesisedItem True

# Influenced

Show
    Class == CLASSES_ARMOUR
    HasInfluence Shaper Elder Crusader Hunter Redeemer Warlord
    HasExplicitMod == MODS_ELEVATED

Show
    Class == CLASSES_ARMOUR CLASSES_OFFHANDS CLASSES_WEAPONS CLASSES_JEWELLERY
    HasInfluence Shaper Elder Crusader Hunter Redeemer Warlord
    HasExplicitMod == MODS_INFLUENCED

Show #.strict STRICTNESS_STRICT .if Show
    Class == CLASSES_JEWELLERY
    HasInfluence Shaper Elder Crusader Hunter Redeemer Warlord

Show #.strict STRICTNESS_LENIENT .if Show
    Class == CLASSES_ARMOUR CLASSES_OFFHANDS CLASSES_WEAPONS
    HasInfluence Shaper Elder Crusader Hunter Redeemer Warlord

# Eater / Exarch

Show
    Class == CLASSES_ARMOUR
    #.multi
        HasEaterOfWorldsImplicit == ELDRITCH_PERFECT
    #.multi
        HasSearingExarchImplicit == ELDRITCH_PERFECT

Show #.strict STRICTNESS_LENIENT .if Show
    Class == CLASSES_ARMOUR
    #.multi
        HasEaterOfWorldsImplicit >= ELDRITCH_EXCEPTIONAL
    #.multi
        HasSearingExarchImplicit >= ELDRITCH_EXCEPTIONAL

Show #.strict STRICTNESS_BASE .if Show
    Class == CLASSES_ARMOUR
    #.multi
        HasEaterOfWorldsImplicit >= ELDRITCH_LESSER
    #.multi
        HasSearingExarchImplicit >= ELDRITCH_LESSER

# Memory Strands

Show #.strict STRICTNESS_STRICT .if Show
    Class == CLASSES_ARMOUR CLASSES_OFFHANDS CLASSES_WEAPONS CLASSES_JEWELLERY
    MemoryStrands >= 75

Show #.strict STRICTNESS_LENIENT .if Show
    Class == CLASSES_ARMOUR CLASSES_OFFHANDS CLASSES_WEAPONS CLASSES_JEWELLERY
    MemoryStrands >= 50

Show #.strict STRICTNESS_BASE .if Show
    Class == CLASSES_ARMOUR CLASSES_OFFHANDS CLASSES_WEAPONS CLASSES_JEWELLERY
    MemoryStrands >= 25

# Veiled

Show
    Class == CLASSES_ARMOUR CLASSES_OFFHANDS CLASSES_WEAPONS CLASSES_JEWELLERY
    HasExplicitMod == MODS_VEILED_NAMED
    FracturedItem True

Show #.strict STRICTNESS_LENIENT .if Show
    Class == CLASSES_ARMOUR CLASSES_OFFHANDS CLASSES_WEAPONS CLASSES_JEWELLERY
    #.multi
        HasExplicitMod == MODS_VEILED_NAMED
    #.multi
        HasExplicitMod == MODS_VEILED_UNNAMED
        FracturedItem True

Show #.strict STRICTNESS_BASE .if Show
    Class == CLASSES_ARMOUR CLASSES_OFFHANDS CLASSES_WEAPONS CLASSES_JEWELLERY
    HasExplicitMod == MODS_VEILED_UNNAMED

# Legacy

Show
    Class == CLASSES_ARMOUR CLASSES_OFFHANDS CLASSES_WEAPONS CLASSES_JEWELLERY CLASSES_JEWELS CLASSES_FLASKS
    #.multi
	    HasCruciblePassiveTree True
    #.multi
        Scourged True
    #.multi
        AnyEnchantment True

# Corrupted

Show
    Class == CLASSES_JEWELS
    CorruptedMods == 2

Show #.strict STRICTNESS_STRICT .if Show
    Class == CLASSES_JEWELS
    CorruptedMods == 1

# Sockets

Show #.strict STRICTNESS_STRICT .if Show
    Class == CLASSES_6_SOCKET_ARMOUR CLASSES_6_SOCKET_WEAPON
    LinkedSockets == 6

Show #.strict STRICTNESS_LENIENT .if Show
    Class == CLASSES_6_SOCKET_ARMOUR CLASSES_6_SOCKET_WEAPON
    #.multi
        LinkedSockets == 5
    #.multi
        Sockets == 6

Show #.strict STRICTNESS_LENIENT .if Show
    Class == CLASSES_ARMOUR CLASSES_6_SOCKET_WEAPON
    AreaLevel < LEVEL_WHITE_MAPS_START
    LinkedSockets == 4

Show #.strict STRICTNESS_BASE .if Show
    Class == CLASSES_ARMOUR CLASSES_OFFHANDS CLASSES_WEAPONS
    AreaLevel < LEVEL_ACT_6_START
    #.multi
        SocketGroup RGB
    #.multi
        LinkedSockets == 3

# Quality

Show
    Class == CLASSES_JEWELLERY
    Quality > 0

Show #.strict STRICTNESS_LENIENT .if Show
    Class == CLASSES_FLASKS
    Quality >= 15

Show #.strict STRICTNESS_BASE .if Show
    Class == CLASSES_FLASKS
    Quality >= 10

# Progression

Show #.strict STRICTNESS_BASE .if Show
    Class == CLASSES_ARMOUR CLASSES_OFFHANDS CLASSES_WEAPONS CLASSES_PROGRESSABLE_FLASKS
    #.multi
        AreaLevel <= LEVEL_MAPS_T16
        DropLevel >= LEVEL_RED_MAPS_START
    #.multi
        AreaLevel < LEVEL_RED_MAPS_START
        DropLevel >= LEVEL_YELLOW_MAPS_START
    #.multi
        AreaLevel < LEVEL_YELLOW_MAPS_START
        DropLevel >= LEVEL_WHITE_MAPS_START
    #.multi
        AreaLevel < LEVEL_WHITE_MAPS_START
        DropLevel >= LEVEL_ACT_10_START
    #.multi
        AreaLevel < LEVEL_ACT_10_START
        DropLevel >= LEVEL_ACT_9_START
    #.multi
        AreaLevel < LEVEL_ACT_9_START
        DropLevel >= LEVEL_ACT_8_START
    #.multi
        AreaLevel < LEVEL_ACT_8_START
        DropLevel >= LEVEL_ACT_7_START
    #.multi
        AreaLevel < LEVEL_ACT_7_START
        DropLevel >= LEVEL_ACT_6_START
    #.multi
        AreaLevel < LEVEL_ACT_6_START
        DropLevel >= LEVEL_ACT_5_START
    #.multi
        AreaLevel < LEVEL_ACT_5_START
        DropLevel >= LEVEL_ACT_4_START
    #.multi
        AreaLevel < LEVEL_ACT_4_START
        DropLevel >= LEVEL_ACT_3_START
    #.multi
        AreaLevel < LEVEL_ACT_3_START
        DropLevel >= LEVEL_ACT_2_START
    #.multi
        AreaLevel < LEVEL_ACT_2_START

Show
    Class == CLASSES_ARMOUR CLASSES_OFFHANDS CLASSES_WEAPONS CLASSES_JEWELLERY CLASSES_JEWELS CLASSES_FLASKS
    AreaLevel == LEVEL_ACT_1_START

# Hidden

Hide
    Class == CLASSES_ARMOUR CLASSES_OFFHANDS
    #.import STYLE | miscellaneous -> hidden
    #.import armour > _util -> multi_t5_full

Hide
    Class == CLASSES_WEAPONS
    #.import STYLE | miscellaneous -> hidden
    #.import weapon > _util -> multi_t5_full

Hide
    Class == CLASSES_JEWELLERY CLASSES_JEWELS
    #.import STYLE | miscellaneous -> hidden
    #.import jewellery > _util -> multi_t5_full

Hide
    Class == CLASSES_FLASKS
    #.import STYLE | miscellaneous -> hidden
    #.import flask > _util -> multi_t5_full