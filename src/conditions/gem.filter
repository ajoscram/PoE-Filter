#.section Gem

#.alias GEM_CLASSES = "Skill Gems" "Support Gems"

Show
	BaseType == "Empower Support" "Enhance Support" "Enlighten Support"
	GemLevel 4
	#.import STYLE | gem -> t1

Show
	BaseType "Awakened"
	Class == "Support Gems"
	#.import STYLE | gem -> t1

Show
	GemLevel 21
	Quality = 23
	#.import STYLE | gem -> t1

Show
    BaseType == "Greater Spell Cascade Support" "Eclipse Support" "Invert the Rules Support" "Cast on Ward Break Support" "Vaal Sacrifice Support" "Greater Spell Echo Support" "Vaal Temptation Support" "Machinations Support" "Pyre Support" "Bonespire Support" "Foulgrasp Support" "Hiveborn Support" "Scornful Herald Support" "Cull the Weak Support" "Greater Ancestral Call Support" "Fissure Support" "Hextoad Support" "Hexpass Support" "Greater Fork Support" "Greater Chain Support" "Lethal Dose Support" "Companionship Support" "Divine Sentinel Support" "Annihilation Support" "Invention Support" "Greater Kinetic Instability Support" "Cooldown Recovery Support" "Voidstorm Support" "Void Shockwave Support" "Eldritch Blasphemy Support" "Gluttony Support" "Overheat Support" "Greater Multistrike Support" "Congregation Support" "Frostmage Support" "Greater Devour Support" "Greater Unleash Support" "Pacifism Support" "Bloodsoaked Banner Support" "Communion Support" "Unholy Trinity Support" "Overloaded Intensity Support" "Transfusion Support"
	#.import STYLE | gem -> t1

Show
	BaseType == "Blood and Sand" "Brand Recall"
	GemLevel 7
	Quality = 23
	#.import STYLE | gem -> t1

Show
	GemLevel 21
	Quality >= 20
	#.import STYLE | gem -> t2

Show
	BaseType == "Blood and Sand" "Brand Recall"
	GemLevel 7
	Quality >= 20
	#.import STYLE | gem -> t2

Show
	Class == GEM_CLASSES
    Imbued True
	#.import STYLE | gem -> t2

Show
	BaseType == "Empower Support" "Enlighten Support" "Enlighten Support"
	#.import STYLE | gem -> t2

Show
	BaseType == "Blood and Sand" "Brand Recall"
	GemLevel 7
	#.import STYLE | gem -> t3

Show
	GemLevel 21
	#.import STYLE | gem -> t3

Show
	GemLevel = 20
	Quality = 20
	#.import STYLE | gem -> t3

Show
	Class == GEM_CLASSES
    TransfiguredGem True
	#.import STYLE | gem -> t3

Show
	Class == GEM_CLASSES
	Quality >= 20
	#.import STYLE | gem -> t4

Show
	GemLevel = 20
	#.import STYLE | gem -> t4

Show #.strict STRICTNESS_STRICT .if Show
	Class == GEM_CLASSES
	Quality >= 5
	#.import STYLE | gem -> t4

Show #.strict STRICTNESS_LENIENT
	Class == GEM_CLASSES
	Quality > 0
	#.import STYLE | gem -> t4

Show #.strict STRICTNESS_LENIENT .if Show
	BaseType == "Portal"
	#.import STYLE | gem -> t4

Show
	Class == GEM_CLASSES
	AreaLevel = LEVEL_ACT_1_START
	#.import STYLE | gem -> t4

Show #.strict STRICTNESS_LENIENT .if Show
	Class == GEM_CLASSES
	AreaLevel < LEVEL_ACT_6_START
	#.import STYLE | gem -> t4

Hide
	Class == GEM_CLASSES
	#.import STYLE | miscellaneous -> hidden
	#.import STYLE | gem -> t5