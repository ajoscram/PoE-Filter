#.section Heist Equipment

#.alias CLASSES_HEIST = "Heist Gear" "Heist Tools" "Heist Cloaks" "Heist Brooches"

#.alias  LEVEL_HEIST_EXCEPTIONAL = 83
#.alias  LEVEL_HEIST_GRAND       = 80
#.alias  LEVEL_HEIST_GREAT       = 75
#.alias  LEVEL_HEIST_LESSER      = 60

#.import gear
#.import tool
#.import cloak
#.import brooch

#.subsection Miscellaneous

# Progression

Show
    Class == CLASSES_HEIST
    DropLevel >=  LEVEL_HEIST_EXCEPTIONAL
    #.import < _util -> multi_t3

Show #.strict STRICTNESS_STRICT .if Show
    Class == CLASSES_HEIST
    DropLevel >=  LEVEL_HEIST_GRAND
    #.import < _util -> multi_t3

Show #.strict STRICTNESS_LENIENT .if Show
    Class == CLASSES_HEIST
    DropLevel >=  LEVEL_HEIST_GREAT
    #.import < _util -> multi_t4

Show #.strict STRICTNESS_BASE .if Show
    Class == CLASSES_HEIST
    DropLevel >=  LEVEL_HEIST_LESSER
    #.import < _util -> multi_t4

# Hidden

Hide
	Class == CLASSES_HEIST
    #.import STYLE | miscellaneous -> hidden
    #.import < _util -> multi_t5