# Rare

Show
    BaseType == BASES_BEST
    Rarity == Rare
    HasExplicitMod ==4 MODS_GRAND
    #.import STYLE | equipment > rare -> t1

Show
    Rarity == Rare
    #.import STYLE | equipment > rare -> t2
    #.multi
        Class == CLASS
        HasExplicitMod >=4 MODS_GRAND
    #.multi
        BaseType == BASES_BEST
        HasExplicitMod >=3 MODS_GRAND

Show #.strict STRICTNESS_STRICT .if Show
    Rarity == Rare
    #.import STYLE | equipment > rare -> t2
    #.multi
        Class == CLASS
        HasExplicitMod >=3 MODS_GRAND
    #.multi
        BaseType == BASES_BEST
        HasExplicitMod >=2 MODS_GRAND

Show #.strict STRICTNESS_LENIENT .if Show
    Rarity == Rare
    #.import STYLE | equipment > rare -> t3
    #.multi
        Class == CLASS
        HasExplicitMod >=3 MODS_GREATER MODS_GRAND
    #.multi
        BaseType == BASES_BEST
        HasExplicitMod >=2 MODS_GREATER MODS_GRAND

Show #.strict STRICTNESS_BASE .if Show
    Rarity == Rare
    #.import STYLE | equipment > rare -> t3
    #.multi
        Class == CLASS
        HasExplicitMod >=3 MODS_LESSER MODS_GREATER MODS_GRAND
    #.multi
        BaseType == BASES_BEST
        HasExplicitMod >=2 MODS_LESSER MODS_GREATER MODS_GRAND
