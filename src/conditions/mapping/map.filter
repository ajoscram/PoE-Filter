#.subsection Map

Show
	Class == "Maps"
	Rarity = Unique

Show
	Continue
	#.strict 2
	MapTier >= 1
Show
	Continue
	#.strict 3
	MapTier > 5
Show
	Continue
	#.strict 4
	MapTier > 10
Show
	Continue
	MapTier = 16
Show
    Continue
    MapTier = 17

Show
	ElderMap True

Show
	ShapedMap True

Show
    ZanaMemory True

Show
	BlightedMap True

Show
	UberBlightedMap True

Show
	MapTier <= 5
	Class == "Maps"

Show
	MapTier <= 10
	Class == "Maps"

Show
	#.strict STRICTNESS_STRICT
	MapTier <= 15
	Class == "Maps"

Show
	MapTier = 16
	Class == "Maps"

Show
    MapTier = 17
    Class == "Maps"