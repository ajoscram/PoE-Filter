#.subsection Oil

# Related

Show
    BaseType == "Oil Extractor"
	#.import STYLE | currency -> t2

# Economy

Show #.econ oil 100
	BaseType == "Tainted Oil" "Golden Oil"
	#.import STYLE | currency -> t1

Show #.econ oil 10 100
	BaseType == "Prismatic Oil" "Silver Oil" "Opalescent Oil"
	#.import STYLE | currency -> t2

Show #.econ oil 1 10
	BaseType == "Reflective Oil" "Crimson Oil" "Black Oil"
	#.import STYLE | currency -> t3

Show #.econ oil 0 1 .strict STRICTNESS_LENIENT .if Show
	BaseType == "Azure Oil" "Clear Oil" "Amber Oil" "Violet Oil" "Teal Oil" "Indigo Oil" "Verdant Oil" "Sepia Oil"
	#.import STYLE | currency -> t4

Hide #.econ oil 0 1
	BaseType == "Azure Oil" "Clear Oil" "Amber Oil" "Violet Oil" "Teal Oil" "Indigo Oil" "Verdant Oil" "Sepia Oil"
	#.import STYLE | miscellaneous -> hidden
	#.import STYLE | currency -> t5

# Catchall

Show
    BaseType "Oil"
    Class == "Currency"
	#.import STYLE | currency -> t2