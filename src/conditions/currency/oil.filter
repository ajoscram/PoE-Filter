#.subsection Oil

# Related

Show
    BaseType == "Oil Extractor"
	#.import STYLE | currency -> t2

# Economy

Show #.econ oil 100
	BaseType == "Prismatic Oil" "Opalescent Oil" "Golden Oil" "Silver Oil" "Reflective Oil" "Tainted Oil" "Black Oil"
	#.import STYLE | currency -> t1

Show #.econ oil 10 100
	BaseType == "Crimson Oil" "Violet Oil"
	#.import STYLE | currency -> t2

Show #.econ oil 1 10
	BaseType == "Azure Oil" "Indigo Oil" "Teal Oil"
	#.import STYLE | currency -> t3

Show #.econ oil 0 1 .strict STRICTNESS_LENIENT .if Show
	BaseType == "Amber Oil" "Sepia Oil" "Clear Oil" "Verdant Oil"
	#.import STYLE | currency -> t4

Hide #.econ oil 0 1
	BaseType == "Amber Oil" "Sepia Oil" "Clear Oil" "Verdant Oil"
	#.import STYLE | miscellaneous -> hidden
	#.import STYLE | currency -> t5

# Catchall

Show
    BaseType "Oil"
    Class == "Currency"
	#.import STYLE | currency -> t2