#.subsection Heist

Show
	BaseType == "Tempering Orb" "Tailoring Orb"
	#.import STYLE | currency -> t1

Show
	BaseType == "Prime Regrading Lens" "Secondary Regrading Lens"
	#.import STYLE | currency -> t2

Show
	BaseType == "Rogue's Marker"
	#.import STYLE | currency -> t3
    #.multi
        #.strict STRICTNESS_STRICT
        StackSize >= 500
    #.multi
        #.strict STRICTNESS_LENIENT
        StackSize < 500