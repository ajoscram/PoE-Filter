#.subsection Shard

Show
	BaseType == "Mirror Shard"
	#.import STYLE | currency -> t1

Show
	BaseType == "Fracturing Shard" "Exalted Shard" "Ancient Shard" "Annulment Shard"
	#.import STYLE | currency -> t3

Show
	#.strict STRICTNESS_LENIENT
	BaseType == "Chaos Shard" "Horizon Shard" "Harbinger's Shard"
	#.import STYLE | currency -> t4

Show
	#.strict STRICTNESS_BASE
	BaseType == "Regal Shard" "Alchemy Shard" "Alteration Shard" "Binding Shard" "Engineer's Shard"
	#.import STYLE | currency -> t5

Hide
	BaseType == "Transmutation Shard" "Scroll Fragment"
	#.import STYLE | currency -> t5