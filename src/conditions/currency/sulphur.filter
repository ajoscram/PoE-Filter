#.subsection Dead Man's Sulphur

Show #.if Show
	BaseType == "Dead Man's Sulphur"
    #.multi
        StackSize >= 25000
	    #.import STYLE | currency -> t1
    #.multi
        StackSize >= 2500
	    #.import STYLE | currency -> t2
    #.multi
        StackSize >= 250
	    #.import STYLE | currency -> t3
    #.multi
    	#.import STYLE | currency -> t4