#.subsection Fossil

# Economy

Show #.econ fos 100
	BaseType == "Fractured Fossil" "Hollow Fossil"
	#.import STYLE | currency -> t1

Show #.econ fos 10 100
	BaseType == "Corroded Fossil" "Glyphic Fossil" "Dense Fossil" "Faceted Fossil" "Shuddering Fossil" "Sanctified Fossil"
	#.import STYLE | currency -> t2

Show #.econ fos 1 10
	BaseType == "Fundamental Fossil" "Aetheric Fossil" "Scorched Fossil" "Gilded Fossil" "Aberrant Fossil" "Pristine Fossil" "Metallic Fossil" "Opulent Fossil" "Frigid Fossil" "Tangled Fossil" "Bound Fossil" "Jagged Fossil" "Prismatic Fossil" "Bloodstained Fossil" "Deft Fossil" "Lucent Fossil" "Serrated Fossil"
	#.import STYLE | currency -> t3

Show #.econ fos 0 1 .strict STRICTNESS_LENIENT .if Show
	BaseType == "Serrated Fossil"
	#.import STYLE | currency -> t4

Hide #.econ fos 0 1
	BaseType == "Serrated Fossil"
	#.import STYLE | miscellaneous -> hidden
	#.import STYLE | currency -> t5

# Catchall

Show
    BaseType "Fossil"
    Class == "Currency"
	#.import STYLE | currency -> t2