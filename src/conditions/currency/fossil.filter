#.subsection Fossil

# Economy

Show #.econ fos 100
	BaseType == "Hollow Fossil" "Glyphic Fossil" "Gilded Fossil" "Sanctified Fossil" "Faceted Fossil"
	#.import STYLE | currency -> t1

Show #.econ fos 10 100
	BaseType == "Shuddering Fossil" "Dense Fossil" "Frigid Fossil" "Prismatic Fossil" "Deft Fossil" "Fractured Fossil" "Aetheric Fossil" "Opulent Fossil" "Corroded Fossil" "Metallic Fossil" "Scorched Fossil" "Aberrant Fossil" "Serrated Fossil"
	#.import STYLE | currency -> t2

Show #.econ fos 1 10
	BaseType == "Bound Fossil" "Pristine Fossil" "Jagged Fossil"
	#.import STYLE | currency -> t3

Show #.econ fos 0 1 .strict STRICTNESS_LENIENT .if Show
	BaseType == "Lucent Fossil" "Fundamental Fossil"
	#.import STYLE | currency -> t4

Hide #.econ fos 0 1
	BaseType == "Lucent Fossil" "Fundamental Fossil"
	#.import STYLE | miscellaneous -> hidden
	#.import STYLE | currency -> t5

# Catchall

Show
    BaseType "Fossil"
    Class == "Currency"
	#.import STYLE | currency -> t2