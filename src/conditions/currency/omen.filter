#.subsection Omen

# Economy

Show #.econ omn 100
	BaseType == "Omen of Connections" "Omen of Fortune"
	#.import STYLE | currency -> t1

Show #.econ omn 10 100
	BaseType == "Omen of Trichromatism" "Omen of Brilliance" "Omen of Amelioration"
	#.import STYLE | currency -> t2

Show #.econ omn 1 10
	BaseType == "Omen of the Soul Devourer" "Omen of Refreshment" "Omen of Death's Door" "Omen of Adrenaline" "Omen of Return" "Omen of the Jeweller" "Omen of Death-dancing"
	#.import STYLE | currency -> t3

Show #.econ omn 0 1 .strict STRICTNESS_LENIENT .if Show
	BaseType == "Omen of Death-dancing"
	#.import STYLE | currency -> t4

Hide #.econ omn 0 1
	BaseType == "Omen of Death-dancing"
	#.import STYLE | miscellaneous -> hidden
	#.import STYLE | currency -> t5

# Catchall

Show
    BaseType "Omen of"
    Class == "Currency"
	#.import STYLE | currency -> t2