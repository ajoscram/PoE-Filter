#.subsection Runegraft

# Economy

Show #.econ run 100
	BaseType == "Runegraft of Gemcraft" "Runegraft of Restitching" "Runegraft of the Jeweller" "Runegraft of Quaffing" "Runegraft of Stability" "Runegraft of the Bound" "Runegraft of the Spellbound" "Runegraft of Refraction" "Runegraft of Blasphemy" "Runegraft of the Warp" "Runegraft of the Soulwick" "Runegraft of Bellows" "Runegraft of the Fortress" "Runegraft of Time" "Runegraft of Rotblood" "Runegraft of Treachery"
	#.import STYLE | currency -> t1

Show #.econ run 10 100
	BaseType == "Runegraft of Rallying" "Runegraft of the Imbued" "Runegraft of the River" "Runegraft of the Sinistral" "Runegraft of Resurgence"
	#.import STYLE | currency -> t2

Show #.econ run 1 10
	BaseType == "Runegraft of the Combatant" "Runegraft of Connection" "Runegraft of Loyalty" "Runegraft of the Novamark"
	#.import STYLE | currency -> t3

Show #.econ run 0 1 .strict STRICTNESS_LENIENT .if Show
	BaseType == "Runegraft of the Witchmark" "Runegraft of the Agile"
	#.import STYLE | currency -> t4

Hide #.econ run 0 1
	BaseType == "Runegraft of the Witchmark" "Runegraft of the Agile"
	#.import STYLE | miscellaneous -> hidden
	#.import STYLE | currency -> t5

# Catchall

Show
    BaseType "Runegraft of"
    Class == "Currency"
	#.import STYLE | currency -> t2