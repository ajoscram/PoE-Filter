#.subsection Runegraft

Show
    #.econ run 100
    BaseType == "Runegraft of Rotblood" "Runegraft of Refraction" "Runegraft of Gemcraft" "Runegraft of the Angler"
	#.import < < styles > currency -> 100+c

Show
    #.econ run 10 100
    BaseType == "Runegraft of Resurgence" "Runegraft of the Spellbound" "Runegraft of the Agile" "Runegraft of Rallying" "Runegraft of the Soulwick" "Runegraft of the Warp" "Runegraft of Stability" "Runegraft of the Fortress" "Runegraft of Quaffing" "Runegraft of Treachery"
	#.import < < styles > currency -> 10_100c

Show
    #.econ run 0 10
    BaseType == "Runegraft of Connection" "Runegraft of Suffering" "Runegraft of the Imbued" "Runegraft of Fury" "Runegraft of Consecration" "Runegraft of the River" "Runegraft of Bellows" "Runegraft of the Bound" "Runegraft of Time" "Runegraft of the Witchmark" "Runegraft of the Sinistral" "Runegraft of Restitching" "Runegraft of the Novamark" "Runegraft of Blasphemy" "Runegraft of the Combatant" "Runegraft of the Jeweller" "Runegraft of Loyalty"
    #.import < < styles > currency -> 1_10c