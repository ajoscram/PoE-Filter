#.subsection Runegraft

Show
    #.econ run 100
    BaseType == "Runegraft of Rotblood" "Runegraft of Refraction" "Runegraft of Gemcraft" "Runegraft of the Angler"
	#.import STYLE | currency -> t1

Show
    #.econ run 10 100
