#.subsection Enshrouding Crystal

# Economy

Show #.econ enc 10
    BaseType == "Maraketh Enshrouding Crystal"
    #.import STYLE | currency -> t2

Show #.econ enc 0 10
    BaseType == "Karui Enshrouding Crystal" "Imperial Enshrouding Crystal" "Vaal Enshrouding Crystal" "Templar Enshrouding Crystal"
    #.import STYLE | currency -> t3

# Catchall

Show
    BaseType "Enshrouding Crystal"
    Class == "Currency"
	#.import STYLE | currency -> t2