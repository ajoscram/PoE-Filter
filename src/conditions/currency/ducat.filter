#.subsection Ducat

# Economy

Show #.econ duc 10
    BaseType == "Ukatoa's Ducat" "Brinehook's Ducat"
    #.import STYLE | currency -> t2

Show #.econ duc 0 10
    BaseType == "Katakohi's Ducat" "Merrick's Ducat" "The Changeling's Ducat" "Tzamoto's Ducat" "Rotmother's Ducat" "Telesia's Ducat" "Kishara's Ducat" "Cyaxan's Ducat" "The Genteel's Ducat"
    #.import STYLE | currency -> t3

# Catchall

Show
    BaseType "Ducat"
    Class == "Currency"
	#.import STYLE | currency -> t2