#.subsection Essence

# Economy

Show #.econ ess 100
	BaseType == "Shrieking Essence of Wrath" "Essence of Desolation" "Essence of Hysteria" "Essence of Delirium" "Shrieking Essence of Loathing" "Screaming Essence of Woe" "Essence of Horror" "Screaming Essence of Wrath" "Deafening Essence of Scorn" "Screaming Essence of Hatred" "Essence of Insanity" "Deafening Essence of Spite"
	#.import STYLE | currency -> t1

Show #.econ ess 10 100
	BaseType == "Deafening Essence of Torment" "Deafening Essence of Wrath" "Deafening Essence of Envy" "Deafening Essence of Anger" "Shrieking Essence of Contempt" "Deafening Essence of Loathing" "Wailing Essence of Torment" "Screaming Essence of Torment" "Shrieking Essence of Envy" "Deafening Essence of Hatred" "Deafening Essence of Dread" "Deafening Essence of Rage" "Deafening Essence of Anguish" "Deafening Essence of Misery" "Deafening Essence of Fear" "Deafening Essence of Doubt" "Deafening Essence of Greed" "Shrieking Essence of Zeal" "Deafening Essence of Zeal" "Deafening Essence of Suffering" "Deafening Essence of Contempt" "Deafening Essence of Woe" "Deafening Essence of Sorrow"
	#.import STYLE | currency -> t2

Show #.econ ess 1 10
	BaseType == "Screaming Essence of Sorrow" "Shrieking Essence of Hatred" "Screaming Essence of Contempt" "Shrieking Essence of Dread" "Shrieking Essence of Misery" "Whispering Essence of Greed" "Weeping Essence of Hatred" "Wailing Essence of Rage" "Weeping Essence of Doubt" "Weeping Essence of Torment" "Weeping Essence of Sorrow" "Weeping Essence of Anger" "Screaming Essence of Fear" "Wailing Essence of Spite" "Muttering Essence of Contempt" "Weeping Essence of Woe" "Shrieking Essence of Scorn" "Whispering Essence of Woe" "Shrieking Essence of Anger" "Screaming Essence of Dread" "Weeping Essence of Fear" "Weeping Essence of Wrath" "Muttering Essence of Woe" "Weeping Essence of Rage" "Wailing Essence of Doubt" "Muttering Essence of Greed" "Weeping Essence of Contempt"
	#.import STYLE | currency -> t3

Show #.econ ess 0 1 .strict STRICTNESS_LENIENT .if Show
	BaseType == "Shrieking Essence of Rage" "Shrieking Essence of Greed" "Shrieking Essence of Sorrow" "Screaming Essence of Zeal" "Shrieking Essence of Fear"
	#.import STYLE | currency -> t4

Hide #.econ ess 0 1
	BaseType == "Shrieking Essence of Rage" "Shrieking Essence of Greed" "Shrieking Essence of Sorrow" "Screaming Essence of Zeal" "Shrieking Essence of Fear"
	#.import STYLE | miscellaneous -> hidden
	#.import STYLE | currency -> t5

# Catchall

Show
    BaseType "Essence of"
    Class == "Currency"
	#.import STYLE | currency -> t2