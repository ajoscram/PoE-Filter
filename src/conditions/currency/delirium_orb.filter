#.subsection Delirium Orb

# Economy

#.#Show #.econ del 100
#.#	BaseType ==
#.#	#.import STYLE | currency -> t2

Show #.econ del 10 100
	BaseType == "Skittering Delirium Orb" "Fine Delirium Orb" "Diviner's Delirium Orb"
	#.import STYLE | currency -> t2

Show #.econ del 0 10
	BaseType == "Blacksmith's Delirium Orb" "Whispering Delirium Orb" "Blighted Delirium Orb" "Fragmented Delirium Orb" "Thaumaturge's Delirium Orb" "Cartographer's Delirium Orb" "Jeweller's Delirium Orb" "Armoursmith's Delirium Orb" "Singular Delirium Orb"
	#.import STYLE | currency -> t3

# Catchall

Show
    BaseType "Delirium Orb"
    Class == "Currency"
	#.import STYLE | currency -> t2