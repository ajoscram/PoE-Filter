#.subsection Splinter

# Legacy

Show
	BaseType == "Splinter of Chayula"
	#.import STYLE | currency -> t3

Show
	BaseType == "Splinter of Uul-Netol" "Splinter of Xoph" "Splinter of Esh" "Splinter of Tul"
	#.import STYLE | currency -> t4

# Miscellaneous

Show
	BaseType == "Crescent Splinter"
	#.import STYLE | currency -> t2

Show #.if Show
	BaseType == "Simulacrum Splinter"
    #.multi
        StackSize == 300
	    #.import STYLE | currency -> t2
    #.multi
        StackSize >= 150
	    #.import STYLE | currency -> t3
    #.multi
        StackSize >= 15
    	#.import STYLE | currency -> t4
    #.multi .strict STRICTNESS_BASE
	    #.import STYLE | currency -> t4

Show #.if Show
	BaseType == "Timeless Maraketh Splinter"
    #.multi
        StackSize >= 30
	    #.import STYLE | currency -> t2
    #.multi
        StackSize >= 6
	    #.import STYLE | currency -> t3
    #.multi
        StackSize >= 3
    	#.import STYLE | currency -> t4
    #.multi .strict STRICTNESS_STRICT
    	#.import STYLE | currency -> t4

Show #.if Show
	BaseType == "Ritual Splinter" "Timeless Karui Splinter" "Timeless Templar Splinter" "Timeless Eternal Empire Splinter" "Timeless Vaal Splinter"
    #.multi
        StackSize >= 50
	    #.import STYLE | currency -> t2
    #.multi
        StackSize >= 10
	    #.import STYLE | currency -> t3
    #.multi
        StackSize >= 5
    	#.import STYLE | currency -> t4
    #.multi .strict STRICTNESS_LENIENT
	    #.import STYLE | currency -> t4

# Hidden

Hide
	BaseType == "Simulacrum Splinter" "Ritual Splinter" "Timeless Maraketh Splinter" "Timeless Templar Splinter" "Timeless Karui Splinter" "Timeless Eternal Empire Splinter" "Timeless Vaal Splinter"
	#.import STYLE | miscellaneous -> hidden
    #.import STYLE | currency -> t5