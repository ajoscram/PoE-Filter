#.subsection Splinter

Show
	BaseType == "Ritual Splinter" "Crescent Splinter" "Splinter of Chayula"
	#.import STYLE | currency -> t4

Show
	BaseType == "Simulacrum Splinter" "Timeless Maraketh Splinter" "Timeless Templar Splinter" "Timeless Karui Splinter" "Timeless Eternal Empire Splinter" "Timeless Vaal Splinter" "Splinter of Uul-Netol" "Splinter of Xoph" "Splinter of Esh" "Splinter of Tul"
	#.import STYLE | currency -> t5
    #.multi
	    StackSize >= 20
    #.multi
	    StackSize >= 10 #.strict STRICTNESS_STRICT
    #.multi
	    StackSize >= 5 #.strict STRICTNESS_LENIENT
    #.multi
        #.strict STRICTNESS_BASE